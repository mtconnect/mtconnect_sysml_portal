@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/DataItemTypes/>
    a owl:Ontology ;
    rdfs:label "data item types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/DataItemTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:EventDataItem
    a owl:Class ;
    rdfs:label """event""" ;
    rdfs:subClassOf mtc-cnstr:DataItemType ;
    skos:definition """abstract data item that is a discrete piece of information from a piece of equipment. It does not have intermediate values that vary over time.\n""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000027> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Event> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:category ;
                      owl:someValuesFrom mtc-cnstr:CategoryEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:category
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:category""" ;
    rdfs:domain mtc-cnstr:EventDataItem ;
    rdfs:range mtc-cnstr:CategoryEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:EventDataItem ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:SampleDataItem
    a owl:Class ;
    rdfs:label """sample""" ;
    rdfs:subClassOf mtc-cnstr:DataItemType ;
    skos:definition """abstract data item that is continuously changing or analog data value.\n""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:category ;
                      owl:someValuesFrom mtc-cnstr:CategoryEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:SampleEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:units ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:category
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:category""" ;
    rdfs:domain mtc-cnstr:SampleDataItem ;
    rdfs:range mtc-cnstr:CategoryEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:SampleDataItem ;
    rdfs:range mtc-cnstr:SampleEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:units
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:units""" ;
    rdfs:domain mtc-cnstr:SampleDataItem ;
    rdfs:range mtc-cnstr:UnitEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:ConditionDataItem
    a owl:Class ;
    rdfs:label """condition""" ;
    rdfs:subClassOf mtc-cnstr:DataItemType ;
    skos:definition """abstract data item that is about an entity's status regarding its ability to operate or it provides an indication whether the data reported for the entity is within an expected range.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000027> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000016> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:category ;
                      owl:someValuesFrom mtc-cnstr:CategoryEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:ConditionEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:category
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:category""" ;
    rdfs:domain mtc-cnstr:ConditionDataItem ;
    rdfs:range mtc-cnstr:CategoryEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:ConditionDataItem ;
    rdfs:range mtc-cnstr:ConditionEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItemTypes/> .

