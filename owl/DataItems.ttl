@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/DataItems/>
    a owl:Ontology ;
    rdfs:label "data items" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/DataItems/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:DataItem
    a owl:Class ;
    rdfs:label """data item""" ;
    skos:altLabel """DataItem""" ;
    iof-av:directSource """MTConnect DataItem""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000027> ;
    iof-av:naturalLanguageDefinition """information reported about a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom mtc-cnstr:Observation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCategory ;
                      owl:someValuesFrom mtc-cnstr:CategoryEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCompositionIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCoordinateSystem ;
                      owl:someValuesFrom mtc-cnstr:CoordinateSystemEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDiscreteValue ;
                      owl:someValuesFrom xsd:boolean ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeScaleValue ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeUnits ;
                      owl:someValuesFrom mtc-cnstr:NativeUnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSampleRateValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSignificantDigitsValue ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasStatistic ;
                      owl:someValuesFrom mtc-cnstr:StatisticEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSubType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:DataItemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUnits ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isObservedBy ;
                      owl:someValuesFrom mtc-cnstr:ComponentInformation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRepresentation ;
                      owl:someValuesFrom mtc-cnstr:RepresentationEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSource ;
                      owl:someValuesFrom mtc-cnstr:Source ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasConstraint ;
                      owl:someValuesFrom mtc-cnstr:Constraints ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasFilter ;
                      owl:someValuesFrom mtc-cnstr:FilterPropertiesofDataItem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasInitialValue ;
                      owl:someValuesFrom mtc-cnstr:InitialValue ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResetTrigger ;
                      owl:someValuesFrom mtc-cnstr:ResetTrigger ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasObservation ;
                      owl:someValuesFrom mtc-cnstr:Observation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDefinition ;
                      owl:someValuesFrom mtc-cnstr:Definition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCoordinateSystemIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRelationship ;
                      owl:someValuesFrom mtc-cnstr:AbstractDataItemRelationship ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isDataItemOf ;
                      owl:someValuesFrom mtc-cnstr:ComponentInformation ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasCompositionIdValue
    a owl:DatatypeProperty ;
    rdfs:label """has composition id value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """identifier of the {{block(Composition)}} entity defined in the {{term(MTConnectDevices Response Document)}} associated with the data reported for the {{block(Observation)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasConstraint
    a owl:ObjectProperty ;
    rdfs:label """has constraint""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:Constraints ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasDefinition
    a owl:ObjectProperty ;
    rdfs:label """has definition""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:Definition ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasDiscreteValue
    a owl:DatatypeProperty ;
    rdfs:label """has discrete value""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition """indication signifying whether each value reported for the {{term(Observation)}} is significant and whether duplicate values are to be suppressed.\n\nIf a value is not defined for {{property(DataItem::discrete)}}, the default value **MUST** be `false`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasInitialValue
    a owl:ObjectProperty ;
    rdfs:label """has initial value""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:InitialValue ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasNativeScaleValue
    a owl:DatatypeProperty ;
    rdfs:label """has native scale value""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range xsd:integer ;
    iof-av:naturalLanguageDefinition """used to convert the reported value to represent the original measured value.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasNativeUnits
    a owl:ObjectProperty ;
    rdfs:label """has native units""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:NativeUnitEnum ;
    iof-av:naturalLanguageDefinition """native units of measurement for the reported value of the data item.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasObservation
    a owl:ObjectProperty ;
    rdfs:label """has observation""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:Observation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasRepresentation
    a owl:ObjectProperty ;
    rdfs:label """has representation""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:RepresentationEnum ;
    iof-av:naturalLanguageDefinition """description of a means to interpret data consisting of multiple data points or samples reported as a single value.  \n\nIf {{property(DataItem::representation)}} is not specified, it **MUST** be determined to be `VALUE`.\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasResetTrigger
    a owl:ObjectProperty ;
    rdfs:label """has reset trigger""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:ResetTrigger ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasSignificantDigitsValue
    a owl:DatatypeProperty ;
    rdfs:label """has significant digits value""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range xsd:integer ;
    iof-av:naturalLanguageDefinition """number of significant digits in the reported value.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:hasSource
    a owl:ObjectProperty ;
    rdfs:label """has source""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:Source ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:isDataItemOf
    a owl:ObjectProperty ;
    rdfs:label """is data item of""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:ComponentInformation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

mtc-cnstr:isObservedBy
    a owl:ObjectProperty ;
    rdfs:label """is observed by""" ;
    rdfs:domain mtc-cnstr:DataItem ;
    rdfs:range mtc-cnstr:ComponentInformation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataItems/> .

