@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Table/>
    a owl:Ontology ;
    rdfs:label "table" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Table/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:TableRepresentation
    a owl:Class ;
    rdfs:label """table""" ;
    skos:altLabel """Table""" ;
    iof-av:directSource """MTConnect Representation Table""" ;
    rdfs:subClassOf mtc-cnstr:Representation ;
    iof-av:naturalLanguageDefinition """representation for an observation composed of two-dimensional sets of key-value pairs where the entry represents rows containing sets of key-value pairs given by cell entities. \n""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000308> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResult ;
                      owl:someValuesFrom mtc-cnstr:EntryTable ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCountValue ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Table/> .

mtc-cnstr:EntryTable
    a owl:Class ;
    rdfs:label """entry""" ;
    skos:altLabel """Entry""" ;
    iof-av:directSource """MTConnect Entry""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001933> ;
    iof-av:naturalLanguageDefinition """key-value pair published as part of a table.\n\n""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/Constituent> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasKeyValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRemovedValue ;
                      owl:someValuesFrom xsd:boolean ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResult ;
                      owl:someValuesFrom mtc-cnstr:Cell ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isEntryOf ;
                      owl:someValuesFrom mtc-cnstr:TableRepresentation ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Table/> .

mtc-cnstr:Cell
    a owl:Class ;
    rdfs:label """cell""" ;
    skos:altLabel """Cell""" ;
    iof-av:directSource """MTConnect Cell""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001933> ;
    iof-av:naturalLanguageDefinition """key-value pair published as part of a TableEntry.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasKeyValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResultValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isCellOf ;
                      owl:someValuesFrom mtc-cnstr:EntryTable ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Table/> .

mtc-cnstr:hasKeyValue
    a owl:DatatypeProperty ;
    rdfs:label """has key value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """unique identifier for each {{term(key-value pair)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Table/> .

mtc-cnstr:hasResultValue
    a owl:DatatypeProperty ;
    rdfs:label """has result value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range rdfs:Literal ;
    iof-av:naturalLanguageDefinition """{{term(observation)}} of the {{block(Observation)}} entity.\n\nThe default value type for {{property(Observation::result)}} is `string`.\n\n> Note 1 to entry: in {{term(XML)}} the {{property(Observation::result)}} is the `CDATA` of the Observation {{term(element)}}.\n\n~~~~xml\n<Execution dataItemId=\"...\" ...>READY</Execution>\n~~~~\n\n> Note 2 to entry: in {{term(JSON)}} the {{property(Observation::result)}} is the member `value` of the Observation object.\n\n~~~~json\n\"Execution\" : [ { \"dataItemId\": \"...\" ..., \"value\": \"READY\" } ]\n~~~~""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Table/> .

mtc-cnstr:isCellOf
    a owl:ObjectProperty ;
    rdfs:label """is cell of""" ;
    rdfs:domain mtc-cnstr:Cell ;
    rdfs:range mtc-cnstr:EntryTable ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Table/> .

