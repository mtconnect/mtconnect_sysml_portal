@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/>
    a owl:Ontology ;
    rdfs:label "properties of data item" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/PropertiesofDataItem/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ResetTrigger
    a owl:Class ;
    rdfs:label """reset trigger""" ;
    skos:altLabel """ResetTrigger""" ;
    iof-av:directSource """MTConnect ResetTrigger""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Classifier> ;
    iof-av:naturalLanguageDefinition """type of event that may cause a reset to occur.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Event> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValue ;
                      owl:someValuesFrom mtc-cnstr:ResetTriggerEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isResetTriggerOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:Source
    a owl:Class ;
    rdfs:label """source""" ;
    skos:altLabel """Source""" ;
    iof-av:directSource """MTConnect Source""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Identifier> ;
    iof-av:naturalLanguageDefinition """identifies the component, data item, or composition from which a measured value originates.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasComponentIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCompositionIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDataItemIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isSourceOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:InitialValue
    a owl:Class ;
    rdfs:label """initial value""" ;
    skos:altLabel """InitialValue""" ;
    iof-av:directSource """MTConnect InitialValue""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001933> ;
    iof-av:naturalLanguageDefinition """starting value for a data item as well as the value to be set for the data item after a reset event.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isInitialValueOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:FilterPropertiesofDataItem
    a owl:Class ;
    rdfs:label """filter""" ;
    skos:altLabel """Filter""" ;
    iof-av:directSource """MTConnect Filter""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000055> ;
    iof-av:naturalLanguageDefinition """provides a means to control when an agent records updated information for a data item. """ ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000017> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:FilterEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isFilterOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isFilterOf ;
                      owl:someValuesFrom mtc-cnstr:Constraints ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:Constraints
    a owl:Class ;
    rdfs:label """constraints""" ;
    skos:altLabel """Constraints""" ;
    iof-av:directSource """MTConnect Constraints""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/AcceptanceCriteria> ;
    iof-av:naturalLanguageDefinition """organizes a set of expected values that can be reported for a data item.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasMaximumValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasMinimumValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNominalValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasFilter ;
                      owl:someValuesFrom mtc-cnstr:FilterPropertiesofDataItem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isConstraintOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:Definition
    a owl:Class ;
    rdfs:label """definition""" ;
    skos:altLabel """Definition""" ;
    iof-av:directSource """MTConnect Definition""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """defines the meaning of entry and cell entities when the associated data item::representation is either `DATA_SET` or `TABLE`.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCellDefinition ;
                      owl:someValuesFrom mtc-cnstr:CellDefinition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasEntryDefinition ;
                      owl:someValuesFrom mtc-cnstr:EntryDefinition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDescriptionValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isDefinitionOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:MinimumDeltaFilter
    a owl:Class ;
    rdfs:label """minimum delta filter""" ;
    skos:altLabel """MinimumDeltaFilter""" ;
    iof-av:directSource """MTConnect Filter MinimumDeltaFilter""" ;
    rdfs:subClassOf mtc-cnstr:FilterPropertiesofDataItem ;
    iof-av:naturalLanguageDefinition """new value **MUST NOT** be reported for a data item unless the measured value has changed from the last reported value by at least the delta given as the value of this element.\n\nThe value of filter **MUST** be an absolute value using the same units as the reported data.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:FilterEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:PeriodFilter
    a owl:Class ;
    rdfs:label """period filter""" ;
    skos:altLabel """PeriodFilter""" ;
    iof-av:directSource """MTConnect Filter PeriodFilter""" ;
    rdfs:subClassOf mtc-cnstr:FilterPropertiesofDataItem ;
    iof-av:naturalLanguageDefinition """data reported for a data item is provided on a periodic basis. The `PERIOD` for reporting data is defined in the value of the filter.\n\nThe value of filter **MUST** be an absolute value reported in seconds representing the time between reported samples of the value of the data item.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001931> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000020> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:FilterEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:hasCellDefinition
    a owl:ObjectProperty ;
    rdfs:label """has cell definition""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:CellDefinition ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:hasEntryDefinition
    a owl:ObjectProperty ;
    rdfs:label """has entry definition""" ;
    rdfs:domain mtc-cnstr:Definition ;
    rdfs:range mtc-cnstr:EntryDefinition ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:hasFilter
    a owl:ObjectProperty ;
    rdfs:label """has filter""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:FilterPropertiesofDataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:hasMaximumValue
    a owl:DatatypeProperty ;
    rdfs:label """has maximum value""" ;
    rdfs:domain mtc-cnstr:Constraints ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """numeric upper constraint.\n\nIf the data reported for a data item is a range of numeric values, the expected value reported **MAY** be described with an upper limit defined by this constraint.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:hasMinimumValue
    a owl:DatatypeProperty ;
    rdfs:label """has minimum value""" ;
    rdfs:domain mtc-cnstr:Constraints ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """numeric lower constraint.\n\nIf the data reported for a data item is a range of numeric values, the expected value reported **MAY** be described with a lower limit defined by this constraint.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:hasNominalValue
    a owl:DatatypeProperty ;
    rdfs:label """has nominal value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """ideal or desired value for a variable.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:hasValue
    a owl:ObjectProperty ;
    rdfs:label """has value""" ;
    rdfs:domain mtc-cnstr:ResetTrigger ;
    rdfs:range mtc-cnstr:ResetTriggerEnum ;
    iof-av:naturalLanguageDefinition """type of {{block(ResetTrigger)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:isConstraintOf
    a owl:ObjectProperty ;
    rdfs:label """is constraint of""" ;
    rdfs:domain mtc-cnstr:Constraints ;
    rdfs:range mtc-cnstr:DataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:isDefinitionOf
    a owl:ObjectProperty ;
    rdfs:label """is definition of""" ;
    rdfs:domain mtc-cnstr:Definition ;
    rdfs:range mtc-cnstr:DataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:isFilterOf
    a owl:ObjectProperty ;
    rdfs:label """is filter of""" ;
    rdfs:domain mtc-cnstr:FilterPropertiesofDataItem ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:isInitialValueOf
    a owl:ObjectProperty ;
    rdfs:label """is initial value of""" ;
    rdfs:domain mtc-cnstr:InitialValue ;
    rdfs:range mtc-cnstr:DataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:isResetTriggerOf
    a owl:ObjectProperty ;
    rdfs:label """is reset trigger of""" ;
    rdfs:domain mtc-cnstr:ResetTrigger ;
    rdfs:range mtc-cnstr:DataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

mtc-cnstr:isSourceOf
    a owl:ObjectProperty ;
    rdfs:label """is source of""" ;
    rdfs:domain mtc-cnstr:Source ;
    rdfs:range mtc-cnstr:DataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDataItem/> .

