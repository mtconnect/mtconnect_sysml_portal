@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Sensor/>
    a owl:Ontology ;
    rdfs:label "sensor" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Sensor/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:SensorConfiguration
    a owl:Class ;
    rdfs:label """sensor configuration""" ;
    skos:altLabel """SensorConfiguration""" ;
    iof-av:directSource """MTConnect SensorConfiguration""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """configuration for a sensor.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/SensorSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000017> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCalibrationDateValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCalibrationInitialsValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasFirmwareVersionValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNextCalibrationDateValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasChannel ;
                      owl:someValuesFrom mtc-cnstr:Channel ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isSensorConfigurationOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:Channel
    a owl:Class ;
    rdfs:label """channel""" ;
    skos:altLabel """Channel""" ;
    iof-av:directSource """MTConnect Channel""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """sensing element of a sensor.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/Constituent> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCalibrationDateValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCalibrationInitialsValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNextCalibrationDateValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNumberValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isChannelOf ;
                      owl:someValuesFrom mtc-cnstr:SensorConfiguration ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDescriptionValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:hasCalibrationDateValue
    a owl:DatatypeProperty ;
    rdfs:label """has calibration date value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """Date upon which the {{term(sensor unit)}} was last calibrated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:hasCalibrationInitialsValue
    a owl:DatatypeProperty ;
    rdfs:label """has calibration initials value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """The initials of the person verifying the validity of the calibration data.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:hasChannel
    a owl:ObjectProperty ;
    rdfs:label """has channel""" ;
    rdfs:domain mtc-cnstr:SensorConfiguration ;
    rdfs:range mtc-cnstr:Channel ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:hasFirmwareVersionValue
    a owl:DatatypeProperty ;
    rdfs:label """has firmware version value""" ;
    rdfs:domain mtc-cnstr:SensorConfiguration ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """Version number for the sensor unit as specified by the manufacturer.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:hasNextCalibrationDateValue
    a owl:DatatypeProperty ;
    rdfs:label """has next calibration date value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """Date upon which the {{term(sensor unit)}} is next scheduled to be calibrated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:hasNumberValue
    a owl:DatatypeProperty ;
    rdfs:label """has number value""" ;
    rdfs:domain mtc-cnstr:Channel ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """unique identifier that will only refer to a specific {{term(sensing element)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:isChannelOf
    a owl:ObjectProperty ;
    rdfs:label """is channel of""" ;
    rdfs:domain mtc-cnstr:Channel ;
    rdfs:range mtc-cnstr:SensorConfiguration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

mtc-cnstr:isSensorConfigurationOf
    a owl:ObjectProperty ;
    rdfs:label """is sensor configuration of""" ;
    rdfs:domain mtc-cnstr:SensorConfiguration ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Sensor/> .

