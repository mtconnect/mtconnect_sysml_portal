@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/ComponentOrganizerTypes/>
    a owl:Ontology ;
    rdfs:label "component organizer types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/ComponentOrganizerTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:Structures
    a owl:Class ;
    rdfs:label """structures""" ;
    skos:altLabel """Structures""" ;
    iof-av:directSource """MTConnect Component Structures""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    iof-av:naturalLanguageDefinition """component that organizes structure types. """ ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Component
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:StructuresEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentOrganizerTypes/> .

mtc-cnstr:StructuresEntity
    a owl:Class ;
    rdfs:label """structures entity""" ;
    iof-av:directSource """MTConnect Component Structures""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
    iof-av:naturalLanguageDefinition """component that organizes structure types. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentOrganizerTypes/> .

