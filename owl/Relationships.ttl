@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Relationships/>
    a owl:Ontology ;
    rdfs:label "relationships" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Relationships/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ConfigurationRelationship
    a owl:Class ;
    rdfs:label """configuration relationship""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """association between two pieces of equipment or assets that may function independently but together perform a manufacturing operation.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000020> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:name ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:id ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:RelationshipTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:criticality ;
                      owl:someValuesFrom mtc-cnstr:CriticalityTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isRelationshipOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:name
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:name""" ;
    rdfs:domain mtc-cnstr:ConfigurationRelationship ;
    rdfs:range xsd:string ;
    skos:definition """name associated with this {{block(ConfigurationRelationship)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:id
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:id""" ;
    rdfs:domain mtc-cnstr:ConfigurationRelationship ;
    rdfs:range xsd:ID ;
    skos:definition """unique identifier for this {{block(ConfigurationRelationship)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:ConfigurationRelationship ;
    rdfs:range mtc-cnstr:RelationshipTypeEnum ;
    skos:definition """defines the authority that this piece of equipment has relative to the associated piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:criticality
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:criticality""" ;
    rdfs:domain mtc-cnstr:ConfigurationRelationship ;
    rdfs:range mtc-cnstr:CriticalityTypeEnum ;
    skos:definition """defines whether the services or functions provided by the associated piece of equipment is required for the operation of this piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:isRelationshipOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isRelationshipOf""" ;
    rdfs:domain mtc-cnstr:ConfigurationRelationship ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:ComponentRelationship
    a owl:Class ;
    rdfs:label """component relationship""" ;
    rdfs:subClassOf mtc-cnstr:ConfigurationRelationship ;
    skos:definition """configuration relationship that describes the association between a component or an Asset and another component.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:idRef ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:idRef
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:idRef""" ;
    rdfs:domain mtc-cnstr:ComponentRelationship ;
    rdfs:range xsd:ID ;
    skos:definition """reference to the associated {{block(Component)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:DeviceRelationship
    a owl:Class ;
    rdfs:label """device relationship""" ;
    rdfs:subClassOf mtc-cnstr:ConfigurationRelationship ;
    skos:definition """configuration relationship that describes the association between a component or an Asset and a device.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:deviceUuidRef ;
                      owl:someValuesFrom xsd:UUID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:href ;
                      owl:someValuesFrom xsd:xlinkhref ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:role ;
                      owl:someValuesFrom mtc-cnstr:RoleTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:xlinktype ;
                      owl:someValuesFrom xsd:xlinktype ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:deviceUuidRef
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:deviceUuidRef""" ;
    rdfs:domain mtc-cnstr:DeviceRelationship ;
    rdfs:range xsd:UUID ;
    skos:definition """reference to the {{property(Device::uuid)}} of the associated piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:href
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:href""" ;
    rdfs:domain mtc-cnstr:DeviceRelationship ;
    rdfs:range xsd:xlinkhref ;
    skos:definition """{{term(URI)}} identifying the {{term(agent)}} that is publishing information for the associated piece of equipment. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:role
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:role""" ;
    rdfs:domain mtc-cnstr:DeviceRelationship ;
    rdfs:range mtc-cnstr:RoleTypeEnum ;
    skos:definition """defines the services or capabilities that the referenced piece of equipment provides relative to this piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:xlinktype
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:xlinktype""" ;
    rdfs:domain mtc-cnstr:DeviceRelationship ;
    rdfs:range xsd:xlinktype ;
    skos:definition """`xlink:type`**MUST** have a fixed value of `locator` as defined in W3C XLink 1.1 {{cite(https://www.w3.org/TR/xlink11/)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:AssetRelationship
    a owl:Class ;
    rdfs:label """asset relationship""" ;
    rdfs:subClassOf mtc-cnstr:ConfigurationRelationship ;
    skos:definition """configuration relationship that describes the association between a component or an Asset and another Asset.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:assetIdRef ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:assetType ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:href ;
                      owl:someValuesFrom xsd:xlinkhref ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:assetIdRef
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:assetIdRef""" ;
    rdfs:domain mtc-cnstr:AssetRelationship ;
    rdfs:range xsd:ID ;
    skos:definition """uuid of the related {{block(Asset)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:assetType
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:assetType""" ;
    rdfs:domain mtc-cnstr:AssetRelationship ;
    rdfs:range xsd:string ;
    skos:definition """type of {{block(Asset)}} being referenced.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:href
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:href""" ;
    rdfs:domain mtc-cnstr:AssetRelationship ;
    rdfs:range xsd:xlinkhref ;
    skos:definition """{{term(URI)}} reference to the associated {{block(Asset)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

