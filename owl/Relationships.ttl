@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Relationships/>
    a owl:Ontology ;
    rdfs:label "relationships" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Relationships/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ConfigurationRelationship
    a owl:Class ;
    rdfs:label """configuration relationship""" ;
    skos:altLabel """ConfigurationRelationship""" ;
    iof-av:directSource """MTConnect ConfigurationRelationship""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """association between two pieces of equipment or assets that may function independently but together perform a manufacturing operation.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000020> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:RelationshipTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCriticality ;
                      owl:someValuesFrom mtc-cnstr:CriticalityTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isRelationshipOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:ComponentRelationship
    a owl:Class ;
    rdfs:label """component relationship""" ;
    skos:altLabel """ComponentRelationship""" ;
    iof-av:directSource """MTConnect ConfigurationRelationship ComponentRelationship""" ;
    rdfs:subClassOf mtc-cnstr:ConfigurationRelationship ;
    iof-av:naturalLanguageDefinition """configuration relationship that describes the association between a component or an Asset and another component.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:DeviceRelationship
    a owl:Class ;
    rdfs:label """device relationship""" ;
    skos:altLabel """DeviceRelationship""" ;
    iof-av:directSource """MTConnect ConfigurationRelationship DeviceRelationship""" ;
    rdfs:subClassOf mtc-cnstr:ConfigurationRelationship ;
    iof-av:naturalLanguageDefinition """configuration relationship that describes the association between a component or an Asset and a device.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDeviceUuidRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasHrefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRole ;
                      owl:someValuesFrom mtc-cnstr:RoleTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasXlinktypeValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:AssetRelationship
    a owl:Class ;
    rdfs:label """asset relationship""" ;
    skos:altLabel """AssetRelationship""" ;
    iof-av:directSource """MTConnect ConfigurationRelationship AssetRelationship""" ;
    rdfs:subClassOf mtc-cnstr:ConfigurationRelationship ;
    iof-av:naturalLanguageDefinition """configuration relationship that describes the association between a component or an Asset and another Asset.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasAssetIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasAssetTypeValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasHrefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:hasAssetIdRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has asset id ref value""" ;
    rdfs:domain mtc-cnstr:AssetRelationship ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """uuid of the related {{block(Asset)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:hasCriticality
    a owl:ObjectProperty ;
    rdfs:label """has criticality""" ;
    rdfs:domain mtc-cnstr:ConfigurationRelationship ;
    rdfs:range mtc-cnstr:CriticalityTypeEnum ;
    iof-av:naturalLanguageDefinition """defines whether the services or functions provided by the associated piece of equipment is required for the operation of this piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:hasDeviceUuidRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has device uuid ref value""" ;
    rdfs:domain mtc-cnstr:DeviceRelationship ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """reference to the {{property(Device::uuid)}} of the associated piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:hasHrefValue
    a owl:DatatypeProperty ;
    rdfs:label """has href value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """{{term(URI)}} identifying the {{term(agent)}} that is publishing information for the associated piece of equipment. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:hasRole
    a owl:ObjectProperty ;
    rdfs:label """has role""" ;
    rdfs:domain mtc-cnstr:DeviceRelationship ;
    rdfs:range mtc-cnstr:RoleTypeEnum ;
    iof-av:naturalLanguageDefinition """defines the services or capabilities that the referenced piece of equipment provides relative to this piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

mtc-cnstr:hasXlinktypeValue
    a owl:DatatypeProperty ;
    rdfs:label """has xlinktype value""" ;
    rdfs:domain mtc-cnstr:DeviceRelationship ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """`xlink:type`**MUST** have a fixed value of `locator` as defined in W3C XLink 1.1 {{cite(https://www.w3.org/TR/xlink11/)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Relationships/> .

