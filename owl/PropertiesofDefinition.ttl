@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/>
    a owl:Ontology ;
    rdfs:label "properties of definition" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/PropertiesofDefinition/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:CellDefinition
    a owl:Class ;
    rdfs:label """cell definition""" ;
    skos:altLabel """CellDefinition""" ;
    iof-av:directSource """MTConnect CellDefinition""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    iof-av:naturalLanguageDefinition """semantic definition of a cell.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUnits ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasKeyValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:DataItemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSubType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasKeyType ;
                      owl:someValuesFrom mtc-cnstr:DataItemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDescriptionValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isCellDefinitionOf ;
                      owl:someValuesFrom mtc-cnstr:Definition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isCellDefinitionOf ;
                      owl:someValuesFrom mtc-cnstr:EntryDefinition ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

mtc-cnstr:EntryDefinition
    a owl:Class ;
    rdfs:label """entry definition""" ;
    skos:altLabel """EntryDefinition""" ;
    iof-av:directSource """MTConnect EntryDefinition""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """semantic definition of an entry.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000031> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasKeyValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUnits ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCellDefinition ;
                      owl:someValuesFrom mtc-cnstr:CellDefinition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:DataItemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSubType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasKeyType ;
                      owl:someValuesFrom mtc-cnstr:DataItemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDescriptionValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isEntryDefinitionOf ;
                      owl:someValuesFrom mtc-cnstr:Definition ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

mtc-cnstr:hasDescriptionValue
    a owl:DatatypeProperty ;
    rdfs:label """has description value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """textual description for {{block(Definition)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

mtc-cnstr:hasKeyType
    a owl:ObjectProperty ;
    rdfs:label """has key type""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:DataItemTypeEnum ;
    iof-av:naturalLanguageDefinition """{{property(DataItem::type)}} that defines the meaning of {{property(CellDefinition::key)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

mtc-cnstr:hasSubType
    a owl:ObjectProperty ;
    rdfs:label """has sub type""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """subtype of the {{block(DataItem)}} associated with this {{block(Observation)}}.\n\n{{property(Observation::subType)}} **MUST** match the associated {{property(DataItem::subType)}} defined in the {{term(MTConnectDevices Response Document)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

mtc-cnstr:hasUnits
    a owl:ObjectProperty ;
    rdfs:label """has units""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:UnitEnum ;
    iof-av:naturalLanguageDefinition """same as {{property(DataItem::units)}}. See {{package(Device Information Model)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

mtc-cnstr:isCellDefinitionOf
    a owl:ObjectProperty ;
    rdfs:label """is cell definition of""" ;
    rdfs:domain mtc-cnstr:CellDefinition ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

mtc-cnstr:isEntryDefinitionOf
    a owl:ObjectProperty ;
    rdfs:label """is entry definition of""" ;
    rdfs:domain mtc-cnstr:EntryDefinition ;
    rdfs:range mtc-cnstr:Definition ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PropertiesofDefinition/> .

