mtc-cnstr:PartInformation
    a owl:Class ;
    rdfs:label """part information""" ;
    skos:altLabel """Part""" ;
    iof-av:directSource """MTConnect Component Part""" ;
    rdfs:subClassOf mtc-cnstr:ComponentInformation ;
    iof-av:naturalLanguageDefinition """abstract component composed of a part being processed by a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ComponentInformation
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:Part ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:isWorkedOn ; owl:someValuesFrom mtc-cnstr:DeviceInformation ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:DeviceInformation ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

