    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Container> ;
    iof-av:naturalLanguageDefinition """leaf component composed of a tool storage location associated with a tool magazine or automatic tool changer.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000178 ;
                      owl:someValuesFrom mtc-cnstr:ComponentEntity ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

