@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/ComponentTypes/>
    a owl:Ontology ;
    rdfs:label "component types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/ComponentTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ActuatorSystem
    a owl:Class ;
    rdfs:label """actuator""" ;
    skos:altLabel """Actuator""" ;
    iof-av:directSource """MTConnect Component Actuator""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """component composed of a physical apparatus that moves or controls a mechanism or system. """ ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:ActuatorSystemEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ActuatorSystemEntity
    a owl:Class ;
    rdfs:label """actuator system entity""" ;
    iof-av:directSource """MTConnect Component Actuator""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Machine> ;
    iof-av:naturalLanguageDefinition """component composed of a physical apparatus that moves or controls a mechanism or system. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Auxiliary
    a owl:Class ;
    rdfs:label """auxiliary""" ;
    skos:altLabel """Auxiliary""" ;
    iof-av:directSource """MTConnect Component Auxiliary""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    iof-av:naturalLanguageDefinition """abstract component composed of removable part(s) of a piece of equipment that provides supplementary or extended functionality.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Component
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:AuxiliaryEntity ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:Device ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:AuxiliaryEntity
    a owl:Class ;
    rdfs:label """auxiliary entity""" ;
    iof-av:directSource """MTConnect Component Auxiliary""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Assembly> ;
    iof-av:naturalLanguageDefinition """abstract component composed of removable part(s) of a piece of equipment that provides supplementary or extended functionality.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:DeviceEntity ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:AxisComponent
    a owl:Class ;
    rdfs:label """axis""" ;
    skos:altLabel """Axis""" ;
    iof-av:directSource """MTConnect Component Axis""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    iof-av:naturalLanguageDefinition """abstract component composed of a motion system that provides linear or rotational motion for a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Component
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:MotionSystem ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:Device ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:MotionSystem
    a owl:Class ;
    rdfs:label """motion system""" ;
    iof-av:directSource """MTConnect Component Axis""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """abstract component composed of a motion system that provides linear or rotational motion for a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:DeviceEntity ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:BarFeeder
    a owl:Class ;
    rdfs:label """bar feeder""" ;
    skos:altLabel """BarFeeder""" ;
    iof-av:directSource """MTConnect Component BarFeeder""" ;
    rdfs:subClassOf mtc-cnstr:Loader ;
    iof-av:naturalLanguageDefinition """loader that delivers bar stock to a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Loader
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:BarFeederEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:BarFeederEntity
    a owl:Class ;
    rdfs:label """bar feeder entity""" ;
    iof-av:directSource """MTConnect Component BarFeeder""" ;
    rdfs:subClassOf mtc-cnstr:LoaderEntity ;
    iof-av:naturalLanguageDefinition """loader that delivers bar stock to a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Controller
    a owl:Class ;
    rdfs:label """controller""" ;
    skos:altLabel """Controller""" ;
    iof-av:directSource """MTConnect Component Controller""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system that provides regulation or management of a system or component. <em>ISO 16484-5:2017</em>""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:ControllerEntity ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom mtc-cnstr:Path ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:Device ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:EmergencyStop ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:SystemCondition ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:ControllerMode ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:Communications ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:LogicProgram ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ControllerEntity
    a owl:Class ;
    rdfs:label """controller entity""" ;
    iof-av:directSource """MTConnect Component Controller""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ;
    iof-av:naturalLanguageDefinition """system that provides regulation or management of a system or component. <em>ISO 16484-5:2017</em>""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000178 ;
                      owl:someValuesFrom mtc-cnstr:PathEntity ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:DeviceEntity ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Coolant
    a owl:Class ;
    rdfs:label """coolant""" ;
    skos:altLabel """Coolant""" ;
    iof-av:directSource """MTConnect Component Coolant""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system that provides distribution and management of fluids that remove heat from a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:CoolantEntity ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:Concentration ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:CoolantEntity
    a owl:Class ;
    rdfs:label """coolant entity""" ;
    iof-av:directSource """MTConnect Component Coolant""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that provides distribution and management of fluids that remove heat from a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Deposition
    a owl:Class ;
    rdfs:label """deposition""" ;
    skos:altLabel """Deposition""" ;
    iof-av:directSource """MTConnect Component Deposition""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    iof-av:naturalLanguageDefinition """auxiliary that manages the addition of material or state change of material being performed in an additive manufacturing process.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Auxiliary
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:DepositionEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:DepositionEntity
    a owl:Class ;
    rdfs:label """deposition entity""" ;
    iof-av:directSource """MTConnect Component Deposition""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ProductionTool> ;
    iof-av:naturalLanguageDefinition """auxiliary that manages the addition of material or state change of material being performed in an additive manufacturing process.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Dielectric
    a owl:Class ;
    rdfs:label """dielectric""" ;
    skos:altLabel """Dielectric""" ;
    iof-av:directSource """MTConnect Component Dielectric""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system that manages a chemical mixture used in a manufacturing process being performed at that piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:DielectricEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:DielectricEntity
    a owl:Class ;
    rdfs:label """dielectric entity""" ;
    iof-av:directSource """MTConnect Component Dielectric""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that manages a chemical mixture used in a manufacturing process being performed at that piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Door
    a owl:Class ;
    rdfs:label """door""" ;
    skos:altLabel """Door""" ;
    iof-av:directSource """MTConnect Component Door""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    iof-av:naturalLanguageDefinition """component composed of a mechanical mechanism or closure that can cover a physical access portal into a piece of equipment allowing or restricting access to other parts of the equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Component
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:DoorEntity ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:DoorState ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:DoorEntity
    a owl:Class ;
    rdfs:label """door entity""" ;
    iof-av:directSource """MTConnect Component Door""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Assembly> ;
    iof-av:naturalLanguageDefinition """component composed of a mechanical mechanism or closure that can cover a physical access portal into a piece of equipment allowing or restricting access to other parts of the equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Electric
    a owl:Class ;
    rdfs:label """electric""" ;
    skos:altLabel """Electric""" ;
    iof-av:directSource """MTConnect Component Electric""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system composed of the main power supply for the piece of equipment that provides distribution of that power throughout the equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:ElectricEntity ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:Wattage ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ElectricEntity
    a owl:Class ;
    rdfs:label """electric entity""" ;
    iof-av:directSource """MTConnect Component Electric""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ;
    iof-av:naturalLanguageDefinition """system composed of the main power supply for the piece of equipment that provides distribution of that power throughout the equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Enclosure
    a owl:Class ;
    rdfs:label """enclosure""" ;
    skos:altLabel """Enclosure""" ;
    iof-av:directSource """MTConnect Component Enclosure""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system composed of a structure that is used to contain or isolate a piece of equipment or area.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:EnclosureEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:EnclosureEntity
    a owl:Class ;
    rdfs:label """enclosure entity""" ;
    iof-av:directSource """MTConnect Component Enclosure""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Container> ;
    iof-av:naturalLanguageDefinition """system composed of a structure that is used to contain or isolate a piece of equipment or area.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:EndEffector
    a owl:Class ;
    rdfs:label """end effector""" ;
    skos:altLabel """EndEffector""" ;
    iof-av:directSource """MTConnect Component EndEffector""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system composed of functions that form the last link segment of a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:EndEffectorEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:EndEffectorEntity
    a owl:Class ;
    rdfs:label """end effector entity""" ;
    iof-av:directSource """MTConnect Component EndEffector""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ProductionTool> ;
    iof-av:naturalLanguageDefinition """system composed of functions that form the last link segment of a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Environmental
    a owl:Class ;
    rdfs:label """environmental""" ;
    skos:altLabel """Environmental""" ;
    iof-av:directSource """MTConnect Component Environmental""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    iof-av:naturalLanguageDefinition """component that observes the surroundings of another component.\n\n> Note: environmental **SHOULD** be organized by Auxillaries, systems or parts depending on the relationship to the component.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Component
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:EnvironmentalEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:EnvironmentalEntity
    a owl:Class ;
    rdfs:label """environmental entity""" ;
    iof-av:directSource """MTConnect Component Environmental""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/DetectingDevice> ;
    iof-av:naturalLanguageDefinition """component that observes the surroundings of another component.\n\n> Note: environmental **SHOULD** be organized by Auxillaries, systems or parts depending on the relationship to the component.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Feeder
    a owl:Class ;
    rdfs:label """feeder""" ;
    skos:altLabel """Feeder""" ;
    iof-av:directSource """MTConnect Component Feeder""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system that manages the delivery of materials within a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:FeederEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:FeederEntity
    a owl:Class ;
    rdfs:label """feeder entity""" ;
    iof-av:directSource """MTConnect Component Feeder""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that manages the delivery of materials within a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Hydraulic
    a owl:Class ;
    rdfs:label """hydraulic""" ;
    skos:altLabel """Hydraulic""" ;
    iof-av:directSource """MTConnect Component Hydraulic""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ;
    iof-av:naturalLanguageDefinition """system that provides movement and distribution of pressurized liquid throughout the piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ActuatorSystem
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:HydraulicEntity ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:PressureSample ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:HydraulicEntity
    a owl:Class ;
    rdfs:label """hydraulic entity""" ;
    iof-av:directSource """MTConnect Component Hydraulic""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that provides movement and distribution of pressurized liquid throughout the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Linear
    a owl:Class ;
    rdfs:label """linear""" ;
    skos:altLabel """Linear""" ;
    iof-av:directSource """MTConnect Component Linear""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ;
    iof-av:naturalLanguageDefinition """axis that provides prismatic motion along a fixed axis.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:AxisComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:LinearMotionSystem ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:Load ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:Temperature ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:observes ; owl:someValuesFrom mtc-cnstr:AxisFeedrateActual ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:LinearMotionSystem
    a owl:Class ;
    rdfs:label """linear motion system""" ;
    iof-av:directSource """MTConnect Component Linear""" ;
    rdfs:subClassOf mtc-cnstr:MotionSystem ;
    iof-av:naturalLanguageDefinition """motion system that provides prismatic motion along a fixed axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Loader
    a owl:Class ;
    rdfs:label """loader""" ;
    skos:altLabel """Loader""" ;
    iof-av:directSource """MTConnect Component Loader""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    iof-av:naturalLanguageDefinition """auxiliary that provides movement and distribution of materials, parts, tooling, and other items to or from a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Auxiliary
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:LoaderEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:LoaderEntity
    a owl:Class ;
    rdfs:label """loader entity""" ;
    iof-av:directSource """MTConnect Component Loader""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Machine> ;
    iof-av:naturalLanguageDefinition """auxiliary that provides movement and distribution of materials, parts, tooling, and other items to or from a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Lubrication
    a owl:Class ;
    rdfs:label """lubrication""" ;
    skos:altLabel """Lubrication""" ;
    iof-av:directSource """MTConnect Component Lubrication""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    iof-av:naturalLanguageDefinition """system that provides distribution and management of fluids used to lubricate portions of the piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SystemComponent
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:LubricationEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:LubricationEntity
    a owl:Class ;
    rdfs:label """lubrication entity""" ;
    iof-av:directSource """MTConnect Component Lubrication""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that provides distribution and management of fluids used to lubricate portions of the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:MaterialResource
    a owl:Class ;
    rdfs:label """material""" ;
    skos:altLabel """Material""" ;
    iof-av:directSource """MTConnect Component Material""" ;
    rdfs:subClassOf mtc-cnstr:Resource ;
    iof-av:naturalLanguageDefinition """resource composed of material that is consumed or used by the piece of equipment for production of parts, materials, or other types of goods.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
