mtc-cnstr:Electrode
    a owl:Class ;
    rdfs:label """electrode""" ;
    skos:altLabel """Electrode""" ;
    iof-av:directSource """MTConnect Component Electrode""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    iof-av:naturalLanguageDefinition """auxiliary that is used for many electrical discharge manufacturing processes like welding.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Auxiliary
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:ElectrodeEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

