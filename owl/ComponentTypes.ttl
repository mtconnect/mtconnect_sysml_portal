@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/ComponentTypes/>
    a owl:Ontology ;
    rdfs:label "component types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/ComponentTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ActuatorSystem
    a owl:Class ;
    rdfs:label """actuator""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """component composed of a physical apparatus that moves or controls a mechanism or system. """ ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Machine> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Auxiliary
    a owl:Class ;
    rdfs:label """auxiliary""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """abstract component composed of removable part(s) of a piece of equipment that provides supplementary or extended functionality.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Tool> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:AxisComponent
    a owl:Class ;
    rdfs:label """axis""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """abstract component composed of a motion system that provides linear or rotational motion for a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:BarFeeder
    a owl:Class ;
    rdfs:label """bar feeder""" ;
    rdfs:subClassOf mtc-cnstr:Loader ;
    skos:definition """loader that delivers bar stock to a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Controller
    a owl:Class ;
    rdfs:label """controller""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system that provides regulation or management of a system or component. <em>ISO 16484-5:2017</em>""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000110 ;
                      owl:someValuesFrom mtc-cnstr:Path ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:EmergencyStop ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:SystemCondition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:ControllerMode ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Communications ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:LogicProgram ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Coolant
    a owl:Class ;
    rdfs:label """coolant""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system that provides distribution and management of fluids that remove heat from a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Concentration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Deposition
    a owl:Class ;
    rdfs:label """deposition""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    skos:definition """auxiliary that manages the addition of material or state change of material being performed in an additive manufacturing process.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ProductionTool> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Dielectric
    a owl:Class ;
    rdfs:label """dielectric""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system that manages a chemical mixture used in a manufacturing process being performed at that piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Door
    a owl:Class ;
    rdfs:label """door""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """component composed of a mechanical mechanism or closure that can cover a physical access portal into a piece of equipment allowing or restricting access to other parts of the equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Assembly> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:DoorState ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Electric
    a owl:Class ;
    rdfs:label """electric""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system composed of the main power supply for the piece of equipment that provides distribution of that power throughout the equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Wattage ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Enclosure
    a owl:Class ;
    rdfs:label """enclosure""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system composed of a structure that is used to contain or isolate a piece of equipment or area.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Container> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:EndEffector
    a owl:Class ;
    rdfs:label """end effector""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system composed of functions that form the last link segment of a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ProductionTool> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Environmental
    a owl:Class ;
    rdfs:label """environmental""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """component that observes the surroundings of another component.\n\n> Note: environmental **SHOULD** be organized by Auxillaries, systems or parts depending on the relationship to the component.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/DetectingDevice> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Feeder
    a owl:Class ;
    rdfs:label """feeder""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system that manages the delivery of materials within a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Hydraulic
    a owl:Class ;
    rdfs:label """hydraulic""" ;
    rdfs:subClassOf mtc-cnstr:ActuatorSystem ;
    skos:definition """system that provides movement and distribution of pressurized liquid throughout the piece of equipment.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:PressureSample ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Linear
    a owl:Class ;
    rdfs:label """linear""" ;
    rdfs:subClassOf mtc-cnstr:AxisComponent ;
    skos:definition """axis that provides prismatic motion along a fixed axis.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Load ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Temperature ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:AxisFeedrateActual ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Loader
    a owl:Class ;
    rdfs:label """loader""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    skos:definition """auxiliary that provides movement and distribution of materials, parts, tooling, and other items to or from a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Machine> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Lubrication
    a owl:Class ;
    rdfs:label """lubrication""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system that provides distribution and management of fluids used to lubricate portions of the piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:MaterialResource
    a owl:Class ;
    rdfs:label """material""" ;
    rdfs:subClassOf mtc-cnstr:Resource ;
    skos:definition """resource composed of material that is consumed or used by the piece of equipment for production of parts, materials, or other types of goods.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000040> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Resources ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Path
    a owl:Class ;
    rdfs:label """path""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """component that organizes an independent operation or function within a controller.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000141> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Execution ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Program ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:PathFeedrateOverrideProgrammed ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:PathFeedrateOverrideRapid ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:RotaryVelocityOverrideEvent ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:PathFeedrate ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:PartCount ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Controller ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Personnel
    a owl:Class ;
    rdfs:label """personnel""" ;
    rdfs:subClassOf mtc-cnstr:Resource ;
    skos:definition """resource composed of an individual or individuals who either control, support, or otherwise interface with a piece of equipment.\n""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Person> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:UserOperator ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:UserMaintenance ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Pneumatic
    a owl:Class ;
    rdfs:label """pneumatic""" ;
    rdfs:subClassOf mtc-cnstr:ActuatorSystem ;
    skos:definition """system that uses compressed gasses to actuate components or do work within the piece of equipment.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/Classifier> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:PressureSample ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Power
    a owl:Class ;
    rdfs:label """power""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """power was **DEPRECATED** in *MTConnect Version 1.1* and was replaced by availability data item type.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000027> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Capability> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ProcessPower
    a owl:Class ;
    rdfs:label """process power""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system composed of a power source associated with a piece of equipment that supplies energy to the manufacturing process separate from the electric system.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Protective
    a owl:Class ;
    rdfs:label """protective""" ;
    rdfs:subClassOf mtc-cnstr:SystemComponent ;
    skos:definition """system that provides functions used to detect or prevent harm or damage to equipment or personnel.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Resource
    a owl:Class ;
    rdfs:label """resource""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """abstract component composed of material or personnel involved in a manufacturing process.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Rotary
    a owl:Class ;
    rdfs:label """rotary""" ;
    rdfs:subClassOf mtc-cnstr:AxisComponent ;
    skos:definition """axis that provides rotation about a fixed axis.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Load ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:Temperature ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:RotaryVelocity ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:AxisFeedrate ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Sensor
    a owl:Class ;
    rdfs:label """sensor""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """component that responds to a physical stimulus and transmits a resulting impulse or value from a sensing unit.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/SensorSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/DetectingDevice> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Stock
    a owl:Class ;
    rdfs:label """stock""" ;
    rdfs:subClassOf mtc-cnstr:MaterialResource ;
    skos:definition """material that is used in a manufacturing process and to which work is applied in a machine or piece of equipment to produce parts.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:MaterialEvent ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:LengthRemaining ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:LengthStandard ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:SystemComponent
    a owl:Class ;
    rdfs:label """system""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """abstract component that is permanently integrated into the piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/System> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ToolingDelivery
    a owl:Class ;
    rdfs:label """tooling delivery""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    skos:definition """auxiliary that manages, positions, stores, and delivers tooling within a piece of equipment.\n""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Assembly> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:WasteDisposal
    a owl:Class ;
    rdfs:label """waste disposal""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    skos:definition """auxiliary that removes manufacturing byproducts from a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Structure
    a owl:Class ;
    rdfs:label """structure""" ;
    rdfs:subClassOf mtc-cnstr:Component ;
    skos:definition """component composed of part(s) comprising the rigid bodies of the piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Link
    a owl:Class ;
    rdfs:label """link""" ;
    rdfs:subClassOf mtc-cnstr:Structure ;
    skos:definition """structure that provides a connection between component entities.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Assembly> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:GangToolBar
    a owl:Class ;
    rdfs:label """gang tool bar""" ;
    rdfs:subClassOf mtc-cnstr:ToolingDelivery ;
