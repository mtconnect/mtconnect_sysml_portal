@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/ComponentTypes/>
    a owl:Ontology ;
    rdfs:label "component types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/ComponentTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ActuatorSystem
    a owl:Class ;
    rdfs:label """actuator system""" ;
    iof-av:directSource """MTConnect Component Actuator""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Machine> ;
    iof-av:naturalLanguageDefinition """component composed of a physical apparatus that moves or controls a mechanism or system. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:AuxiliaryInformation
    a owl:Class ;
    rdfs:label """auxiliary information""" ;
    skos:altLabel """Auxiliary""" ;
    iof-av:directSource """MTConnect Component Auxiliary""" ;
    rdfs:subClassOf mtc-cnstr:ComponentInformation ;
    iof-av:naturalLanguageDefinition """abstract component composed of removable part(s) of a piece of equipment that provides supplementary or extended functionality.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ComponentInformation
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:Auxiliary ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:DeviceInformation ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Auxiliary
    a owl:Class ;
    rdfs:label """auxiliary""" ;
    iof-av:directSource """MTConnect Component Auxiliary""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Assembly> ;
    iof-av:naturalLanguageDefinition """abstract component composed of removable part(s) of a piece of equipment that provides supplementary or extended functionality.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:AxisInformation
    a owl:Class ;
    rdfs:label """axis information""" ;
    skos:altLabel """Axis""" ;
    iof-av:directSource """MTConnect Component Axis""" ;
    rdfs:subClassOf mtc-cnstr:ComponentInformation ;
    iof-av:naturalLanguageDefinition """abstract component composed of a motion system that provides linear or rotational motion for a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ComponentInformation
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:MotionSystem ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:DeviceInformation ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:MotionSystem
    a owl:Class ;
    rdfs:label """motion system""" ;
    iof-av:directSource """MTConnect Component Axis""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """abstract component composed of a motion system that provides linear or rotational motion for a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:BarFeeder
    a owl:Class ;
    rdfs:label """bar feeder""" ;
    iof-av:directSource """MTConnect Component BarFeeder""" ;
    rdfs:subClassOf mtc-cnstr:Loader ;
    iof-av:naturalLanguageDefinition """loader that delivers bar stock to a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Controller
    a owl:Class ;
    rdfs:label """controller""" ;
    iof-av:directSource """MTConnect Component Controller""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ;
    iof-av:naturalLanguageDefinition """system that provides regulation or management of a system or component. <em>ISO 16484-5:2017</em>""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000178 ;
                      owl:someValuesFrom mtc-cnstr:Path ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:CoolantSystem
    a owl:Class ;
    rdfs:label """coolant system""" ;
    iof-av:directSource """MTConnect Component Coolant""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that provides distribution and management of fluids that remove heat from a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Deposition
    a owl:Class ;
    rdfs:label """deposition""" ;
    iof-av:directSource """MTConnect Component Deposition""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ProductionTool> ;
    iof-av:naturalLanguageDefinition """auxiliary that manages the addition of material or state change of material being performed in an additive manufacturing process.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:DielectricSystem
    a owl:Class ;
    rdfs:label """dielectric system""" ;
    iof-av:directSource """MTConnect Component Dielectric""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that manages a chemical mixture used in a manufacturing process being performed at that piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Door
    a owl:Class ;
    rdfs:label """door""" ;
    iof-av:directSource """MTConnect Component Door""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Assembly> ;
    iof-av:naturalLanguageDefinition """component composed of a mechanical mechanism or closure that can cover a physical access portal into a piece of equipment allowing or restricting access to other parts of the equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ElectricSystem
    a owl:Class ;
    rdfs:label """electric system""" ;
    iof-av:directSource """MTConnect Component Electric""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ;
    iof-av:naturalLanguageDefinition """system composed of the main power supply for the piece of equipment that provides distribution of that power throughout the equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Enclosure
    a owl:Class ;
    rdfs:label """enclosure""" ;
    iof-av:directSource """MTConnect Component Enclosure""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Container> ;
    iof-av:naturalLanguageDefinition """system composed of a structure that is used to contain or isolate a piece of equipment or area.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:EndEffector
    a owl:Class ;
    rdfs:label """end effector""" ;
    iof-av:directSource """MTConnect Component EndEffector""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ProductionTool> ;
    iof-av:naturalLanguageDefinition """system composed of functions that form the last link segment of a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Environmental
    a owl:Class ;
    rdfs:label """environmental""" ;
    iof-av:directSource """MTConnect Component Environmental""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/DetectingDevice> ;
    iof-av:naturalLanguageDefinition """component that observes the surroundings of another component.\n\n> Note: environmental **SHOULD** be organized by Auxillaries, systems or parts depending on the relationship to the component.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:FeederSystem
    a owl:Class ;
    rdfs:label """feeder system""" ;
    iof-av:directSource """MTConnect Component Feeder""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that manages the delivery of materials within a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:HydraulicSystem
    a owl:Class ;
    rdfs:label """hydraulic system""" ;
    iof-av:directSource """MTConnect Component Hydraulic""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that provides movement and distribution of pressurized liquid throughout the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:LinearMotionSystem
    a owl:Class ;
    rdfs:label """linear motion system""" ;
    iof-av:directSource """MTConnect Component Linear""" ;
    rdfs:subClassOf mtc-cnstr:MotionSystem ;
    iof-av:naturalLanguageDefinition """motion system that provides prismatic motion along a fixed axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Loader
    a owl:Class ;
    rdfs:label """loader""" ;
    iof-av:directSource """MTConnect Component Loader""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Machine> ;
    iof-av:naturalLanguageDefinition """auxiliary that provides movement and distribution of materials, parts, tooling, and other items to or from a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:LubricationSystem
    a owl:Class ;
    rdfs:label """lubrication system""" ;
    iof-av:directSource """MTConnect Component Lubrication""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that provides distribution and management of fluids used to lubricate portions of the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:MaterialResource
    a owl:Class ;
    rdfs:label """material resource""" ;
    iof-av:directSource """MTConnect Component Material""" ;
    rdfs:subClassOf mtc-cnstr:Resource ;
    iof-av:naturalLanguageDefinition """resource composed of material that is consumed or used by the piece of equipment for production of parts, materials, or other types of goods.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Path
    a owl:Class ;
    rdfs:label """path""" ;
    iof-av:directSource """MTConnect Component Path""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
    iof-av:naturalLanguageDefinition """component that organizes an independent operation or function within a controller.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Controller ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Personnel
    a owl:Class ;
    rdfs:label """personnel""" ;
    iof-av:directSource """MTConnect Component Personnel""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Person> ;
    iof-av:naturalLanguageDefinition """resource composed of an individual or individuals who either control, support, or otherwise interface with a piece of equipment.\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:PneumaticSystem
    a owl:Class ;
    rdfs:label """pneumatic system""" ;
    iof-av:directSource """MTConnect Component Pneumatic""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ;
    iof-av:naturalLanguageDefinition """system that uses compressed gasses to actuate components or do work within the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Power
    a owl:Class ;
    rdfs:label """power""" ;
    iof-av:directSource """MTConnect Component Power""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ElectricalQuality> ;
    iof-av:naturalLanguageDefinition """power was **DEPRECATED** in *MTConnect Version 1.1* and was replaced by availability data item type.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ProcessPowerSystem
    a owl:Class ;
    rdfs:label """process power system""" ;
    iof-av:directSource """MTConnect Component ProcessPower""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system composed of a power source associated with a piece of equipment that supplies energy to the manufacturing process separate from the electric system.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ProtectiveSystem
    a owl:Class ;
    rdfs:label """protective system""" ;
    iof-av:directSource """MTConnect Component Protective""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ;
    iof-av:naturalLanguageDefinition """system that provides functions used to detect or prevent harm or damage to equipment or personnel.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ResourceInformation
    a owl:Class ;
    rdfs:label """resource information""" ;
    skos:altLabel """Resource""" ;
    iof-av:directSource """MTConnect Component Resource""" ;
    rdfs:subClassOf mtc-cnstr:ComponentInformation ;
    iof-av:naturalLanguageDefinition """abstract component composed of material or personnel involved in a manufacturing process.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ComponentInformation
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:Resource ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:DeviceInformation ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Resource
    a owl:Class ;
    rdfs:label """resource""" ;
    iof-av:directSource """MTConnect Component Resource""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ;
    iof-av:naturalLanguageDefinition """abstract component composed of material or personnel involved in a manufacturing process.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:RotaryMotionSystem
    a owl:Class ;
    rdfs:label """rotary motion system""" ;
    iof-av:directSource """MTConnect Component Rotary""" ;
    rdfs:subClassOf mtc-cnstr:MotionSystem ;
    iof-av:naturalLanguageDefinition """motion system that provides rotation about a fixed axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Sensor
    a owl:Class ;
    rdfs:label """sensor""" ;
    iof-av:directSource """MTConnect Component Sensor""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/DetectingDevice> ;
    iof-av:naturalLanguageDefinition """component that responds to a physical stimulus and transmits a resulting impulse or value from a sensing unit.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Stock
    a owl:Class ;
    rdfs:label """stock""" ;
    iof-av:directSource """MTConnect Component Stock""" ;
    rdfs:subClassOf mtc-cnstr:MaterialResource ;
    iof-av:naturalLanguageDefinition """material that is used in a manufacturing process and to which work is applied in a machine or piece of equipment to produce parts.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:SystemInformation
    a owl:Class ;
    rdfs:label """system information""" ;
    skos:altLabel """System""" ;
    iof-av:directSource """MTConnect Component System""" ;
    rdfs:subClassOf mtc-cnstr:ComponentInformation ;
    iof-av:naturalLanguageDefinition """abstract component that is permanently integrated into the piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ComponentInformation
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:System ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000177 ; owl:someValuesFrom mtc-cnstr:DeviceInformation ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:System
    a owl:Class ;
    rdfs:label """system""" ;
    iof-av:directSource """MTConnect Component System""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/System> ;
    iof-av:naturalLanguageDefinition """abstract component that is permanently integrated into the piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ToolingDelivery
    a owl:Class ;
    rdfs:label """tooling delivery""" ;
    iof-av:directSource """MTConnect Component ToolingDelivery""" ;
    rdfs:subClassOf mtc-cnstr:Auxiliary ;
    iof-av:naturalLanguageDefinition """auxiliary that manages, positions, stores, and delivers tooling within a piece of equipment.\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:WasteDisposal
    a owl:Class ;
    rdfs:label """waste disposal""" ;
    iof-av:directSource """MTConnect Component WasteDisposal""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Tool> ;
    iof-av:naturalLanguageDefinition """auxiliary that removes manufacturing byproducts from a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:StructureSystem
    a owl:Class ;
    rdfs:label """structure system""" ;
    iof-av:directSource """MTConnect Component Structure""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ;
    iof-av:naturalLanguageDefinition """component composed of part(s) comprising the rigid bodies of the piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Link
    a owl:Class ;
    rdfs:label """link""" ;
    iof-av:directSource """MTConnect Component Link""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Assembly> ;
    iof-av:naturalLanguageDefinition """structure that provides a connection between component entities.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:GangToolBar
    a owl:Class ;
    rdfs:label """gang tool bar""" ;
    iof-av:directSource """MTConnect Component GangToolBar""" ;
    rdfs:subClassOf mtc-cnstr:ToolingDelivery ;
    iof-av:naturalLanguageDefinition """tooling delivery composed of a tool mounting mechanism that holds any number of tools. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:HeatingSystem
    a owl:Class ;
    rdfs:label """heating system""" ;
    iof-av:directSource """MTConnect Component Heating""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EquipmentModule> ;
    iof-av:naturalLanguageDefinition """system that delivers controlled amounts of heat to achieve a target temperature at a specified heating rate.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:AutomaticToolChanger
    a owl:Class ;
    rdfs:label """automatic tool changer""" ;
    iof-av:directSource """MTConnect Component AutomaticToolChanger""" ;
    rdfs:subClassOf mtc-cnstr:ToolingDelivery ;
    iof-av:naturalLanguageDefinition """tooling delivery composed of a tool delivery mechanism that moves tools between a tool magazine and a spindle a turret.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ProcessInformation
    a owl:Class ;
    rdfs:label """process information""" ;
    skos:altLabel """Process""" ;
    iof-av:directSource """MTConnect Component Process""" ;
    rdfs:subClassOf mtc-cnstr:ComponentInformation ;
    iof-av:naturalLanguageDefinition """abstract component composed of a manufacturing process being executed on a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ComponentInformation
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:Process ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:isProcessOf ; owl:someValuesFrom mtc-cnstr:DeviceInformation ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Process
    a owl:Class ;
    rdfs:label """process""" ;
    iof-av:directSource """MTConnect Component Process""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ManufacturingProcess> ;
    iof-av:naturalLanguageDefinition """abstract component composed of a manufacturing process being executed on a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000057 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ToolMagazine
    a owl:Class ;
    rdfs:label """tool magazine""" ;
    iof-av:directSource """MTConnect Component ToolMagazine""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Container> ;
    iof-av:naturalLanguageDefinition """tooling delivery composed of a tool storage mechanism that holds any number of tools. \n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:PartOccurrence
    a owl:Class ;
    rdfs:label """part occurrence""" ;
    iof-av:directSource """MTConnect Component PartOccurrence""" ;
    rdfs:subClassOf mtc-cnstr:Part ;
    iof-av:naturalLanguageDefinition """part that exists at a specific place and time, such as a specific instance of a bracket at a specific timestamp.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Adapter
    a owl:Class ;
    rdfs:label """adapter""" ;
    iof-av:directSource """MTConnect Component Adapter""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ;
    iof-av:naturalLanguageDefinition """component that provides information about the data source for an MTConnect Agent.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Device ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:ToolRack
    a owl:Class ;
    rdfs:label """tool rack""" ;
    iof-av:directSource """MTConnect Component ToolRack""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Container> ;
    iof-av:naturalLanguageDefinition """tooling delivery composed of a linear or matrixed tool storage mechanism that holds any number of tools.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ComponentTypes/> .

mtc-cnstr:Turret
    a owl:Class ;
    rdfs:label """turret""" ;
