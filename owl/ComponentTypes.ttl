        owl:intersectionOf (
            mtc-cnstr:Component
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:TransformerEntity ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasComposition ; owl:someValuesFrom mtc-cnstr:Composition ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom mtc-cnstr:Component ]
