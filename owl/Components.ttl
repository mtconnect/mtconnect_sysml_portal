@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Components/>
    a owl:Ontology ;
    rdfs:label "components" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Components/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ComponentInformation
    a owl:Class ;
    rdfs:label """component information""" ;
    skos:altLabel """Component""" ;
    iof-av:directSource """MTConnect Component""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """logical or physical entity that provides a capability.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSampleIntervalValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSampleRateValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUuidValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDescription ;
                      owl:someValuesFrom mtc-cnstr:Description ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasComposition ;
                      owl:someValuesFrom mtc-cnstr:Composition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000110 ;
                      owl:someValuesFrom mtc-cnstr:ComponentInformation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasConfiguration ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000177 ;
                      owl:someValuesFrom mtc-cnstr:ComponentInformation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:observes ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:madeObservation ;
                      owl:someValuesFrom mtc-cnstr:Observation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasReference ;
                      owl:someValuesFrom mtc-cnstr:Reference ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCoordinateSystemIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasComponentStream ;
                      owl:someValuesFrom mtc-cnstr:ComponentStream ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:Component
    a owl:Class ;
    rdfs:label """component""" ;
    iof-av:directSource """MTConnect Component""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
    iof-av:naturalLanguageDefinition """logical or physical entity that provides a capability.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000178 ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty bfo:BFO_0000176 ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:Description
    a owl:Class ;
    rdfs:label """description""" ;
    skos:altLabel """Description""" ;
    iof-av:directSource """MTConnect Description""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ;
    iof-av:naturalLanguageDefinition """descriptive content.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasManufacturerValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasModelValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSerialNumberValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasStationValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isDescriptionOf ;
                      owl:someValuesFrom mtc-cnstr:ComponentInformation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isDescriptionOf ;
                      owl:someValuesFrom mtc-cnstr:Composition ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasComponentStream
    a owl:ObjectProperty ;
    rdfs:label """has component stream""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:ComponentStream ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasComposition
    a owl:ObjectProperty ;
    rdfs:label """has composition""" ;
    rdfs:domain mtc-cnstr:ComponentInformation ;
    rdfs:range mtc-cnstr:Composition ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasConfiguration
    a owl:ObjectProperty ;
    rdfs:label """has configuration""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasCoordinateSystemIdRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has coordinate system id ref value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """specifies the {{block(CoordinateSystem)}} for this {{block(Component)}} and its children.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasDescription
    a owl:ObjectProperty ;
    rdfs:label """has description""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:Description ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasIdValue
    a owl:DatatypeProperty ;
    rdfs:label """has id value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """unique identifier for the {{block(Component)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasManufacturerValue
    a owl:DatatypeProperty ;
    rdfs:label """has manufacturer value""" ;
    rdfs:domain mtc-cnstr:Description ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """name of the manufacturer of the physical or logical part of a piece of equipment represented by this element.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasModelValue
    a owl:DatatypeProperty ;
    rdfs:label """has model value""" ;
    rdfs:domain mtc-cnstr:Description ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """model description of the physical part or logical function of a piece of equipment represented by this element.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasNativeNameValue
    a owl:DatatypeProperty ;
    rdfs:label """has native name value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """common name of the {{block(Component)}} associated with the {{block(ComponentStream)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasReference
    a owl:ObjectProperty ;
    rdfs:label """has reference""" ;
    rdfs:domain mtc-cnstr:ComponentInformation ;
    rdfs:range mtc-cnstr:Reference ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasSampleIntervalValue
    a owl:DatatypeProperty ;
    rdfs:label """has sample interval value""" ;
    rdfs:domain mtc-cnstr:ComponentInformation ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """interval in milliseconds between the completion of the reading of the data associated with the {{block(Component)}} until the beginning of the next sampling of that data.\n\nThis information may be used by client software applications to understand how often information from a {{block(Component)}} is expected to be refreshed.\n\nThe refresh rate for data from all child {{block(Component)}} entities will be the\nsame as for the parent {{block(Component)}} element unless specifically overridden by another {{property(Component::sampleInterval)}} provided for the child {{block(Component)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasSampleRateValue
    a owl:DatatypeProperty ;
    rdfs:label """has sample rate value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """rate at which successive samples of the value are recorded.\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasSerialNumberValue
    a owl:DatatypeProperty ;
    rdfs:label """has serial number value""" ;
    rdfs:domain mtc-cnstr:Description ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """serial number associated with a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasStationValue
    a owl:DatatypeProperty ;
    rdfs:label """has station value""" ;
    rdfs:domain mtc-cnstr:Description ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """identifier where a manufacturing function takes place.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:hasUuidValue
    a owl:DatatypeProperty ;
    rdfs:label """has uuid value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """uuid of the {{block(Device)}}.  The value reported for {{property(DeviceStream::uuid)}} **MUST** be the same as the value defined for the {{property(Device::uuid)}} of the same {{block(Device)}} in the {{term(MTConnectDevices Response Document)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:isDescriptionOf
    a owl:ObjectProperty ;
    rdfs:label """is description of""" ;
    rdfs:domain mtc-cnstr:Description ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:madeObservation
    a owl:ObjectProperty ;
    rdfs:label """made observation""" ;
    rdfs:domain mtc-cnstr:ComponentInformation ;
    rdfs:range mtc-cnstr:Observation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

mtc-cnstr:observes
    a owl:ObjectProperty ;
    rdfs:label """observes""" ;
    rdfs:domain mtc-cnstr:ComponentInformation ;
    rdfs:range mtc-cnstr:DataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Components/> .

