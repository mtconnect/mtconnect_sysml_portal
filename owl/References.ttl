@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/References/>
    a owl:Ontology ;
    rdfs:label "references" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/References/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:Reference
    a owl:Class ;
    rdfs:label """reference""" ;
    skos:altLabel """Reference""" ;
    iof-av:directSource """MTConnect Reference""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """pointer to information that is associated with another entity defined elsewhere in the MTConnectDevices entity for a piece of equipment.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000031> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDataItemIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRefDataItemIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isReferenceOf ;
                      owl:someValuesFrom mtc-cnstr:ComponentInformation ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/References/> .

mtc-cnstr:DataItemRef
    a owl:Class ;
    rdfs:label """data item ref""" ;
    skos:altLabel """DataItemRef""" ;
    iof-av:directSource """MTConnect Reference DataItemRef""" ;
    rdfs:subClassOf mtc-cnstr:Reference ;
    iof-av:naturalLanguageDefinition """reference that is a pointer to a data item associated with another entity defined for a piece of equipment.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/Identifier> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000002> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdRef ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/References/> .

mtc-cnstr:ComponentRef
    a owl:Class ;
    rdfs:label """component ref""" ;
    skos:altLabel """ComponentRef""" ;
    iof-av:directSource """MTConnect Reference ComponentRef""" ;
    rdfs:subClassOf mtc-cnstr:Reference ;
    iof-av:naturalLanguageDefinition """reference that is a pointer to all of the information associated with another entity defined for a piece of equipment.\n""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000002> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdRef ;
                      owl:someValuesFrom mtc-cnstr:ComponentInformation ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/References/> .

mtc-cnstr:hasIdRef
    a owl:ObjectProperty ;
    rdfs:label """has id ref""" ;
    rdfs:domain mtc-cnstr:Reference ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """pointer to the {{property(DataItem::id)}} that contains the information to be associated with this entity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/References/> .

mtc-cnstr:hasRefDataItemIdValue
    a owl:DatatypeProperty ;
    rdfs:label """has ref data item id value""" ;
    rdfs:domain mtc-cnstr:Reference ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """pointer to the {{property(DataItem::id)}} that contains the information to be associated with this entity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/References/> .

mtc-cnstr:isReferenceOf
    a owl:ObjectProperty ;
    rdfs:label """is reference of""" ;
    rdfs:domain mtc-cnstr:Reference ;
    rdfs:range mtc-cnstr:ComponentInformation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/References/> .

