@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/PowerSources/>
    a owl:Ontology ;
    rdfs:label "power sources" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/PowerSources/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:PowerSource
    a owl:Class ;
    rdfs:label """power source""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """potential energy sources for the component.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:PowerSourceTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:id ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:componentIdRef ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:order ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:value ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isPowerSourceOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range mtc-cnstr:PowerSourceTypeEnum ;
    skos:definition """type of the power source.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:id
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:id""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range xsd:ID ;
    skos:definition """unique identifier for the power source.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:componentIdRef
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:componentIdRef""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range xsd:ID ;
    skos:definition """reference to the {{block(Component)}} providing observations about the power source.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:order
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:order""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range xsd:integer ;
    skos:definition """optional precedence for a given power source.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:value
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:value""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range xsd:string ;
    skos:definition """name of the power source.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:isPowerSourceOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isPowerSourceOf""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

