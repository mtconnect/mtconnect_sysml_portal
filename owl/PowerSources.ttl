@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/PowerSources/>
    a owl:Ontology ;
    rdfs:label "power sources" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/PowerSources/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:PowerSource
    a owl:Class ;
    rdfs:label """power source""" ;
    skos:altLabel """PowerSource""" ;
    iof-av:directSource """MTConnect PowerSource""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """potential energy sources for the component.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:PowerSourceTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasComponentIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrderValue ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isPowerSourceOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:hasComponentIdRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has component id ref value""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """reference to the {{block(Component)}} providing observations about the power source.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:hasOrderValue
    a owl:DatatypeProperty ;
    rdfs:label """has order value""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range xsd:integer ;
    iof-av:naturalLanguageDefinition """optional precedence for a given power source.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

mtc-cnstr:isPowerSourceOf
    a owl:ObjectProperty ;
    rdfs:label """is power source of""" ;
    rdfs:domain mtc-cnstr:PowerSource ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/PowerSources/> .

