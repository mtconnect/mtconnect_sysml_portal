    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AngleCommanded
    a owl:Class ;
    rdfs:label """angle commanded""" ;
    rdfs:subClassOf mtc-cnstr:Angle ;
    skos:definition """directive value including adjustments such as an offset or overrides.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/SetpointValueExpression> ;
