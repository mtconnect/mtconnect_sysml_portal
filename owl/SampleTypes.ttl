mtc-cnstr:AxisFeedrateCommanded
    a owl:Class ;
    rdfs:label """axis feedrate commanded""" ;
    rdfs:subClassOf mtc-cnstr:AxisFeedrate ;
    skos:definition """directive value including adjustments such as an offset or overrides.""" ;
