@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/SampleTypes/>
    a owl:Ontology ;
    rdfs:label "sample types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/SampleTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:Acceleration
    a owl:Class ;
    rdfs:label """acceleration""" ;
    skos:altLabel """Acceleration""" ;
    iof-av:directSource """MTConnect Sample Acceleration""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Observation> ;
    iof-av:naturalLanguageDefinition """positive rate of change of velocity.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SampleObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasUnits ; owl:hasValue mtc-cnstr:UnitEnum_MILLIMETERSECOND2 ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:SampleEnum_ACCELERATION ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_ACTUAL ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:AccelerationQuality ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AccelerationQuality
    a owl:Class ;
    rdfs:label """acceleration quality""" ;
    iof-av:directSource """MTConnect Sample Acceleration""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    iof-av:naturalLanguageDefinition """positive rate of change of velocity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AccumulatedTime
    a owl:Class ;
    rdfs:label """accumulated time""" ;
    skos:altLabel """AccumulatedTime""" ;
    iof-av:directSource """MTConnect Sample AccumulatedTime""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Observation> ;
    iof-av:naturalLanguageDefinition """accumulated time for an activity or event.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SampleObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasUnits ; owl:hasValue mtc-cnstr:UnitEnum_SECOND ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:SampleEnum_ACCUMULATEDTIME ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:AccumulatedTimeEntity ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AccumulatedTimeEntity
    a owl:Class ;
    rdfs:label """accumulated time entity""" ;
    iof-av:directSource """MTConnect Sample AccumulatedTime""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    iof-av:naturalLanguageDefinition """accumulated time for an activity or event.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:Amperage
    a owl:Class ;
    rdfs:label """amperage""" ;
    skos:altLabel """Amperage""" ;
    iof-av:directSource """MTConnect Sample Amperage""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/Observation> ;
    iof-av:naturalLanguageDefinition """strength of electrical current.\n\n**DEPRECATED** in *Version 1.6*. Replaced by `AMPERAGE_AC` and `AMPERAGE_DC`.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:SampleObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasUnits ; owl:hasValue mtc-cnstr:UnitEnum_AMPERE ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:SampleEnum_AMPERAGE ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:AmperageQuality ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageQuality
    a owl:Class ;
    rdfs:label """amperage quality""" ;
    iof-av:directSource """MTConnect Sample Amperage""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ElectricalQuality> ;
    iof-av:naturalLanguageDefinition """strength of electrical current.\n\n**DEPRECATED** in *Version 1.6*. Replaced by `AMPERAGE_AC` and `AMPERAGE_DC`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageAlternating
    a owl:Class ;
    rdfs:label """amperage alternating""" ;
    skos:altLabel """Amperage.Alternating""" ;
    iof-av:directSource """MTConnect Sample Amperage.Alternating""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity> ;
    iof-av:naturalLanguageDefinition """measurement of alternating voltage or current. \n\nIf not specified further in statistic, defaults to RMS voltage. \n\n**DEPRECATED** in *Version 1.6*.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:Amperage
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_ALTERNATING ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:AmperageAlternatingQuality ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageAlternatingQuality
    a owl:Class ;
    rdfs:label """amperage alternating quality""" ;
    iof-av:directSource """MTConnect Sample Amperage.Alternating""" ;
    rdfs:subClassOf mtc-cnstr:AmperageQuality ;
    iof-av:naturalLanguageDefinition """measurement of alternating voltage or current. \n\nIf not specified further in statistic, defaults to RMS voltage. \n\n**DEPRECATED** in *Version 1.6*.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

