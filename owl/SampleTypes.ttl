    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:AngleCommanded ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AngleActual
    a owl:Class ;
    rdfs:label """angle actual""" ;
    rdfs:subClassOf mtc-cnstr:Angle ;
    skos:definition """measured or reported value of an observation.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MeasuredValueExpression> ;
    rdfs:subClassOf [ a owl:Restriction ;
