    iof-av:naturalLanguageDefinition """wattage used or generated by a component over an interval of time.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:EquipmentTimer
    a owl:Class ;
    rdfs:label """equipment timer""" ;
    iof-av:directSource """MTConnect Sample EquipmentTimer""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    iof-av:naturalLanguageDefinition """amount of time a piece of equipment or a sub-part of a piece of equipment has performed specific activities.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:EquipmentTimerLoaded
    a owl:Class ;
    rdfs:label """equipment timer loaded""" ;
    iof-av:directSource """MTConnect Sample EquipmentTimer.Loaded""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentTimer ;
    iof-av:naturalLanguageDefinition """time that the sub-parts of a piece of equipment are under load.\n\nExample: For traditional machine tools, this is a measurement of the time that the cutting tool is assumed to be engaged with the part.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:EquipmentTimerWorking
    a owl:Class ;
    rdfs:label """equipment timer working""" ;
    iof-av:directSource """MTConnect Sample EquipmentTimer.Working""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentTimer ;
    iof-av:naturalLanguageDefinition """time that a piece of equipment is performing any activity the equipment is active and performing a function under load or not.\n\nExample: For traditional machine tools, this includes `LOADED`, plus rapid moves, tool changes, etc.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:EquipmentTimerOperating
    a owl:Class ;
    rdfs:label """equipment timer operating""" ;
    iof-av:directSource """MTConnect Sample EquipmentTimer.Operating""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentTimer ;
    iof-av:naturalLanguageDefinition """time that the major sub-parts of a piece of equipment are powered or performing any activity whether producing a part or product or not.\n\nExample: For traditional machine tools, this includes `WORKING`, plus idle time.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:EquipmentTimerPowered
    a owl:Class ;
    rdfs:label """equipment timer powered""" ;
    iof-av:directSource """MTConnect Sample EquipmentTimer.Powered""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentTimer ;
    iof-av:naturalLanguageDefinition """time that primary power is applied to the piece of equipment and, as a minimum, the controller or logic portion of the piece of equipment is powered and functioning or components that are required to remain on are powered.\n\nExample: Heaters for an extrusion machine that are required to be powered even when the equipment is turned off.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:EquipmentTimerDelay
    a owl:Class ;
    rdfs:label """equipment timer delay""" ;
    iof-av:directSource """MTConnect Sample EquipmentTimer.Delay""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentTimer ;
    iof-av:naturalLanguageDefinition """elapsed time of a temporary halt of action.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

