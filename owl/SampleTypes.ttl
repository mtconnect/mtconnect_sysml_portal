<https://model.mtconnect.org/ontology/machinetool/SampleTypes/>
    a owl:Ontology ;
    rdfs:label "sample types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/SampleTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:AccelerationQuality
    a owl:Class ;
    rdfs:label """acceleration quality""" ;
    iof-av:directSource """MTConnect Sample Acceleration""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019> ;
    iof-av:naturalLanguageDefinition """positive rate of change of velocity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AccumulatedTime
    a owl:Class ;
    rdfs:label """accumulated time""" ;
    iof-av:directSource """MTConnect Sample AccumulatedTime""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ;
    iof-av:naturalLanguageDefinition """accumulated time for an activity or event.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageQuality
    a owl:Class ;
    rdfs:label """amperage quality""" ;
    iof-av:directSource """MTConnect Sample Amperage""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ElectricalQuality> ;
    iof-av:naturalLanguageDefinition """strength of electrical current.\n\n**DEPRECATED** in *Version 1.6*. Replaced by `AMPERAGE_AC` and `AMPERAGE_DC`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageAlternatingQuality
    a owl:Class ;
    rdfs:label """amperage alternating quality""" ;
    iof-av:directSource """MTConnect Sample Amperage.Alternating""" ;
    rdfs:subClassOf mtc-cnstr:AmperageQuality ;
    iof-av:naturalLanguageDefinition """measurement of alternating voltage or current. \n\nIf not specified further in statistic, defaults to RMS voltage. \n\n**DEPRECATED** in *Version 1.6*.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageDirectQuality
    a owl:Class ;
    rdfs:label """amperage direct quality""" ;
    iof-av:directSource """MTConnect Sample Amperage.Direct""" ;
    rdfs:subClassOf mtc-cnstr:AmperageQuality ;
    iof-av:naturalLanguageDefinition """measurement of DC current or voltage.\n\n**DEPRECATED** in *Version 1.6*.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageActualQuality
    a owl:Class ;
    rdfs:label """amperage actual quality""" ;
    iof-av:directSource """MTConnect Sample Amperage.Actual""" ;
    rdfs:subClassOf mtc-cnstr:AmperageQuality ;
    iof-av:naturalLanguageDefinition """measured or reported value of an observation.\n\n**DEPRECATED** in *Version 1.6*.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AmperageTargetCharacteristic
    a owl:Class ;
    rdfs:label """amperage target characteristic""" ;
    iof-av:directSource """MTConnect Sample Amperage.Target""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/KeyProcessParameter> ;
    iof-av:naturalLanguageDefinition """goal of the operation or process.\n\n**DEPRECATED** in *Version 1.6*.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

