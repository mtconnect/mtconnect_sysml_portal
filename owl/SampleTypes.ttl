            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:SampleEnum_WATERHARDNESS ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:WaterHardnessQuality ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

