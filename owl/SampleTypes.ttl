    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SampleTypes/> .

mtc-cnstr:AxisFeedrateJog
    a owl:Class ;
    rdfs:label """axis feedrate jog""" ;
    rdfs:subClassOf mtc-cnstr:AxisFeedrate ;
    skos:definition """relating to momentary activation of a function or a movement.\n\n**DEPRECATION WARNING**: May be deprecated in the future.""" ;
