@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Specifications/>
    a owl:Ontology ;
    rdfs:label "specifications" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Specifications/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:Specification
    a owl:Class ;
    rdfs:label """specification""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """design characteristics for a piece of equipment.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:DataItemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:dataItemIdRef ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:units ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:compositionIdRef ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:name ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:coordinateSystemIdRef ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:id ;
                      owl:someValuesFrom xsd:ID ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:originator ;
                      owl:someValuesFrom mtc-cnstr:OriginatorEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasMaximum ;
                      owl:someValuesFrom mtc-cnstr:Maximum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUpperLimit ;
                      owl:someValuesFrom mtc-cnstr:UpperLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasLowerWarning ;
                      owl:someValuesFrom mtc-cnstr:LowerWarning ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasLowerLimit ;
                      owl:someValuesFrom mtc-cnstr:LowerLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUpperWarning ;
                      owl:someValuesFrom mtc-cnstr:UpperWarning ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNominal ;
                      owl:someValuesFrom mtc-cnstr:Nominal ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasMinimum ;
                      owl:someValuesFrom mtc-cnstr:Minimum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isSpecificationOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:DataItemTypeEnum ;
    skos:definition """same as {{property(DataItem::type)}}. See {{package(DataItem Types)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    skos:definition """same as {{property(DataItem::subType)}}. See {{sect(DataItem)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:dataItemIdRef
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:dataItemIdRef""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range xsd:ID ;
    skos:definition """reference to the {{property(DataItem::id)}} associated with this entity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:units
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:units""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:UnitEnum ;
    skos:definition """same as {{property(DataItem::units)}}. See {{sect(DataItem)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:compositionIdRef
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:compositionIdRef""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range xsd:ID ;
    skos:definition """reference to the {{property(Composition::id)}} associated with this entity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:name
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:name""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range xsd:string ;
    skos:definition """{{property(Specification::name)}} provides additional meaning and differentiates between {{block(Specification)}} entities.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:coordinateSystemIdRef
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:coordinateSystemIdRef""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range xsd:ID ;
    skos:definition """references the {{block(CoordinateSystem)}} for geometric {{block(Specification)}} elements.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:id
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:id""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range xsd:ID ;
    skos:definition """unique identifier for this {{block(Specification)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:originator
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:originator""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:OriginatorEnum ;
    skos:definition """reference to the creator of the {{block(Specification)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasMaximum
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasMaximum""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:Maximum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasUpperLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasUpperLimit""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:UpperLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasLowerWarning
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasLowerWarning""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:LowerWarning ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasLowerLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasLowerLimit""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:LowerLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasUpperWarning
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasUpperWarning""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:UpperWarning ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasNominal
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasNominal""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:Nominal ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasMinimum
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasMinimum""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:Minimum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:isSpecificationOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isSpecificationOf""" ;
    rdfs:domain mtc-cnstr:Specification ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:ProcessSpecification
    a owl:Class ;
    rdfs:label """process specification""" ;
    rdfs:subClassOf mtc-cnstr:Specification ;
    skos:definition """specification that provides information used to assess the conformance of a variable to process requirements.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/ProcessParameterSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ProcessParameter> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSpecificationLimits ;
                      owl:someValuesFrom mtc-cnstr:SpecificationLimitsSpecifications ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasControlLimits ;
                      owl:someValuesFrom mtc-cnstr:ControlLimitsSpecifications ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasAlarmLimits ;
                      owl:someValuesFrom mtc-cnstr:AlarmLimitsSpecifications ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasSpecificationLimits
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasSpecificationLimits""" ;
    rdfs:domain mtc-cnstr:ProcessSpecification ;
    rdfs:range mtc-cnstr:SpecificationLimitsSpecifications ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasControlLimits
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasControlLimits""" ;
    rdfs:domain mtc-cnstr:ProcessSpecification ;
    rdfs:range mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:hasAlarmLimits
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:hasAlarmLimits""" ;
    rdfs:domain mtc-cnstr:ProcessSpecification ;
    rdfs:range mtc-cnstr:AlarmLimitsSpecifications ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:ControlLimitsSpecifications
    a owl:Class ;
    rdfs:label """control limits""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """set of limits that is used to indicate whether a process variable is stable and in control.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/ControlLimitValueExpression> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:upperLimit ;
                      owl:someValuesFrom mtc-cnstr:UpperLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:upperWarning ;
                      owl:someValuesFrom mtc-cnstr:UpperWarning ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:lowerWarning ;
                      owl:someValuesFrom mtc-cnstr:LowerWarning ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:nominal ;
                      owl:someValuesFrom mtc-cnstr:Nominal ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:lowerLimit ;
                      owl:someValuesFrom mtc-cnstr:LowerLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isControlLimitsOf ;
                      owl:someValuesFrom mtc-cnstr:ProcessSpecification ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:upperLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:upperLimit""" ;
    rdfs:domain mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:range mtc-cnstr:UpperLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:upperWarning
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:upperWarning""" ;
    rdfs:domain mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:range mtc-cnstr:UpperWarning ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:lowerWarning
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:lowerWarning""" ;
    rdfs:domain mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:range mtc-cnstr:LowerWarning ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:nominal
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:nominal""" ;
    rdfs:domain mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:range mtc-cnstr:Nominal ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:lowerLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:lowerLimit""" ;
    rdfs:domain mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:range mtc-cnstr:LowerLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:isControlLimitsOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isControlLimitsOf""" ;
    rdfs:domain mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:range mtc-cnstr:ProcessSpecification ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:AlarmLimitsSpecifications
    a owl:Class ;
    rdfs:label """alarm limits""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """set of limits that is used to trigger warning or alarm indicators.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/AlertLimitValueExpression> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:upperLimit ;
                      owl:someValuesFrom mtc-cnstr:UpperLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:upperWarning ;
                      owl:someValuesFrom mtc-cnstr:UpperWarning ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:lowerLimit ;
                      owl:someValuesFrom mtc-cnstr:LowerLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:lowerWarning ;
                      owl:someValuesFrom mtc-cnstr:LowerWarning ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isAlarmLimitsOf ;
                      owl:someValuesFrom mtc-cnstr:ProcessSpecification ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:upperLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:upperLimit""" ;
    rdfs:domain mtc-cnstr:AlarmLimitsSpecifications ;
    rdfs:range mtc-cnstr:UpperLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:upperWarning
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:upperWarning""" ;
    rdfs:domain mtc-cnstr:AlarmLimitsSpecifications ;
    rdfs:range mtc-cnstr:UpperWarning ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:lowerLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:lowerLimit""" ;
    rdfs:domain mtc-cnstr:AlarmLimitsSpecifications ;
    rdfs:range mtc-cnstr:LowerLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:lowerWarning
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:lowerWarning""" ;
    rdfs:domain mtc-cnstr:AlarmLimitsSpecifications ;
    rdfs:range mtc-cnstr:LowerWarning ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:isAlarmLimitsOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isAlarmLimitsOf""" ;
    rdfs:domain mtc-cnstr:AlarmLimitsSpecifications ;
    rdfs:range mtc-cnstr:ProcessSpecification ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:SpecificationLimitsSpecifications
    a owl:Class ;
    rdfs:label """specification limits""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """set of limits that define a range of values designating acceptable performance for a variable.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/AcceptanceCriteria> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:upperLimit ;
                      owl:someValuesFrom mtc-cnstr:UpperLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:nominal ;
                      owl:someValuesFrom mtc-cnstr:Nominal ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:lowerLimit ;
                      owl:someValuesFrom mtc-cnstr:LowerLimit ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isSpecificationLimitsOf ;
                      owl:someValuesFrom mtc-cnstr:ProcessSpecification ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:upperLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:upperLimit""" ;
    rdfs:domain mtc-cnstr:SpecificationLimitsSpecifications ;
    rdfs:range mtc-cnstr:UpperLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:nominal
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:nominal""" ;
    rdfs:domain mtc-cnstr:SpecificationLimitsSpecifications ;
    rdfs:range mtc-cnstr:Nominal ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:lowerLimit
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:lowerLimit""" ;
    rdfs:domain mtc-cnstr:SpecificationLimitsSpecifications ;
    rdfs:range mtc-cnstr:LowerLimit ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:isSpecificationLimitsOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isSpecificationLimitsOf""" ;
    rdfs:domain mtc-cnstr:SpecificationLimitsSpecifications ;
    rdfs:range mtc-cnstr:ProcessSpecification ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:UpperWarning
    a owl:Class ;
    rdfs:label """upper warning""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """upper boundary indicating increased concern and supervision may be required.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/AlertLimitValueExpression> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ProcessParameter> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:value ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isUpperWarningOf ;
                      owl:someValuesFrom mtc-cnstr:Specification ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isUpperWarningOf ;
                      owl:someValuesFrom mtc-cnstr:ControlLimitsSpecifications ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isUpperWarningOf ;
                      owl:someValuesFrom mtc-cnstr:AlarmLimitsSpecifications ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:value
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:value""" ;
    rdfs:domain mtc-cnstr:UpperWarning ;
    rdfs:range xsd:float ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:isUpperWarningOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isUpperWarningOf""" ;
    rdfs:domain mtc-cnstr:UpperWarning ;
    rdfs:range mtc-cnstr:Specification ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:isUpperWarningOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isUpperWarningOf""" ;
    rdfs:domain mtc-cnstr:UpperWarning ;
    rdfs:range mtc-cnstr:ControlLimitsSpecifications ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:isUpperWarningOf
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:isUpperWarningOf""" ;
    rdfs:domain mtc-cnstr:UpperWarning ;
    rdfs:range mtc-cnstr:AlarmLimitsSpecifications ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Specifications/> .

mtc-cnstr:UpperLimit
    a owl:Class ;
    rdfs:label """upper limit""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    skos:definition """upper conformance boundary for a variable.\n\n> Note: immediate concern or action may be required.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/ActionLimitValueExpression> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
