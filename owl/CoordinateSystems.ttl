@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/>
    a owl:Ontology ;
    rdfs:label "coordinate systems" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/CoordinateSystems/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:CoordinateSystem
    a owl:Class ;
    rdfs:label """coordinate system""" ;
    skos:altLabel """CoordinateSystem""" ;
    iof-av:directSource """MTConnect CoordinateSystem""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """reference system that associates a unique set of n parameters with each point in an n-dimensional space. <em>ISO 10303-218:2004</em>""" ;
    mtc-cnstr:iofParentCandidate <https://www.omg.org/spec/Commons/Collections/Arrangement> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000141> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasParentIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrigin ;
                      owl:someValuesFrom mtc-cnstr:AbstractOrigin ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasTransformation ;
                      owl:someValuesFrom mtc-cnstr:Transformation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:CoordinateSystemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUuidValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDescriptionValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isCoordinateSystemOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:Origin
    a owl:Class ;
    rdfs:label """origin""" ;
    skos:altLabel """Origin""" ;
    iof-av:directSource """MTConnect AbstractOrigin Origin""" ;
    rdfs:subClassOf mtc-cnstr:AbstractOrigin ;
    iof-av:naturalLanguageDefinition """coordinates of the origin position of a coordinate system.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:Transformation
    a owl:Class ;
    rdfs:label """transformation""" ;
    skos:altLabel """Transformation""" ;
    iof-av:directSource """MTConnect Transformation""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """process of transforming to the origin position of the coordinate system from a parent coordinate system using translation and rotation.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/FunctioningProcess> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasTranslation ;
                      owl:someValuesFrom mtc-cnstr:AbstractTranslation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRotation ;
                      owl:someValuesFrom mtc-cnstr:AbstractRotation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isTransformationOf ;
                      owl:someValuesFrom mtc-cnstr:CoordinateSystem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isTransformationOf ;
                      owl:someValuesFrom mtc-cnstr:Motion ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isTransformationOf ;
                      owl:someValuesFrom mtc-cnstr:SolidModel ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:AbstractRotation
    a owl:Class ;
    rdfs:label """abstract rotation""" ;
    skos:altLabel """AbstractRotation""" ;
    iof-av:directSource """MTConnect AbstractRotation""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """rotations about X, Y, and Z axes are expressed in A, B, and C respectively within a 3-dimensional vector. \n""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isRotationOf ;
                      owl:someValuesFrom mtc-cnstr:Transformation ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:AbstractTranslation
    a owl:Class ;
    rdfs:label """abstract translation""" ;
    skos:altLabel """AbstractTranslation""" ;
    iof-av:directSource """MTConnect AbstractTranslation""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """translations along X, Y, and Z axes are expressed as x,y, and z respectively within a 3-dimensional vector. """ ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000033> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isTranslationOf ;
                      owl:someValuesFrom mtc-cnstr:Transformation ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:AbstractOrigin
    a owl:Class ;
    rdfs:label """abstract origin""" ;
    skos:altLabel """AbstractOrigin""" ;
    iof-av:directSource """MTConnect AbstractOrigin""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """coordinates of the origin position of a coordinate system.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000147> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isOriginOf ;
                      owl:someValuesFrom mtc-cnstr:CoordinateSystem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isOriginOf ;
                      owl:someValuesFrom mtc-cnstr:Motion ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:OriginDataSet
    a owl:Class ;
    rdfs:label """origin data set""" ;
    skos:altLabel """OriginDataSet""" ;
    iof-av:directSource """MTConnect Representation OriginDataSet""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    rdfs:subClassOf mtc-cnstr:AbstractOrigin ;
    iof-av:naturalLanguageDefinition """coordinates of the origin position of a coordinate system represented as a dataset.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000100> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000147> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasXValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasYValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasZValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:TranslationAbstractTranslation
    a owl:Class ;
    rdfs:label """translation""" ;
    skos:altLabel """Translation""" ;
    iof-av:directSource """MTConnect AbstractTranslation Translation""" ;
    rdfs:subClassOf mtc-cnstr:AbstractTranslation ;
    iof-av:naturalLanguageDefinition """translations along X, Y, and Z axes are expressed as x,y, and z respectively within a 3-dimensional vector. """ ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/MorphologicalQuality> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:TranslationDataSet
    a owl:Class ;
    rdfs:label """translation data set""" ;
    skos:altLabel """TranslationDataSet""" ;
    iof-av:directSource """MTConnect Representation TranslationDataSet""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    rdfs:subClassOf mtc-cnstr:AbstractTranslation ;
    iof-av:naturalLanguageDefinition """translations along X, Y, and Z axes are expressed as x,y, and z respectively within a 3-dimensional vector represented as a dataset.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000100> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasXValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasYValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasZValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:RotationDataSet
    a owl:Class ;
    rdfs:label """rotation data set""" ;
    skos:altLabel """RotationDataSet""" ;
    iof-av:directSource """MTConnect Representation RotationDataSet""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    rdfs:subClassOf mtc-cnstr:AbstractRotation ;
    iof-av:naturalLanguageDefinition """rotations about X, Y, and Z axes are expressed in A, B, and C respectively within a 3-dimensional vector represented as a dataset.\n""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasAValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasBValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:RotationAbstractRotation
    a owl:Class ;
    rdfs:label """rotation""" ;
    skos:altLabel """Rotation""" ;
    iof-av:directSource """MTConnect AbstractRotation Rotation""" ;
    rdfs:subClassOf mtc-cnstr:AbstractRotation ;
    iof-av:naturalLanguageDefinition """rotations about X, Y, and Z axes are expressed in A, B, and C respectively within a 3-dimensional vector. \n""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasAValue
    a owl:DatatypeProperty ;
    rdfs:label """has a value""" ;
    rdfs:domain mtc-cnstr:RotationDataSet ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """rotation about X axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasBValue
    a owl:DatatypeProperty ;
    rdfs:label """has b value""" ;
    rdfs:domain mtc-cnstr:RotationDataSet ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """rotation about Y axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasCValue
    a owl:DatatypeProperty ;
    rdfs:label """has c value""" ;
    rdfs:domain mtc-cnstr:RotationDataSet ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """rotation about Z axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasOrigin
    a owl:ObjectProperty ;
    rdfs:label """has origin""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:range mtc-cnstr:AbstractOrigin ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasParentIdRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has parent id ref value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """pointer to the {{property(CoordinateSystem::id)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasRotation
    a owl:ObjectProperty ;
    rdfs:label """has rotation""" ;
    rdfs:domain mtc-cnstr:Transformation ;
    rdfs:range mtc-cnstr:AbstractRotation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasTransformation
    a owl:ObjectProperty ;
    rdfs:label """has transformation""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:range mtc-cnstr:Transformation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:hasTranslation
    a owl:ObjectProperty ;
    rdfs:label """has translation""" ;
    rdfs:domain mtc-cnstr:Transformation ;
    rdfs:range mtc-cnstr:AbstractTranslation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:isCoordinateSystemOf
    a owl:ObjectProperty ;
    rdfs:label """is coordinate system of""" ;
    rdfs:domain mtc-cnstr:CoordinateSystem ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:isOriginOf
    a owl:ObjectProperty ;
    rdfs:label """is origin of""" ;
    rdfs:domain mtc-cnstr:AbstractOrigin ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:isRotationOf
    a owl:ObjectProperty ;
    rdfs:label """is rotation of""" ;
    rdfs:domain mtc-cnstr:AbstractRotation ;
    rdfs:range mtc-cnstr:Transformation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:isTransformationOf
    a owl:ObjectProperty ;
    rdfs:label """is transformation of""" ;
    rdfs:domain mtc-cnstr:Transformation ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/DesignSpecification> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

mtc-cnstr:isTranslationOf
    a owl:ObjectProperty ;
    rdfs:label """is translation of""" ;
    rdfs:domain mtc-cnstr:AbstractTranslation ;
    rdfs:range mtc-cnstr:Transformation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/CoordinateSystems/> .

