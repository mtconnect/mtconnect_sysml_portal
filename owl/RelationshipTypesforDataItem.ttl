@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/RelationshipTypesforDataItem/>
    a owl:Ontology ;
    rdfs:label "relationship types for data item" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/RelationshipTypesforDataItem/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:SpecificationRelationship
    a owl:Class ;
    rdfs:label """specification relationship""" ;
    skos:altLabel """SpecificationRelationship""" ;
    iof-av:directSource """MTConnect AbstractDataItemRelationship SpecificationRelationship""" ;
    rdfs:subClassOf mtc-cnstr:AbstractDataItemRelationship ;
    iof-av:naturalLanguageDefinition """abstract data item relationship that provides a semantic reference to another specification described by specification relationship::type and specification relationship::idRef.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:SpecificationRelationshipTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/RelationshipTypesforDataItem/> .

mtc-cnstr:DataItemRelationship
    a owl:Class ;
    rdfs:label """data item relationship""" ;
    skos:altLabel """DataItemRelationship""" ;
    iof-av:directSource """MTConnect AbstractDataItemRelationship DataItemRelationship""" ;
    rdfs:subClassOf mtc-cnstr:AbstractDataItemRelationship ;
    iof-av:naturalLanguageDefinition """abstract data item relationship that provides a semantic reference to another data item described by data item relationship::type.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:DataItemRelationshipTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/RelationshipTypesforDataItem/> .

mtc-cnstr:AbstractDataItemRelationship
    a owl:Class ;
    rdfs:label """abstract data item relationship""" ;
    skos:altLabel """AbstractDataItemRelationship""" ;
    iof-av:directSource """MTConnect AbstractDataItemRelationship""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """association between a data item and another entity.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000020> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isRelationshipOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/RelationshipTypesforDataItem/> .

mtc-cnstr:hasIdRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has id ref value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """reference to the related entity's `id`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/RelationshipTypesforDataItem/> .

mtc-cnstr:hasNameValue
    a owl:DatatypeProperty ;
    rdfs:label """has name value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """identifier of the maintenance activity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/RelationshipTypesforDataItem/> .

mtc-cnstr:isRelationshipOf
    a owl:ObjectProperty ;
    rdfs:label """is relationship of""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/RelationshipTypesforDataItem/> .

