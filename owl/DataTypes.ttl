    iof-av:naturalLanguageDefinition """Interface is currently operational and performing as expected.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:InterfaceStateEnum_DISABLED
    a owl:NamedIndividual, mtc-cnstr:InterfaceStateEnum ;
