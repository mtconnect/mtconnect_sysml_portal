@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/DataTypes/>
    a owl:Ontology ;
    rdfs:label "data types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/DataTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ControlLimitResult
    a owl:Class ;
    rdfs:label """control limit result""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MaterialTestAssessment> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/PerformanceIndicator> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:UpperLimit ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:UpperWarning ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:Nominal ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:LowerWarning ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:LowerLimit ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UpperLimit
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:UpperLimit""" ;
    rdfs:domain mtc-cnstr:ControlLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """upper conformance boundary for a variable.\n\n> Note: immediate concern or action may be required.\n\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UpperWarning
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:UpperWarning""" ;
    rdfs:domain mtc-cnstr:ControlLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """upper boundary indicating increased concern and supervision may be required.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:Nominal
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:Nominal""" ;
    rdfs:domain mtc-cnstr:ControlLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """ideal or desired value for a variable.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:LowerWarning
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:LowerWarning""" ;
    rdfs:domain mtc-cnstr:ControlLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """lower boundary indicating increased concern and supervision may be required.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:LowerLimit
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:LowerLimit""" ;
    rdfs:domain mtc-cnstr:ControlLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """lower conformance boundary for a variable.\n\n> Note: immediate concern or action may be required.\n\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:SpecificationLimitResult
    a owl:Class ;
    rdfs:label """specification limit result""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MaterialTestAssessment> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/PerformanceIndicator> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:UpperLimit ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:Nominal ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:LowerLimit ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UpperLimit
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:UpperLimit""" ;
    rdfs:domain mtc-cnstr:SpecificationLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """upper conformance boundary for a variable.\n\n> Note: immediate concern or action may be required.\n\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:Nominal
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:Nominal""" ;
    rdfs:domain mtc-cnstr:SpecificationLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """ideal or desired value for a variable.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:LowerLimit
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:LowerLimit""" ;
    rdfs:domain mtc-cnstr:SpecificationLimitResult ;
    rdfs:range xsd:float ;
    skos:definition """lower conformance boundary for a variable.\n\n> Note: immediate concern or action may be required.\n\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AlarmLimitResult
    a owl:Class ;
    rdfs:label """alarm limit result""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MaterialTestAssessment> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
