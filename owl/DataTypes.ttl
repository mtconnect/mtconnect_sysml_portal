    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:EmergencyStopEnum
    a owl:Class ;
    rdfs:label """emergency stop enum""" ;
    owl:oneOf ( mtc-cnstr:EmergencyStopEnum_ARMED mtc-cnstr:EmergencyStopEnum_TRIGGERED ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:EmergencyStopEnum_ARMED
    a owl:NamedIndividual, mtc-cnstr:EmergencyStopEnum ;
    rdfs:label """ARMED""" ;
    iof-av:naturalLanguageDefinition """emergency stop circuit is complete and the piece of equipment, component, or composition is allowed to operate. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:EmergencyStopEnum_TRIGGERED
    a owl:NamedIndividual, mtc-cnstr:EmergencyStopEnum ;
    rdfs:label """TRIGGERED""" ;
    iof-av:naturalLanguageDefinition """operation of the piece of equipment, component, or composition is inhibited.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:LockStateEnum
    a owl:Class ;
    rdfs:label """lock state enum""" ;
    owl:oneOf ( mtc-cnstr:LockStateEnum_LOCKED mtc-cnstr:LockStateEnum_UNLOCKED ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:LockStateEnum_LOCKED
    a owl:NamedIndividual, mtc-cnstr:LockStateEnum ;
    rdfs:label """LOCKED""" ;
    iof-av:naturalLanguageDefinition """mechanism is engaged and preventing the associated component from being opened or operated.""" ;
