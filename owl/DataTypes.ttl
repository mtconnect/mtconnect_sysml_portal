mtc-cnstr:DoorStateEnum_OPEN
    a owl:NamedIndividual, mtc-cnstr:DoorStateEnum ;
    rdfs:label """OPEN""" ;
    iof-av:naturalLanguageDefinition """door is open to the point of a positive confirmation.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:DoorStateEnum_CLOSED
    a owl:NamedIndividual, mtc-cnstr:DoorStateEnum ;
    rdfs:label """CLOSED""" ;
    iof-av:naturalLanguageDefinition """door is closed to the point of a positive confirmation.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:DoorStateEnum_UNLATCHED
    a owl:NamedIndividual, mtc-cnstr:DoorStateEnum ;
    rdfs:label """UNLATCHED""" ;
    iof-av:naturalLanguageDefinition """door is not closed to the point of a positive confirmation and not open to the point of a positive confirmation. \n\nIt is in an intermediate position.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:EquipmentModeEnum
    a owl:Class ;
