    rdfs:label """END_EFFECTOR""" ;
    iof-av:naturalLanguageDefinition """location associated with an end effector.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ValveStateEnum
    a owl:Class ;
    rdfs:label """valve state enum""" ;
    owl:oneOf ( mtc-cnstr:ValveStateEnum_OPEN mtc-cnstr:ValveStateEnum_OPENING mtc-cnstr:ValveStateEnum_CLOSED mtc-cnstr:ValveStateEnum_CLOSING ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ValveStateEnum_OPEN
    a owl:NamedIndividual, mtc-cnstr:ValveStateEnum ;
    rdfs:label """OPEN""" ;
    iof-av:naturalLanguageDefinition """valve state where flow is allowed and the aperture is static.\n\n> Note: For a binary value, `OPEN` indicates the valve has the maximum possible aperture.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ValveStateEnum_OPENING
    a owl:NamedIndividual, mtc-cnstr:ValveStateEnum ;
    rdfs:label """OPENING""" ;
    iof-av:naturalLanguageDefinition """valve is transitioning from a `CLOSED` state to an `OPEN` state.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ValveStateEnum_CLOSED
    a owl:NamedIndividual, mtc-cnstr:ValveStateEnum ;
    rdfs:label """CLOSED""" ;
    iof-av:naturalLanguageDefinition """valve state where flow is not possible, the aperture is static, and the valve is completely shut.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ValveStateEnum_CLOSING
    a owl:NamedIndividual, mtc-cnstr:ValveStateEnum ;
    rdfs:label """CLOSING""" ;
    iof-av:naturalLanguageDefinition """valve is transitioning from an `OPEN` state to a `CLOSED` state.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum
    a owl:Class ;
    rdfs:label """code enum""" ;
    owl:oneOf ( mtc-cnstr:CodeEnum_BDX mtc-cnstr:CodeEnum_LBX mtc-cnstr:CodeEnum_APMX mtc-cnstr:CodeEnum_DC mtc-cnstr:CodeEnum_DF mtc-cnstr:CodeEnum_OAL mtc-cnstr:CodeEnum_DMM mtc-cnstr:CodeEnum_H mtc-cnstr:CodeEnum_LS mtc-cnstr:CodeEnum_LUX mtc-cnstr:CodeEnum_LPR mtc-cnstr:CodeEnum_WT mtc-cnstr:CodeEnum_LF mtc-cnstr:CodeEnum_CRP mtc-cnstr:CodeEnum_L mtc-cnstr:CodeEnum_DRVA mtc-cnstr:CodeEnum_WF mtc-cnstr:CodeEnum_IC mtc-cnstr:CodeEnum_SIG mtc-cnstr:CodeEnum_KAPR mtc-cnstr:CodeEnum_PSIR mtc-cnstr:CodeEnum_NA mtc-cnstr:CodeEnum_BS mtc-cnstr:CodeEnum_SDLx mtc-cnstr:CodeEnum_STAx mtc-cnstr:CodeEnum_DCx mtc-cnstr:CodeEnum_HF mtc-cnstr:CodeEnum_RE mtc-cnstr:CodeEnum_LFx mtc-cnstr:CodeEnum_BCH mtc-cnstr:CodeEnum_CHW mtc-cnstr:CodeEnum_W1 ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_BDX
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """BDX""" ;
    iof-av:naturalLanguageDefinition """largest diameter of the body of a tool item.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_LBX
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """LBX""" ;
    iof-av:naturalLanguageDefinition """distance measured along the X axis from that point of the item closest to the workpiece, including the cutting item for a tool item but excluding a protruding locking mechanism for an adaptive item, to either the front of the flange on a flanged body or the beginning of the connection interface feature on the machine side for cylindrical or prismatic shanks.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_APMX
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """APMX""" ;
    iof-av:naturalLanguageDefinition """maximum engagement of the cutting edge or edges with the workpiece measured perpendicular to the feed motion.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_DC
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """DC""" ;
    iof-av:naturalLanguageDefinition """maximum diameter of a circle on which the defined point Pk of each of the master inserts is located on a tool item. The normal of the machined peripheral surface points towards the axis of the cutting tool.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_DF
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """DF""" ;
    iof-av:naturalLanguageDefinition """dimension between two parallel tangents on the outside edge of a flange.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_OAL
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """OAL""" ;
    iof-av:naturalLanguageDefinition """largest length dimension of the cutting tool including the master insert where applicable.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_DMM
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """DMM""" ;
    iof-av:naturalLanguageDefinition """dimension of the diameter of a cylindrical portion of a tool item or an adaptive item that can participate in a connection.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_H
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """H""" ;
    iof-av:naturalLanguageDefinition """dimension of the height of the shank.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_LS
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """LS""" ;
    iof-av:naturalLanguageDefinition """dimension of the length of the shank.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_LUX
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """LUX""" ;
    iof-av:naturalLanguageDefinition """maximum length of a cutting tool that can be used in a particular cutting operation including the non-cutting portions of the tool.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_LPR
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """LPR""" ;
    iof-av:naturalLanguageDefinition """dimension from the yz-plane to the furthest point of the tool item or adaptive item measured in the -X direction.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_WT
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """WT""" ;
    iof-av:naturalLanguageDefinition """total weight of the cutting tool in grams. \n\nThe force exerted by the mass of the cutting tool.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_LF
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """LF""" ;
    iof-av:naturalLanguageDefinition """distance from the gauge plane or from the end of the shank to the furthest point on the tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool. \n\nThe CuttingTool functional length will be the length of the entire tool, not a single cutting item. Each CuttingItem can have an independent FunctionalLength represented in its measurements. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_CRP
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """CRP""" ;
    iof-av:naturalLanguageDefinition """theoretical sharp point of the cutting tool from which the major functional dimensions are taken.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_L
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """L""" ;
    iof-av:naturalLanguageDefinition """theoretical length of the cutting edge of a cutting item over sharp corners.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_DRVA
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """DRVA""" ;
    iof-av:naturalLanguageDefinition """angle between the driving mechanism locator on a tool item and the main cutting edge.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_WF
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """WF""" ;
    iof-av:naturalLanguageDefinition """distance between the cutting reference point and the rear backing surface of a turning tool or the axis of a boring bar.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_IC
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """IC""" ;
    iof-av:naturalLanguageDefinition """diameter of a circle to which all edges of a equilateral and round regular insert are tangential.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_SIG
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """SIG""" ;
    iof-av:naturalLanguageDefinition """angle between the major cutting edge and the same cutting edge rotated by 180 degrees about the tool axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_KAPR
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """KAPR""" ;
    iof-av:naturalLanguageDefinition """angle between the tool cutting edge plane and the tool feed plane measured in a plane parallel the xy-plane.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_PSIR
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """PSIR""" ;
    iof-av:naturalLanguageDefinition """angle between the tool cutting edge plane and a plane perpendicular to the tool feed plane measured in a plane parallel the xy-plane.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_NA
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """N/A""" ;
    iof-av:naturalLanguageDefinition """angle of the tool with respect to the workpiece for a given process. \n\nThe value is application specific.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_BS
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """BS""" ;
    iof-av:naturalLanguageDefinition """measure of the length of a wiper edge of a cutting item.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_SDLx
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """SDLx""" ;
    iof-av:naturalLanguageDefinition """length of a portion of a stepped tool that is related to a corresponding cutting diameter measured from the cutting reference point of that cutting diameter to the point on the next cutting edge at which the diameter starts to change.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_STAx
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """STAx""" ;
    iof-av:naturalLanguageDefinition """angle between a major edge on a step of a stepped tool and the same cutting edge rotated 180 degrees about its tool axis.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_DCx
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """DCx""" ;
    iof-av:naturalLanguageDefinition """diameter of a circle on which the defined point Pk located on this cutting tool.\n\nThe normal of the machined peripheral surface points towards the axis of the cutting tool.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_HF
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """HF""" ;
    iof-av:naturalLanguageDefinition """distance from the basal plane of the tool item to the cutting point.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_RE
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """RE""" ;
    iof-av:naturalLanguageDefinition """nominal radius of a rounded corner measured in the X Y-plane.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_LFx
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """LFx""" ;
    iof-av:naturalLanguageDefinition """distance from the gauge plane or from the end of the shank of the cutting tool, if a gauge plane does not exist, to the cutting reference point determined by the main function of the tool. \n\nThis measurement will be with reference to the cutting tool and **MUST NOT** exist without a cutting tool.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_BCH
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """BCH""" ;
    iof-av:naturalLanguageDefinition """flat length of a chamfer.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_CHW
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """CHW""" ;
    iof-av:naturalLanguageDefinition """width of the chamfer.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CodeEnum_W1
    a owl:NamedIndividual, mtc-cnstr:CodeEnum ;
    rdfs:label """W1""" ;
    iof-av:naturalLanguageDefinition """insert width when an inscribed circle diameter is not practical.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum
    a owl:Class ;
    rdfs:label """application category enum""" ;
    owl:oneOf ( mtc-cnstr:ApplicationCategoryEnum_ASSEMBLY mtc-cnstr:ApplicationCategoryEnum_DEVICE mtc-cnstr:ApplicationCategoryEnum_HANDLING mtc-cnstr:ApplicationCategoryEnum_MAINTENANCE mtc-cnstr:ApplicationCategoryEnum_PART mtc-cnstr:ApplicationCategoryEnum_PROCESS mtc-cnstr:ApplicationCategoryEnum_INSPECTION mtc-cnstr:ApplicationCategoryEnum_SETUP ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_ASSEMBLY
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """ASSEMBLY""" ;
    iof-av:naturalLanguageDefinition """files regarding the fully assembled product.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_DEVICE
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """DEVICE""" ;
    iof-av:naturalLanguageDefinition """device related files.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_HANDLING
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """HANDLING""" ;
    iof-av:naturalLanguageDefinition """files relating to the handling of material.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_MAINTENANCE
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """MAINTENANCE""" ;
    iof-av:naturalLanguageDefinition """files relating to equipment maintenance.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_PART
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """PART""" ;
    iof-av:naturalLanguageDefinition """files relating to a part.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_PROCESS
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """PROCESS""" ;
    iof-av:naturalLanguageDefinition """files related to the manufacturing process.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_INSPECTION
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """INSPECTION""" ;
    iof-av:naturalLanguageDefinition """files related to the quality inspection.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ApplicationCategoryEnum_SETUP
    a owl:NamedIndividual, mtc-cnstr:ApplicationCategoryEnum ;
    rdfs:label """SETUP""" ;
    iof-av:naturalLanguageDefinition """files related to the setup of a process.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum
    a owl:Class ;
    rdfs:label """cutter status type enum""" ;
    iof-av:naturalLanguageDefinition """Enumeration for CutterStatus values.""" ;
    owl:oneOf ( mtc-cnstr:CutterStatusTypeEnum_NEW mtc-cnstr:CutterStatusTypeEnum_AVAILABLE mtc-cnstr:CutterStatusTypeEnum_UNAVAILABLE mtc-cnstr:CutterStatusTypeEnum_ALLOCATED mtc-cnstr:CutterStatusTypeEnum_UNALLOCATED mtc-cnstr:CutterStatusTypeEnum_MEASURED mtc-cnstr:CutterStatusTypeEnum_RECONDITIONED mtc-cnstr:CutterStatusTypeEnum_USED mtc-cnstr:CutterStatusTypeEnum_EXPIRED mtc-cnstr:CutterStatusTypeEnum_BROKEN mtc-cnstr:CutterStatusTypeEnum_NOTREGISTERED mtc-cnstr:CutterStatusTypeEnum_UNKNOWN ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_NEW
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """NEW""" ;
    iof-av:naturalLanguageDefinition """new tool that has not been used or first use. \n\nMarks the start of the tool history.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_AVAILABLE
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """AVAILABLE""" ;
    iof-av:naturalLanguageDefinition """tool is available for use. \n\nIf this is not present, the tool is currently not ready to be used.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_UNAVAILABLE
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """UNAVAILABLE""" ;
    iof-av:naturalLanguageDefinition """tool is unavailable for use in metal removal. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_ALLOCATED
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """ALLOCATED""" ;
    iof-av:naturalLanguageDefinition """tool is has been committed to a piece of equipment for use and is not available for use in any other piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_UNALLOCATED
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """UNALLOCATED""" ;
    iof-av:naturalLanguageDefinition """tool has not been committed to a process and can be allocated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_MEASURED
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """MEASURED""" ;
    iof-av:naturalLanguageDefinition """tool has been measured.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_RECONDITIONED
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """RECONDITIONED""" ;
    iof-av:naturalLanguageDefinition """tool has been reconditioned.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_USED
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """USED""" ;
    iof-av:naturalLanguageDefinition """tool is in process and has remaining tool life.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_EXPIRED
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """EXPIRED""" ;
    iof-av:naturalLanguageDefinition """tool has reached the end of its useful life.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_BROKEN
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """BROKEN""" ;
    iof-av:naturalLanguageDefinition """premature tool failure.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_NOTREGISTERED
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """NOT_REGISTERED""" ;
    iof-av:naturalLanguageDefinition """tool cannot be used until it is entered into the system.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CutterStatusTypeEnum_UNKNOWN
    a owl:NamedIndividual, mtc-cnstr:CutterStatusTypeEnum ;
    rdfs:label """UNKNOWN""" ;
    iof-av:naturalLanguageDefinition """tool is an indeterminate state. This is the default value.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateLateralEnum
    a owl:Class ;
    rdfs:label """composition state lateral enum""" ;
    owl:oneOf ( mtc-cnstr:CompositionStateLateralEnum_RIGHT mtc-cnstr:CompositionStateLateralEnum_LEFT mtc-cnstr:CompositionStateLateralEnum_TRANSITIONING ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateLateralEnum_RIGHT
    a owl:NamedIndividual, mtc-cnstr:CompositionStateLateralEnum ;
    rdfs:label """RIGHT""" ;
    iof-av:naturalLanguageDefinition """position of the composition is oriented to the right to the point of a positive confirmation.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateLateralEnum_LEFT
    a owl:NamedIndividual, mtc-cnstr:CompositionStateLateralEnum ;
    rdfs:label """LEFT""" ;
    iof-av:naturalLanguageDefinition """position of the composition is oriented to the left to the point of a positive confirmation.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateLateralEnum_TRANSITIONING
    a owl:NamedIndividual, mtc-cnstr:CompositionStateLateralEnum ;
    rdfs:label """TRANSITIONING""" ;
    iof-av:naturalLanguageDefinition """position of the composition is not oriented to the right to the point of a positive confirmation and is not oriented to the left to the point of a positive confirmation. \n\nIt is in an intermediate position.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartDetectEnum
    a owl:Class ;
    rdfs:label """part detect enum""" ;
    owl:oneOf ( mtc-cnstr:PartDetectEnum_PRESENT mtc-cnstr:PartDetectEnum_NOTPRESENT ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartDetectEnum_PRESENT
    a owl:NamedIndividual, mtc-cnstr:PartDetectEnum ;
    rdfs:label """PRESENT""" ;
    iof-av:naturalLanguageDefinition """part or work piece is detected or is present.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartDetectEnum_NOTPRESENT
    a owl:NamedIndividual, mtc-cnstr:PartDetectEnum ;
    rdfs:label """NOT_PRESENT""" ;
    iof-av:naturalLanguageDefinition """part or work piece is not detected or is not present.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum
    a owl:Class ;
    rdfs:label """execution enum""" ;
    owl:oneOf ( mtc-cnstr:ExecutionEnum_READY mtc-cnstr:ExecutionEnum_ACTIVE mtc-cnstr:ExecutionEnum_INTERRUPTED mtc-cnstr:ExecutionEnum_FEEDHOLD mtc-cnstr:ExecutionEnum_STOPPED mtc-cnstr:ExecutionEnum_OPTIONALSTOP mtc-cnstr:ExecutionEnum_PROGRAMSTOPPED mtc-cnstr:ExecutionEnum_PROGRAMCOMPLETED mtc-cnstr:ExecutionEnum_WAIT mtc-cnstr:ExecutionEnum_PROGRAMOPTIONALSTOP ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_READY
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """READY""" ;
    iof-av:naturalLanguageDefinition """component is ready to execute instructions.\n\nIt is currently idle.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_ACTIVE
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """ACTIVE""" ;
    iof-av:naturalLanguageDefinition """component is actively executing an instruction.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_INTERRUPTED
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """INTERRUPTED""" ;
    iof-av:naturalLanguageDefinition """component suspends the execution of the program due to an external signal.\n\nAction is required to resume execution.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_FEEDHOLD
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """FEED_HOLD""" ;
    iof-av:naturalLanguageDefinition """motion of the active axes are commanded to stop at their current position.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_STOPPED
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """STOPPED""" ;
    iof-av:naturalLanguageDefinition """component program is not `READY` to execute.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_OPTIONALSTOP
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """OPTIONAL_STOP""" ;
    iof-av:naturalLanguageDefinition """command from the program has intentionally interrupted execution.\n\nThe component **MAY** have another state that indicates if the execution is interrupted or the execution ignores the interrupt instruction.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_PROGRAMSTOPPED
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """PROGRAM_STOPPED""" ;
    iof-av:naturalLanguageDefinition """command from the program has intentionally interrupted execution.\n\nAction is required to resume execution.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_PROGRAMCOMPLETED
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """PROGRAM_COMPLETED""" ;
    iof-av:naturalLanguageDefinition """program completed execution.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_WAIT
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """WAIT""" ;
    iof-av:naturalLanguageDefinition """component suspends execution while a secondary operation executes.\n\nExecution resumes automatically once the secondary operation completes.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ExecutionEnum_PROGRAMOPTIONALSTOP
    a owl:NamedIndividual, mtc-cnstr:ExecutionEnum ;
    rdfs:label """PROGRAM_OPTIONAL_STOP""" ;
    iof-av:naturalLanguageDefinition """program has been intentionally optionally stopped using an M01 or similar code.\n\n**DEPRECATED** in *version 1.4* and replaced with `OPTIONAL_STOP`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AvailabilityEnum
    a owl:Class ;
    rdfs:label """availability enum""" ;
    owl:oneOf ( mtc-cnstr:AvailabilityEnum_AVAILABLE mtc-cnstr:AvailabilityEnum_UNAVAILABLE ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AvailabilityEnum_AVAILABLE
    a owl:NamedIndividual, mtc-cnstr:AvailabilityEnum ;
    rdfs:label """AVAILABLE""" ;
    iof-av:naturalLanguageDefinition """data source is active and capable of providing data.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AvailabilityEnum_UNAVAILABLE
    a owl:NamedIndividual, mtc-cnstr:AvailabilityEnum ;
    rdfs:label """UNAVAILABLE""" ;
    iof-av:naturalLanguageDefinition """data source is either inactive or not capable of providing data.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ProgramEditEnum
    a owl:Class ;
    rdfs:label """program edit enum""" ;
    owl:oneOf ( mtc-cnstr:ProgramEditEnum_ACTIVE mtc-cnstr:ProgramEditEnum_READY mtc-cnstr:ProgramEditEnum_NOTREADY ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ProgramEditEnum_ACTIVE
    a owl:NamedIndividual, mtc-cnstr:ProgramEditEnum ;
    rdfs:label """ACTIVE""" ;
    iof-av:naturalLanguageDefinition """controller is in the program edit mode.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ProgramEditEnum_READY
    a owl:NamedIndividual, mtc-cnstr:ProgramEditEnum ;
    rdfs:label """READY""" ;
    iof-av:naturalLanguageDefinition """controller is capable of entering the program edit mode and no function is inhibiting a change to that mode.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ProgramEditEnum_NOTREADY
    a owl:NamedIndividual, mtc-cnstr:ProgramEditEnum ;
    rdfs:label """NOT_READY""" ;
    iof-av:naturalLanguageDefinition """controller is being inhibited by a function from entering the program edit mode.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ControllerModeOverrideEnum
    a owl:Class ;
    rdfs:label """controller mode override enum""" ;
    owl:oneOf ( mtc-cnstr:ControllerModeOverrideEnum_ON mtc-cnstr:ControllerModeOverrideEnum_OFF ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ControllerModeOverrideEnum_ON
    a owl:NamedIndividual, mtc-cnstr:ControllerModeOverrideEnum ;
    rdfs:label """ON""" ;
    iof-av:naturalLanguageDefinition """controller mode override is in the `ON` state and the mode override is active.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ControllerModeOverrideEnum_OFF
    a owl:NamedIndividual, mtc-cnstr:ControllerModeOverrideEnum ;
    rdfs:label """OFF""" ;
    iof-av:naturalLanguageDefinition """controller mode override is in the `OFF` state and the mode override is inactive.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FunctionalModeEnum
    a owl:Class ;
    rdfs:label """functional mode enum""" ;
    owl:oneOf ( mtc-cnstr:FunctionalModeEnum_PRODUCTION mtc-cnstr:FunctionalModeEnum_SETUP mtc-cnstr:FunctionalModeEnum_TEARDOWN mtc-cnstr:FunctionalModeEnum_MAINTENANCE mtc-cnstr:FunctionalModeEnum_PROCESSDEVELOPMENT ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FunctionalModeEnum_PRODUCTION
    a owl:NamedIndividual, mtc-cnstr:FunctionalModeEnum ;
    rdfs:label """PRODUCTION""" ;
    iof-av:naturalLanguageDefinition """component is currently producing product, ready to produce product, or its current intended use is to be producing product.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FunctionalModeEnum_SETUP
    a owl:NamedIndividual, mtc-cnstr:FunctionalModeEnum ;
    rdfs:label """SETUP""" ;
    iof-av:naturalLanguageDefinition """component is not currently producing product. \n\nIt is being prepared or modified to begin production of product.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FunctionalModeEnum_TEARDOWN
    a owl:NamedIndividual, mtc-cnstr:FunctionalModeEnum ;
    rdfs:label """TEARDOWN""" ;
    iof-av:naturalLanguageDefinition """component is not currently producing product.\n\nTypically, it has completed the production of a product and is being modified or returned to a neutral state such that it may then be prepared to begin production of a different product.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FunctionalModeEnum_MAINTENANCE
    a owl:NamedIndividual, mtc-cnstr:FunctionalModeEnum ;
    rdfs:label """MAINTENANCE""" ;
    iof-av:naturalLanguageDefinition """component is not currently producing product.\n\nIt is currently being repaired, waiting to be repaired, or has not yet been returned to a normal production status after maintenance has been performed.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FunctionalModeEnum_PROCESSDEVELOPMENT
    a owl:NamedIndividual, mtc-cnstr:FunctionalModeEnum ;
    rdfs:label """PROCESS_DEVELOPMENT""" ;
    iof-av:naturalLanguageDefinition """component is being used to prove-out a new process, testing of equipment or processes, or any other active use that does not result in the production of product.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum
    a owl:Class ;
    rdfs:label """wait state enum""" ;
    owl:oneOf ( mtc-cnstr:WaitStateEnum_POWERINGUP mtc-cnstr:WaitStateEnum_POWERINGDOWN mtc-cnstr:WaitStateEnum_PARTLOAD mtc-cnstr:WaitStateEnum_PARTUNLOAD mtc-cnstr:WaitStateEnum_TOOLLOAD mtc-cnstr:WaitStateEnum_TOOLUNLOAD mtc-cnstr:WaitStateEnum_MATERIALLOAD mtc-cnstr:WaitStateEnum_MATERIALUNLOAD mtc-cnstr:WaitStateEnum_SECONDARYPROCESS mtc-cnstr:WaitStateEnum_PAUSING mtc-cnstr:WaitStateEnum_RESUMING ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_POWERINGUP
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """POWERING_UP""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while the equipment is powering up and is not currently available to begin producing parts or products.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_POWERINGDOWN
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """POWERING_DOWN""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while the equipment is powering down but has not fully reached a stopped state.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_PARTLOAD
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """PART_LOAD""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while one or more discrete workpieces are being loaded.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_PARTUNLOAD
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """PART_UNLOAD""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while one or more discrete workpieces are being unloaded.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_TOOLLOAD
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """TOOL_LOAD""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while a tool or tooling is being loaded.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_TOOLUNLOAD
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """TOOL_UNLOAD""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while a tool or tooling is being unloaded.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_MATERIALLOAD
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """MATERIAL_LOAD""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while material is being loaded.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_MATERIALUNLOAD
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """MATERIAL_UNLOAD""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while material is being unloaded.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_SECONDARYPROCESS
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """SECONDARY_PROCESS""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while another process is completed before the execution can resume.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_PAUSING
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """PAUSING""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while the equipment is pausing but the piece of equipment has not yet reached a fully paused state.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:WaitStateEnum_RESUMING
    a owl:NamedIndividual, mtc-cnstr:WaitStateEnum ;
    rdfs:label """RESUMING""" ;
    iof-av:naturalLanguageDefinition """execution is waiting while the equipment is resuming the production cycle but has not yet resumed execution.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

