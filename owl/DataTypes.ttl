mtc-cnstr:CompositionStateVerticalEnum_UP
    a owl:NamedIndividual, mtc-cnstr:CompositionStateVerticalEnum ;
    rdfs:label """UP""" ;
    iof-av:naturalLanguageDefinition """position of the composition element is oriented in an upward direction to the point of a positive confirmation.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateVerticalEnum_DOWN
    a owl:NamedIndividual, mtc-cnstr:CompositionStateVerticalEnum ;
    rdfs:label """DOWN""" ;
    iof-av:naturalLanguageDefinition """position of the composition element is oriented in a downward direction to the point of a positive confirmation.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateVerticalEnum_TRANSITIONING
    a owl:NamedIndividual, mtc-cnstr:CompositionStateVerticalEnum ;
    rdfs:label """TRANSITIONING""" ;
    iof-av:naturalLanguageDefinition """position of the composition element is not oriented in an upward direction to the point of a positive confirmation and is not oriented in a downward direction to the point of a positive confirmation. \n\nIt is in an intermediate position.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RequestStateEnum
    a owl:Class ;
    rdfs:label """request state enum""" ;
    owl:oneOf ( mtc-cnstr:RequestStateEnum_NOTREADY mtc-cnstr:RequestStateEnum_READY mtc-cnstr:RequestStateEnum_ACTIVE mtc-cnstr:RequestStateEnum_FAIL ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RequestStateEnum_NOTREADY
    a owl:NamedIndividual, mtc-cnstr:RequestStateEnum ;
    rdfs:label """NOT_READY""" ;
    iof-av:naturalLanguageDefinition """requester is not ready to make a request.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RequestStateEnum_READY
    a owl:NamedIndividual, mtc-cnstr:RequestStateEnum ;
    rdfs:label """READY""" ;
    iof-av:naturalLanguageDefinition """requester is prepared to make a request, but no request for service is required.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RequestStateEnum_ACTIVE
    a owl:NamedIndividual, mtc-cnstr:RequestStateEnum ;
    rdfs:label """ACTIVE""" ;
    iof-av:naturalLanguageDefinition """requester has initiated a request for a service and the service has not yet been completed by the responder.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RequestStateEnum_FAIL
    a owl:NamedIndividual, mtc-cnstr:RequestStateEnum ;
    rdfs:label """FAIL""" ;
    iof-av:naturalLanguageDefinition """requester has detected a failure condition.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResponseStateEnum
    a owl:Class ;
    rdfs:label """response state enum""" ;
    owl:oneOf ( mtc-cnstr:ResponseStateEnum_NOTREADY mtc-cnstr:ResponseStateEnum_READY mtc-cnstr:ResponseStateEnum_ACTIVE mtc-cnstr:ResponseStateEnum_COMPLETE mtc-cnstr:ResponseStateEnum_FAIL ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResponseStateEnum_NOTREADY
    a owl:NamedIndividual, mtc-cnstr:ResponseStateEnum ;
    rdfs:label """NOT_READY""" ;
    iof-av:naturalLanguageDefinition """responder is not ready to perform a service.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResponseStateEnum_READY
    a owl:NamedIndividual, mtc-cnstr:ResponseStateEnum ;
    rdfs:label """READY""" ;
    iof-av:naturalLanguageDefinition """responder is prepared to react to a request, but no request for service has been detected.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResponseStateEnum_ACTIVE
    a owl:NamedIndividual, mtc-cnstr:ResponseStateEnum ;
    rdfs:label """ACTIVE""" ;
    iof-av:naturalLanguageDefinition """responder has detected and accepted a request for a service and is in the process of performing the service, but the service has not yet\nbeen completed.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResponseStateEnum_COMPLETE
    a owl:NamedIndividual, mtc-cnstr:ResponseStateEnum ;
    rdfs:label """COMPLETE""" ;
    iof-av:naturalLanguageDefinition """responder has completed the actions required to perform the service.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResponseStateEnum_FAIL
    a owl:NamedIndividual, mtc-cnstr:ResponseStateEnum ;
    rdfs:label """FAIL""" ;
    iof-av:naturalLanguageDefinition """responder has detected a failure condition.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:SpindleInterlockEnum
    a owl:Class ;
    rdfs:label """spindle interlock enum""" ;
    owl:oneOf ( mtc-cnstr:SpindleInterlockEnum_ACTIVE mtc-cnstr:SpindleInterlockEnum_INACTIVE ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:SpindleInterlockEnum_ACTIVE
    a owl:NamedIndividual, mtc-cnstr:SpindleInterlockEnum ;
    rdfs:label """ACTIVE""" ;
    iof-av:naturalLanguageDefinition """power has been removed and the spindle cannot be operated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:SpindleInterlockEnum_INACTIVE
    a owl:NamedIndividual, mtc-cnstr:SpindleInterlockEnum ;
    rdfs:label """INACTIVE""" ;
    iof-av:naturalLanguageDefinition """spindle has not been deactivated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AxisInterlockEnum
    a owl:Class ;
    rdfs:label """axis interlock enum""" ;
    owl:oneOf ( mtc-cnstr:AxisInterlockEnum_ACTIVE mtc-cnstr:AxisInterlockEnum_INACTIVE ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AxisInterlockEnum_ACTIVE
    a owl:NamedIndividual, mtc-cnstr:AxisInterlockEnum ;
    rdfs:label """ACTIVE""" ;
    iof-av:naturalLanguageDefinition """axis lockout function is activated, power has been removed from the axis, and the axis is allowed to move freely.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AxisInterlockEnum_INACTIVE
    a owl:NamedIndividual, mtc-cnstr:AxisInterlockEnum ;
    rdfs:label """INACTIVE""" ;
    iof-av:naturalLanguageDefinition """axis lockout function has not been activated, the axis may be powered, and the axis is capable of being controlled by another component.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ChuckInterlockEnum
    a owl:Class ;
    rdfs:label """chuck interlock enum""" ;
    owl:oneOf ( mtc-cnstr:ChuckInterlockEnum_ACTIVE mtc-cnstr:ChuckInterlockEnum_INACTIVE ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ChuckInterlockEnum_ACTIVE
    a owl:NamedIndividual, mtc-cnstr:ChuckInterlockEnum ;
    rdfs:label """ACTIVE""" ;
    iof-av:naturalLanguageDefinition """chuck cannot be unclamped.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ChuckInterlockEnum_INACTIVE
    a owl:NamedIndividual, mtc-cnstr:ChuckInterlockEnum ;
    rdfs:label """INACTIVE""" ;
    iof-av:naturalLanguageDefinition """chuck can be unclamped.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:DoorStateEnum
    a owl:Class ;
