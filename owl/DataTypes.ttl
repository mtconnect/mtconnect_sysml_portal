mtc-cnstr:AxisStateEnum_STOPPED
    a owl:NamedIndividual, mtc-cnstr:AxisStateEnum ;
    rdfs:label """STOPPED""" ;
    iof-av:naturalLanguageDefinition """axis is stopped.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

