mtc-cnstr:LockStateEnum_UNLOCKED
    a owl:NamedIndividual, mtc-cnstr:LockStateEnum ;
    rdfs:label """UNLOCKED""" ;
    iof-av:naturalLanguageDefinition """mechanism is disengaged and the associated component is able to be opened or operated.""" ;
