mtc-cnstr:FilterEnum
    a owl:Class ;
    rdfs:label """filter enum""" ;
    owl:oneOf ( mtc-cnstr:FilterEnum_MINIMUMDELTA mtc-cnstr:FilterEnum_PERIOD ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FilterEnum_MINIMUMDELTA
    a owl:NamedIndividual, mtc-cnstr:FilterEnum ;
    rdfs:label """MINIMUM_DELTA""" ;
    iof-av:naturalLanguageDefinition """new value **MUST NOT** be reported for a data item unless the measured value has changed from the last reported value by at least the delta given as the value of this element.\n\nThe value of filter **MUST** be an absolute value using the same units as the reported data.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:FilterEnum_PERIOD
    a owl:NamedIndividual, mtc-cnstr:FilterEnum ;
    rdfs:label """PERIOD""" ;
    iof-av:naturalLanguageDefinition """data reported for a data item is provided on a periodic basis. The `PERIOD` for reporting data is defined in the value of the filter.\n\nThe value of filter **MUST** be an absolute value reported in seconds representing the time between reported samples of the value of the data item.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RepresentationEnum
    a owl:Class ;
    rdfs:label """representation enum""" ;
    owl:oneOf ( mtc-cnstr:RepresentationEnum_TIMESERIES mtc-cnstr:RepresentationEnum_VALUE mtc-cnstr:RepresentationEnum_DATASET mtc-cnstr:RepresentationEnum_DISCRETE mtc-cnstr:RepresentationEnum_TABLE ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RepresentationEnum_TIMESERIES
    a owl:NamedIndividual, mtc-cnstr:RepresentationEnum ;
    rdfs:label """TIME_SERIES""" ;
    iof-av:naturalLanguageDefinition """series of sampled data.\n\nThe data is reported for a specified number of samples and each sample is reported with a fixed period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RepresentationEnum_VALUE
    a owl:NamedIndividual, mtc-cnstr:RepresentationEnum ;
    rdfs:label """VALUE""" ;
    iof-av:naturalLanguageDefinition """measured value of the sample data.\n\nIf no data item::representation is specified for a data item, the data item::representation **MUST** be determined to be `VALUE`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RepresentationEnum_DATASET
    a owl:NamedIndividual, mtc-cnstr:RepresentationEnum ;
    rdfs:label """DATA_SET""" ;
    iof-av:naturalLanguageDefinition """reported value(s) are represented as a set of key-value pairs.\n\nEach reported value in the data set **MUST** have a unique key.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RepresentationEnum_DISCRETE
    a owl:NamedIndividual, mtc-cnstr:RepresentationEnum ;
    rdfs:label """DISCRETE""" ;
    iof-av:naturalLanguageDefinition """**DEPRECATED** as data item::representation type in *MTConnect Version 1.5*. Replaced by the data item::discrete.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RepresentationEnum_TABLE
    a owl:NamedIndividual, mtc-cnstr:RepresentationEnum ;
    rdfs:label """TABLE""" ;
    iof-av:naturalLanguageDefinition """two dimensional set of key-value pairs where the entry represents a row, and the value is a set of key-value pair cell elements. \n\nA table follows the same behavior as the data set for change tracking, clearing, and history. When an entry changes, all cell elements update as a single unit following the behavior of a data set.\n\n> Note: It is best to use variable if the cell entities represent multiple semantic types.\n\nEach entry in the table **MUST** have a unique key. Each cell of each entry in the table **MUST** have a unique key.\n\nSee representation in observation information model, for a description of entry and cell elements.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggeredEnum
    a owl:Class ;
    rdfs:label """reset triggered enum""" ;
