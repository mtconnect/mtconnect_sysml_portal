    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RelationshipTypeEnum_CHILD
    a owl:NamedIndividual, mtc-cnstr:RelationshipTypeEnum ;
    rdfs:label """CHILD""" ;
    iof-av:naturalLanguageDefinition """functions as a child in the relationship with the associated element.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RelationshipTypeEnum_PEER
