mtc-cnstr:PartProcessingStateEnum
    a owl:Class ;
    rdfs:label """part processing state enum""" ;
    owl:oneOf ( mtc-cnstr:PartProcessingStateEnum_NEEDSPROCESSING mtc-cnstr:PartProcessingStateEnum_INPROCESS mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDED mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDCOMPLETE mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDSTOPPED mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDABORTED mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDLOST mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDSKIPPED mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDREJECTED mtc-cnstr:PartProcessingStateEnum_WAITINGFORTRANSIT mtc-cnstr:PartProcessingStateEnum_INTRANSIT mtc-cnstr:PartProcessingStateEnum_TRANSITCOMPLETE ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_NEEDSPROCESSING
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """NEEDS_PROCESSING""" ;
    iof-av:naturalLanguageDefinition """part occurrence is not actively being processed, but the processing has not ended. \n\nProcessing requirements exist that have not yet been fulfilled. This is the default entry state when the part occurrence is originally received. In some cases, the part occurrence may return to this state while it waits for additional processing to be performed.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_INPROCESS
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """IN_PROCESS""" ;
    iof-av:naturalLanguageDefinition """part occurrence is actively being processed.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDED
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """PROCESSING_ENDED""" ;
    iof-av:naturalLanguageDefinition """part occurrence is no longer being processed. \n\nA general state when the reason for termination is unknown.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDCOMPLETE
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """PROCESSING_ENDED_COMPLETE""" ;
    iof-av:naturalLanguageDefinition """part occurrence has completed processing successfully.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDSTOPPED
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """PROCESSING_ENDED_STOPPED""" ;
    iof-av:naturalLanguageDefinition """process has been stopped during the processing. \n\nThe part occurrence will require special treatment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDABORTED
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """PROCESSING_ENDED_ABORTED""" ;
    iof-av:naturalLanguageDefinition """processing of the part occurrence has come to a premature end.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDLOST
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """PROCESSING_ENDED_LOST""" ;
    iof-av:naturalLanguageDefinition """terminal state when the part occurrence has been removed from the equipment by an external entity and it no longer exists at the equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDSKIPPED
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """PROCESSING_ENDED_SKIPPED""" ;
    iof-av:naturalLanguageDefinition """part occurrence has been skipped for processing on the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_PROCESSINGENDEDREJECTED
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """PROCESSING_ENDED_REJECTED""" ;
    iof-av:naturalLanguageDefinition """part occurrence has been processed completely. However, the processing may have a problem.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_WAITINGFORTRANSIT
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """WAITING_FOR_TRANSIT""" ;
    iof-av:naturalLanguageDefinition """part occurrence is waiting for transit.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_INTRANSIT
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """IN_TRANSIT""" ;
    iof-av:naturalLanguageDefinition """part occurrence is being transported to its destination.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartProcessingStateEnum_TRANSITCOMPLETE
    a owl:NamedIndividual, mtc-cnstr:PartProcessingStateEnum ;
    rdfs:label """TRANSIT_COMPLETE""" ;
    iof-av:naturalLanguageDefinition """part occurrence has been placed at its designated destination.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

