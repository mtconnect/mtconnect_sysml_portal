mtc-cnstr:EquipmentModeEnum_ON
    a owl:NamedIndividual, mtc-cnstr:EquipmentModeEnum ;
    rdfs:label """ON""" ;
    iof-av:naturalLanguageDefinition """equipment is functioning in the mode designated by the `subType`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:EquipmentModeEnum_OFF
    a owl:NamedIndividual, mtc-cnstr:EquipmentModeEnum ;
    rdfs:label """OFF""" ;
    iof-av:naturalLanguageDefinition """equipment is not functioning in the mode designated by the `subType`.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PowerStateEnum
    a owl:Class ;
    rdfs:label """power state enum""" ;
    owl:oneOf ( mtc-cnstr:PowerStateEnum_ON mtc-cnstr:PowerStateEnum_OFF ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PowerStateEnum_ON
    a owl:NamedIndividual, mtc-cnstr:PowerStateEnum ;
    rdfs:label """ON""" ;
    iof-av:naturalLanguageDefinition """source of energy for an entity or the enabling signal providing permission for the entity to perform its function(s) is present and active.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PowerStateEnum_OFF
    a owl:NamedIndividual, mtc-cnstr:PowerStateEnum ;
    rdfs:label """OFF""" ;
    iof-av:naturalLanguageDefinition """source of energy for an entity or the enabling signal providing permission for the entity to perform its function(s) is not present or is disconnected.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ConditionStateEnum
    a owl:Class ;
    rdfs:label """condition state enum""" ;
    owl:oneOf ( mtc-cnstr:ConditionStateEnum_Normal mtc-cnstr:ConditionStateEnum_Warning mtc-cnstr:ConditionStateEnum_Fault ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ConditionStateEnum_Normal
    a owl:NamedIndividual, mtc-cnstr:ConditionStateEnum ;
    rdfs:label """Normal""" ;
    iof-av:naturalLanguageDefinition """condition state that indicates operation within specified limits.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ConditionStateEnum_Warning
    a owl:NamedIndividual, mtc-cnstr:ConditionStateEnum ;
    rdfs:label """Warning""" ;
    iof-av:naturalLanguageDefinition """condition state that requires concern and supervision and may become hazardous if no action is taken.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ConditionStateEnum_Fault
    a owl:NamedIndividual, mtc-cnstr:ConditionStateEnum ;
    rdfs:label """Fault""" ;
    iof-av:naturalLanguageDefinition """condition state that requires intervention to continue operation to function properly.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ToolLifeEnum
    a owl:Class ;
    rdfs:label """tool life enum""" ;
    owl:oneOf ( mtc-cnstr:ToolLifeEnum_MINUTES mtc-cnstr:ToolLifeEnum_PARTCOUNT mtc-cnstr:ToolLifeEnum_WEAR ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ToolLifeEnum_MINUTES
    a owl:NamedIndividual, mtc-cnstr:ToolLifeEnum ;
    rdfs:label """MINUTES""" ;
    iof-av:naturalLanguageDefinition """tool life measured in minutes. \n\nAll units for minimum, maximum, and nominal **MUST** be provided in minutes.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ToolLifeEnum_PARTCOUNT
    a owl:NamedIndividual, mtc-cnstr:ToolLifeEnum ;
    rdfs:label """PART_COUNT""" ;
    iof-av:naturalLanguageDefinition """tool life measured in parts. \n\nAll units for minimum, maximum, and nominal **MUST** be provided as the number of parts.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ToolLifeEnum_WEAR
    a owl:NamedIndividual, mtc-cnstr:ToolLifeEnum ;
    rdfs:label """WEAR""" ;
    iof-av:naturalLanguageDefinition """tool life measured in tool wear. \n\nWear **MUST** be provided in millimeters as an offset to nominal. All units for minimum, maximum, and nominal **MUST** be given as millimeter offsets as\nwell. The standard will only consider dimensional wear at this time.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:OperatingModeEnum
    a owl:Class ;
    rdfs:label """operating mode enum""" ;
    owl:oneOf ( mtc-cnstr:OperatingModeEnum_AUTOMATIC mtc-cnstr:OperatingModeEnum_MANUAL mtc-cnstr:OperatingModeEnum_SEMIAUTOMATIC ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:OperatingModeEnum_AUTOMATIC
    a owl:NamedIndividual, mtc-cnstr:OperatingModeEnum ;
    rdfs:label """AUTOMATIC""" ;
    iof-av:naturalLanguageDefinition """automatically execute instructions from a recipe or program.\n\n> Note: Setpoint comes from a recipe.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:OperatingModeEnum_MANUAL
    a owl:NamedIndividual, mtc-cnstr:OperatingModeEnum ;
    rdfs:label """MANUAL""" ;
    iof-av:naturalLanguageDefinition """execute instructions from an external agent or person.\n\n> Note 1 to entry: Valve or switch is manipulated by an agent/person.\n\n> Note 2 to entry: Direct control of the PID output. % of the range: A user manually sets the % output, not the setpoint.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:OperatingModeEnum_SEMIAUTOMATIC
    a owl:NamedIndividual, mtc-cnstr:OperatingModeEnum ;
    rdfs:label """SEMI_AUTOMATIC""" ;
    iof-av:naturalLanguageDefinition """executes a single instruction from a recipe or program.\n\n> Note 1 to entry: Setpoint is entered and fixed, but the PID is controlling.\n\n> Note 2 to entry: Still goes through the PID control system.\n\n> Note 3 to entry: Manual fixed entry from a recipe.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum
    a owl:Class ;
    rdfs:label """error code enum""" ;
    owl:oneOf ( mtc-cnstr:ErrorCodeEnum_ASSETNOTFOUND mtc-cnstr:ErrorCodeEnum_INTERNALERROR mtc-cnstr:ErrorCodeEnum_INVALIDREQUEST mtc-cnstr:ErrorCodeEnum_INVALIDURI mtc-cnstr:ErrorCodeEnum_INVALIDXPATH mtc-cnstr:ErrorCodeEnum_NODEVICE mtc-cnstr:ErrorCodeEnum_OUTOFRANGE mtc-cnstr:ErrorCodeEnum_QUERYERROR mtc-cnstr:ErrorCodeEnum_TOOMANY mtc-cnstr:ErrorCodeEnum_UNAUTHORIZED mtc-cnstr:ErrorCodeEnum_UNSUPPORTED ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_ASSETNOTFOUND
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """ASSET_NOT_FOUND""" ;
    iof-av:naturalLanguageDefinition """request for information specifies an Asset that is not recognized by the agent.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_INTERNALERROR
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """INTERNAL_ERROR""" ;
    iof-av:naturalLanguageDefinition """agent experienced an error while attempting to published the requested information.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_INVALIDREQUEST
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """INVALID_REQUEST""" ;
    iof-av:naturalLanguageDefinition """request contains information that was not recognized by the agent.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_INVALIDURI
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """INVALID_URI""" ;
    iof-av:naturalLanguageDefinition """URI provided was incorrect.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_INVALIDXPATH
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """INVALID_XPATH""" ;
    iof-av:naturalLanguageDefinition """XPath identified in the request for information could not be parsed correctly by the agent.\n\nThis could be caused by an invalid syntax or the XPath did not match a valid identify for any information stored in the agent. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_NODEVICE
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """NO_DEVICE""" ;
    iof-av:naturalLanguageDefinition """identity of the device specified in the request for information is not associated with the agent.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_OUTOFRANGE
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """OUT_OF_RANGE""" ;
    iof-av:naturalLanguageDefinition """request for information specifies streaming data that includes sequence number(s) for pieces of data that are beyond the end of the buffer.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_QUERYERROR
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """QUERY_ERROR""" ;
    iof-av:naturalLanguageDefinition """agent was unable to interpret the query.\n\nThe query parameters do not contain valid values or include an invalid parameter.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_TOOMANY
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """TOO_MANY""" ;
    iof-av:naturalLanguageDefinition """`count` parameter provided in the request for information requires either of the following:\n\n* streaming data that includes more pieces of data than the agent is capable of organizing in an MTConnectStreams Response Document. \n\n* Assets that include more Asset in an MTConnectAssets Response Document than the agent is capable of handling. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_UNAUTHORIZED
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """UNAUTHORIZED""" ;
    iof-av:naturalLanguageDefinition """requester does not have sufficient permissions to access the requested information.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ErrorCodeEnum_UNSUPPORTED
    a owl:NamedIndividual, mtc-cnstr:ErrorCodeEnum ;
    rdfs:label """UNSUPPORTED""" ;
    iof-av:naturalLanguageDefinition """valid request was provided, but the agent does not support the feature or type of request.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

