@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/DataTypes/>
    a owl:Ontology ;
    rdfs:label "data types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/DataTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:CoordinateSystemEnum
    a owl:Class ;
    rdfs:label """coordinate system enum""" ;
    owl:oneOf ( mtc-cnstr:CoordinateSystemEnum_MACHINE mtc-cnstr:CoordinateSystemEnum_WORK ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CoordinateSystemEnum_MACHINE
    a owl:NamedIndividual, mtc-cnstr:CoordinateSystemEnum ;
    rdfs:label """MACHINE""" ;
    iof-av:naturalLanguageDefinition """unchangeable coordinate system that has machine zero as its origin.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CoordinateSystemEnum_WORK
    a owl:NamedIndividual, mtc-cnstr:CoordinateSystemEnum ;
    rdfs:label """WORK""" ;
    iof-av:naturalLanguageDefinition """coordinate system that represents the working area for a particular workpiece whose origin is shifted within the `MACHINE` coordinate system.\n\nIf the `WORK` coordinates are not currently defined in the piece of equipment, the `MACHINE` coordinates will be used.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum
    a owl:Class ;
    rdfs:label """reset trigger enum""" ;
    owl:oneOf ( mtc-cnstr:ResetTriggerEnum_ACTIONCOMPLETE mtc-cnstr:ResetTriggerEnum_ANNUAL mtc-cnstr:ResetTriggerEnum_DAY mtc-cnstr:ResetTriggerEnum_LIFE mtc-cnstr:ResetTriggerEnum_MAINTENANCE mtc-cnstr:ResetTriggerEnum_MONTH mtc-cnstr:ResetTriggerEnum_POWERON mtc-cnstr:ResetTriggerEnum_SHIFT mtc-cnstr:ResetTriggerEnum_WEEK ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_ACTIONCOMPLETE
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """ACTION_COMPLETE""" ;
    iof-av:naturalLanguageDefinition """observation of the data item that is measuring an action or operation is to be reset upon completion of that action or operation.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_ANNUAL
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """ANNUAL""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is to be reset at the end of a 12-month period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_DAY
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """DAY""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is to be reset at the end of a 24-hour period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_LIFE
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """LIFE""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is not reset and accumulates for the entire life of the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_MAINTENANCE
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """MAINTENANCE""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is to be reset upon completion of a maintenance event.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_MONTH
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """MONTH""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is to be reset at the end of a monthly period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_POWERON
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """POWER_ON""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is to be reset when power was applied to the piece of equipment after a planned or unplanned interruption of power has occurred.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_SHIFT
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """SHIFT""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is to be reset at the end of a work shift.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:ResetTriggerEnum_WEEK
    a owl:NamedIndividual, mtc-cnstr:ResetTriggerEnum ;
    rdfs:label """WEEK""" ;
    iof-av:naturalLanguageDefinition """observation of the data item is to be reset at the end of a 7-day period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum
    a owl:Class ;
    rdfs:label """statistic enum""" ;
    owl:oneOf ( mtc-cnstr:StatisticEnum_AVERAGE mtc-cnstr:StatisticEnum_KURTOSIS mtc-cnstr:StatisticEnum_MAXIMUM mtc-cnstr:StatisticEnum_MEDIAN mtc-cnstr:StatisticEnum_MINIMUM mtc-cnstr:StatisticEnum_MODE mtc-cnstr:StatisticEnum_RANGE mtc-cnstr:StatisticEnum_ROOTMEANSQUARE mtc-cnstr:StatisticEnum_STANDARDDEVIATION ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_AVERAGE
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """AVERAGE""" ;
    iof-av:naturalLanguageDefinition """mathematical average value calculated for the data item during the calculation period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_KURTOSIS
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """KURTOSIS""" ;
    iof-av:naturalLanguageDefinition """**DEPRECATED** in *Version 1.6*. ~~A measure of the \"peakedness\" of a probability distribution; i.e., the shape of the distribution curve.~~""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_MAXIMUM
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """MAXIMUM""" ;
    iof-av:naturalLanguageDefinition """maximum or peak value recorded for the data item during the calculation period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_MEDIAN
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """MEDIAN""" ;
    iof-av:naturalLanguageDefinition """middle number of a series of numbers.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_MINIMUM
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """MINIMUM""" ;
    iof-av:naturalLanguageDefinition """minimum value recorded for the data item during the calculation period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_MODE
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """MODE""" ;
    iof-av:naturalLanguageDefinition """number in a series of numbers that occurs most often.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_RANGE
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """RANGE""" ;
    iof-av:naturalLanguageDefinition """difference between the maximum and minimum value of a data item during the calculation period. Also represents Peak-to-Peak measurement in a waveform.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_ROOTMEANSQUARE
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """ROOT_MEAN_SQUARE""" ;
    iof-av:naturalLanguageDefinition """mathematical Root Mean Square (RMS) value calculated for the data item during the calculation period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:StatisticEnum_STANDARDDEVIATION
    a owl:NamedIndividual, mtc-cnstr:StatisticEnum ;
    rdfs:label """STANDARD_DEVIATION""" ;
    iof-av:naturalLanguageDefinition """statistical Standard Deviation value calculated for the data item during the calculation period.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum
    a owl:Class ;
    rdfs:label """unit enum""" ;
    owl:oneOf ( mtc-cnstr:UnitEnum_AMPERE mtc-cnstr:UnitEnum_CELSIUS mtc-cnstr:UnitEnum_COUNT mtc-cnstr:UnitEnum_DECIBEL mtc-cnstr:UnitEnum_DEGREE mtc-cnstr:UnitEnum_DEGREE3D mtc-cnstr:UnitEnum_DEGREESECOND mtc-cnstr:UnitEnum_DEGREESECOND2 mtc-cnstr:UnitEnum_HERTZ mtc-cnstr:UnitEnum_JOULE mtc-cnstr:UnitEnum_KILOGRAM mtc-cnstr:UnitEnum_LITER mtc-cnstr:UnitEnum_LITERSECOND mtc-cnstr:UnitEnum_MICRORADIAN mtc-cnstr:UnitEnum_MILLIMETER mtc-cnstr:UnitEnum_MILLIMETER3D mtc-cnstr:UnitEnum_MILLIMETERREVOLUTION mtc-cnstr:UnitEnum_MILLIMETERSECOND mtc-cnstr:UnitEnum_MILLIMETERSECOND2 mtc-cnstr:UnitEnum_NEWTON mtc-cnstr:UnitEnum_NEWTONMETER mtc-cnstr:UnitEnum_OHM mtc-cnstr:UnitEnum_PASCAL mtc-cnstr:UnitEnum_PASCALSECOND mtc-cnstr:UnitEnum_PERCENT mtc-cnstr:UnitEnum_PH mtc-cnstr:UnitEnum_REVOLUTIONMINUTE mtc-cnstr:UnitEnum_SECOND mtc-cnstr:UnitEnum_SIEMENSMETER mtc-cnstr:UnitEnum_VOLT mtc-cnstr:UnitEnum_VOLTAMPERE mtc-cnstr:UnitEnum_VOLTAMPEREREACTIVE mtc-cnstr:UnitEnum_WATT mtc-cnstr:UnitEnum_WATTSECOND mtc-cnstr:UnitEnum_GRAMCUBICMETER mtc-cnstr:UnitEnum_CUBICMILLIMETER mtc-cnstr:UnitEnum_CUBICMILLIMETERSECOND mtc-cnstr:UnitEnum_CUBICMILLIMETERSECOND2 mtc-cnstr:UnitEnum_MILLIGRAM mtc-cnstr:UnitEnum_MILLIGRAMCUBICMILLIMETER mtc-cnstr:UnitEnum_MILLILITER mtc-cnstr:UnitEnum_COUNTSECOND mtc-cnstr:UnitEnum_PASCALSECOND mtc-cnstr:UnitEnum_UNITVECTOR3D mtc-cnstr:UnitEnum_REVOLUTIONSECOND2 mtc-cnstr:UnitEnum_REVOLUTIONSECOND mtc-cnstr:UnitEnum_GRAM mtc-cnstr:UnitEnum_METERSECOND2 mtc-cnstr:UnitEnum_COULOMB mtc-cnstr:UnitEnum_CUBICMETER mtc-cnstr:UnitEnum_SQUAREMILLIMETER mtc-cnstr:UnitEnum_OHMMETER mtc-cnstr:UnitEnum_MILLIGRAMLITER mtc-cnstr:UnitEnum_METER ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_AMPERE
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """AMPERE""" ;
    iof-av:naturalLanguageDefinition """electric current in ampere.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_CELSIUS
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """CELSIUS""" ;
    iof-av:naturalLanguageDefinition """temperature in degree Celsius.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_COUNT
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """COUNT""" ;
    iof-av:naturalLanguageDefinition """count of something.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_DECIBEL
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """DECIBEL""" ;
    iof-av:naturalLanguageDefinition """sound level in decibel.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_DEGREE
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """DEGREE""" ;
    iof-av:naturalLanguageDefinition """angle in degree.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_DEGREE3D
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """DEGREE_3D""" ;
    iof-av:naturalLanguageDefinition """space-delimited, floating-point representation of the angular rotation in degrees around the X, Y, and Z axes relative to a cartesian coordinate system respectively in order as A, B, and C. \n\nIf any of the rotations is not known, it **MUST** be zero (0).""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_DEGREESECOND
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """DEGREE/SECOND""" ;
    iof-av:naturalLanguageDefinition """angular velocity in degree per second.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_DEGREESECOND2
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """DEGREE/SECOND\\^2""" ;
    iof-av:naturalLanguageDefinition """angular acceleration in degree per second squared.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_HERTZ
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """HERTZ""" ;
    iof-av:naturalLanguageDefinition """frequency in cycles per second.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_JOULE
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """JOULE""" ;
    iof-av:naturalLanguageDefinition """energy in joule.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_KILOGRAM
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """KILOGRAM""" ;
    iof-av:naturalLanguageDefinition """mass in kilogram.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_LITER
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """LITER""" ;
    iof-av:naturalLanguageDefinition """volume in liter.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_LITERSECOND
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """LITER/SECOND""" ;
    iof-av:naturalLanguageDefinition """volumetric flow in liter per second.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_MICRORADIAN
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """MICRO_RADIAN""" ;
    iof-av:naturalLanguageDefinition """tilt in micro radian.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_MILLIMETER
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """MILLIMETER""" ;
    iof-av:naturalLanguageDefinition """length in millimeter.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_MILLIMETER3D
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """MILLIMETER_3D""" ;
    iof-av:naturalLanguageDefinition """point in space identified by X, Y, and Z positions and represented by a space-delimited set of numbers each expressed in millimeters.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_MILLIMETERREVOLUTION
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """MILLIMETER/REVOLUTION""" ;
    iof-av:naturalLanguageDefinition """feedrate per revolution in millimeter per revolution.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_MILLIMETERSECOND
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """MILLIMETER/SECOND""" ;
    iof-av:naturalLanguageDefinition """speed in millimeter per second.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_MILLIMETERSECOND2
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """MILLIMETER/SECOND\\^2""" ;
    iof-av:naturalLanguageDefinition """acceleration in millimeter per second squared.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_NEWTON
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """NEWTON""" ;
    iof-av:naturalLanguageDefinition """force in newton.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_NEWTONMETER
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """NEWTON_METER""" ;
    iof-av:naturalLanguageDefinition """torque in newton-meter.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_OHM
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """OHM""" ;
    iof-av:naturalLanguageDefinition """electrical resistance in ohm.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_PASCAL
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """PASCAL""" ;
    iof-av:naturalLanguageDefinition """pressure or stress in pascal.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_PASCALSECOND
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """PASCAL_SECOND""" ;
    iof-av:naturalLanguageDefinition """viscosity in pascal-second.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_PERCENT
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """PERCENT""" ;
    iof-av:naturalLanguageDefinition """amount in or for every hundred.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_PH
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """PH""" ;
    iof-av:naturalLanguageDefinition """acidity or alkalinity of a solution in pH.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_REVOLUTIONMINUTE
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """REVOLUTION/MINUTE""" ;
    iof-av:naturalLanguageDefinition """rotational velocity in revolution per minute.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_SECOND
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """SECOND""" ;
    iof-av:naturalLanguageDefinition """time in second.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_SIEMENSMETER
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """SIEMENS/METER""" ;
    iof-av:naturalLanguageDefinition """electrical conductivity in siemens per meter.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_VOLT
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """VOLT""" ;
    iof-av:naturalLanguageDefinition """electric potential, electric potential difference or electromotive force in volt.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_VOLTAMPERE
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """VOLT_AMPERE""" ;
    iof-av:naturalLanguageDefinition """apparent power in an electrical circuit, equal to the product of root-mean-square (RMS) voltage and RMS current (commonly referred to as VA) in volt-ampere.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_VOLTAMPEREREACTIVE
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """VOLT_AMPERE_REACTIVE""" ;
    iof-av:naturalLanguageDefinition """reactive power in an AC electrical circuit (commonly referred to as VAR) in volt-ampere-reactive.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_WATT
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """WATT""" ;
    iof-av:naturalLanguageDefinition """power in watt.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_WATTSECOND
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """WATT_SECOND""" ;
    iof-av:naturalLanguageDefinition """electrical energy in watt-second""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_GRAMCUBICMETER
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """GRAM/CUBIC_METER""" ;
    iof-av:naturalLanguageDefinition """density in gram per cubic meter.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_CUBICMILLIMETER
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """CUBIC_MILLIMETER""" ;
    iof-av:naturalLanguageDefinition """geometric volume in millimeter.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_CUBICMILLIMETERSECOND
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """CUBIC_MILLIMETER/SECOND""" ;
    iof-av:naturalLanguageDefinition """change of geometric volume per second.""" ;
