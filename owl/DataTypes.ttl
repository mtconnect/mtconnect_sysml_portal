mtc-cnstr:RotaryModeEnum_INDEX
    a owl:NamedIndividual, mtc-cnstr:RotaryModeEnum ;
    rdfs:label """INDEX""" ;
    iof-av:naturalLanguageDefinition """axis is configured to index.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:RotaryModeEnum_CONTOUR
    a owl:NamedIndividual, mtc-cnstr:RotaryModeEnum ;
    rdfs:label """CONTOUR""" ;
    iof-av:naturalLanguageDefinition """position of the axis is being interpolated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateSwitchedEnum
    a owl:Class ;
    rdfs:label """composition state switched enum""" ;
    owl:oneOf ( mtc-cnstr:CompositionStateSwitchedEnum_ON mtc-cnstr:CompositionStateSwitchedEnum_OFF ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:CompositionStateSwitchedEnum_ON
    a owl:NamedIndividual, mtc-cnstr:CompositionStateSwitchedEnum ;
    rdfs:label """ON""" ;
