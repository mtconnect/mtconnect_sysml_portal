mtc-cnstr:CompositionTypeEnum_ACTUATOR
    a owl:NamedIndividual, mtc-cnstr:CompositionTypeEnum ;
    rdfs:label """ACTUATOR""" ;
    iof-av:naturalLanguageDefinition """composition composed of a mechanism that moves or controls a mechanical part of a piece of equipment.\n\nIt takes energy usually provided by air, electric current, or liquid and converts the energy into some kind of motion. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

