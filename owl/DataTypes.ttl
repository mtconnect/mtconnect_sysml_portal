    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:InterfaceStateEnum_ENABLED
    a owl:NamedIndividual, mtc-cnstr:InterfaceStateEnum ;
