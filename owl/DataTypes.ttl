mtc-cnstr:UnitEnum_CUBICMILLIMETERSECOND2
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """CUBIC_MILLIMETER/SECOND\\^2""" ;
    iof-av:naturalLanguageDefinition """change in geometric volume per second squared.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:UnitEnum_MILLIGRAM
    a owl:NamedIndividual, mtc-cnstr:UnitEnum ;
    rdfs:label """MILLIGRAM""" ;
    iof-av:naturalLanguageDefinition """mass in milligram.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

