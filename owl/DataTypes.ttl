    a owl:NamedIndividual, mtc-cnstr:MaintenanceListDirectionEnum ;
    rdfs:label """DOWN""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

