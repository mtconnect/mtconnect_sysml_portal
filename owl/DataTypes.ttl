    owl:oneOf ( mtc-cnstr:MaintenanceListIntervalEnum_ABSOLUTE mtc-cnstr:MaintenanceListIntervalEnum_INCREMENTAL ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:MaintenanceListIntervalEnum_ABSOLUTE
    a owl:NamedIndividual, mtc-cnstr:MaintenanceListIntervalEnum ;
    rdfs:label """ABSOLUTE""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:MaintenanceListIntervalEnum_INCREMENTAL
    a owl:NamedIndividual, mtc-cnstr:MaintenanceListIntervalEnum ;
    rdfs:label """INCREMENTAL""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartCountTypeEnum
    a owl:Class ;
    rdfs:label """part count type enum""" ;
    owl:oneOf ( mtc-cnstr:PartCountTypeEnum_EACH mtc-cnstr:PartCountTypeEnum_BATCH ) ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartCountTypeEnum_EACH
    a owl:NamedIndividual, mtc-cnstr:PartCountTypeEnum ;
    rdfs:label """EACH""" ;
    iof-av:naturalLanguageDefinition """count is of individual items.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:PartCountTypeEnum_BATCH
    a owl:NamedIndividual, mtc-cnstr:PartCountTypeEnum ;
    rdfs:label """BATCH""" ;
    iof-av:naturalLanguageDefinition """pre-specified group of items.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/DataTypes/> .

mtc-cnstr:AlarmSeverityEnum
