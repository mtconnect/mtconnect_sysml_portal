            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:LocationSpatialGeographicResult ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:PartIndex
    a owl:Class ;
