    skos:altLabel """EquipmentMode.Powered""" ;
    iof-av:directSource """MTConnect Event EquipmentMode.Powered""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentMode ;
    iof-av:naturalLanguageDefinition """indication that primary power is applied to the piece of equipment and, as a minimum, the controller or logic portion of the piece of equipment is powered and functioning or components that are required to remain on are\npowered.\n\nExample: Heaters for an extrusion machine that required to be powered even when the equipment is turned off.""" ;
    owl:equivalentClass [ a owl:Class ;
