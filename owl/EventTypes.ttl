    rdfs:label """asset count""" ;
    skos:altLabel """AssetCount""" ;
    iof-av:directSource """MTConnect Event AssetCount""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """data set of the number of Assets of a given type for a Device.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_ASSETCOUNT ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/PerformanceIndicator> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResultValue ; owl:someValuesFrom xsd:integer ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:MaintenanceList
    a owl:Class ;
    rdfs:label """maintenance list""" ;
    skos:altLabel """MaintenanceList""" ;
    iof-av:directSource """MTConnect Event MaintenanceList""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/MaintenanceStrategy> ;
    iof-av:naturalLanguageDefinition """actions or activities to be performed in support of a piece of equipment.\n\nIf MaintenanceList::result::MaintenanceList::result::Interval `key` is not provided, it is assumed `ABSOLUTE`.\n\nIf MaintenanceList::result::MaintenanceList::result::Direction `key` is not provided, it is assumed `UP`.\n\nIf MaintenanceList::result::MaintenanceList::result::Units `key` is not provided, it is assumed to be `COUNT`.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_MAINTENANCELIST ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:MaintenanceListResult ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

