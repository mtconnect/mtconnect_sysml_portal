        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:SensorStateDetectMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:SensorStateDetectMaterialState ] ) ] ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:someValuesFrom mtc-cnstr:SensorStateDetectEnum ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:CompositionStateSwitchedEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

