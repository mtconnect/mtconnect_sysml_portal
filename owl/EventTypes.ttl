            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:CompositionStateLateralEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:CompositionStateMotion
    a owl:Class ;
    rdfs:label """composition state motion""" ;
    skos:altLabel """CompositionState.Motion""" ;
    iof-av:directSource """MTConnect Event CompositionState.Motion""" ;
    rdfs:subClassOf mtc-cnstr:CompositionState ;
    iof-av:naturalLanguageDefinition """indication of the open or closed state of a mechanism.\n""" ;
