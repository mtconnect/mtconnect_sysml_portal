mtc-cnstr:ControllerModeOverrideDryRun
    a owl:Class ;
    rdfs:label """controller mode override dry run""" ;
    skos:altLabel """ControllerModeOverride.DryRun""" ;
    iof-av:directSource """MTConnect Event ControllerModeOverride.DryRun""" ;
    rdfs:subClassOf mtc-cnstr:ControllerModeOverride ;
    iof-av:naturalLanguageDefinition """setting or operator selection used to execute a test mode to confirm the execution of machine functions. \n\nWhen `DRY_RUN` is `ON`, the equipment performs all of its normal functions, except no part or product is produced.  If the equipment has a spindle, spindle operation is suspended.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ControllerModeOverride
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_DRYRUN ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000023> ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideSingleBlock
    a owl:Class ;
    rdfs:label """controller mode override single block""" ;
    skos:altLabel """ControllerModeOverride.SingleBlock""" ;
    iof-av:directSource """MTConnect Event ControllerModeOverride.SingleBlock""" ;
    rdfs:subClassOf mtc-cnstr:ControllerModeOverride ;
    iof-av:naturalLanguageDefinition """setting or operator selection that changes the behavior of the controller on a piece of equipment. \n\nProgram execution is paused after each block of code is executed when `SINGLE_BLOCK` is `ON`.   \n\nWhen `SINGLE_BLOCK` is `ON`, execution **MUST** change to `INTERRUPTED` after completion of each block of code. """ ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ControllerModeOverride
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_SINGLEBLOCK ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideMachineAxisLock
    a owl:Class ;
    rdfs:label """controller mode override machine axis lock""" ;
    skos:altLabel """ControllerModeOverride.MachineAxisLock""" ;
    iof-av:directSource """MTConnect Event ControllerModeOverride.MachineAxisLock""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ProcessParameterSpecification> ;
    iof-av:naturalLanguageDefinition """setting or operator selection that changes the behavior of the controller on a piece of equipment. \n \nWhen `MACHINE_AXIS_LOCK` is `ON`, program execution continues normally, but no equipment motion occurs.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ControllerModeOverride
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_MACHINEAXISLOCK ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000017> ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideOptionalStop
    a owl:Class ;
    rdfs:label """controller mode override optional stop""" ;
    skos:altLabel """ControllerModeOverride.OptionalStop""" ;
    iof-av:directSource """MTConnect Event ControllerModeOverride.OptionalStop""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ProcessParameterSpecification> ;
    iof-av:naturalLanguageDefinition """setting or operator selection that changes the behavior of the controller on a piece of equipment. \n\nThe program execution is stopped after a specific program block is executed when `OPTIONAL_STOP` is `ON`.    \n\nIn the case of a G-Code program, a program block containing a M01 code designates the command for an `OPTIONAL_STOP`. \n\nexecution **MUST** change to `OPTIONAL_STOP` after a program block specifying an optional stop is executed and the controller mode override `OPTIONAL_STOP` selection is `ON`.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ControllerModeOverride
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_OPTIONALSTOP ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000016> ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideToolChangeStop
    a owl:Class ;
    rdfs:label """controller mode override tool change stop""" ;
    skos:altLabel """ControllerModeOverride.ToolChangeStop""" ;
    iof-av:directSource """MTConnect Event ControllerModeOverride.ToolChangeStop""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/ProcessParameterSpecification> ;
    iof-av:naturalLanguageDefinition """setting or operator selection that changes the behavior of the controller on a piece of equipment.  \n\nProgram execution is paused when a command is executed requesting a cutting tool to be changed. \n\nexecution **MUST** change to `INTERRUPTED` after completion of the command requesting a cutting tool to be changed and `TOOL_CHANGE_STOP` is `ON`.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ControllerModeOverride
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_TOOLCHANGESTOP ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000017> ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

