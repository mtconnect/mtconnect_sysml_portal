    iof-av:directSource """MTConnect Event ChuckInterlock""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """state of an interlock function or control logic state intended to prevent the associated chuck component from being operated.""" ;
    owl:equivalentClass [ a owl:Class ;
