            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:CompositionStateSwitchedEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:CompositionStateVertical
    a owl:Class ;
    rdfs:label """composition state vertical""" ;
    skos:altLabel """CompositionState.Vertical""" ;
    iof-av:directSource """MTConnect Event CompositionState.Vertical""" ;
    rdfs:subClassOf mtc-cnstr:CompositionState ;
    iof-av:naturalLanguageDefinition """indication of the position of a mechanism that may move in a vertical direction.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
