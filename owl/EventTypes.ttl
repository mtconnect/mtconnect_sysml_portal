mtc-cnstr:hasAssetTypeValue
    a owl:DatatypeProperty ;
    rdfs:label """has asset type value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """type of {{block(Asset)}} changed. See {{package(Asset Information Model)}} for details on the {{block(Asset)}} model.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hasCode
    a owl:ObjectProperty ;
    rdfs:label """has code""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range mtc-cnstr:AlarmCodeEnum ;
    iof-av:naturalLanguageDefinition """type of alarm.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hasHashValue
    a owl:DatatypeProperty ;
    rdfs:label """has hash value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """condensed message digest from a secure one-way hash function. {{cite(FIPS PUB 180-4)}}""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hasLangValue
    a owl:DatatypeProperty ;
    rdfs:label """has lang value""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """specifies the language of the alarm text.\n\nSee {{cite(IETF RFC 4646)}} (http://www.ietf.org/rfc/rfc4646.txt).""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hasResult
    a owl:ObjectProperty ;
    rdfs:label """has result""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hasResultValue
    a owl:DatatypeProperty ;
    rdfs:label """has result value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range rdfs:Literal ;
    iof-av:naturalLanguageDefinition """{{term(observation)}} of the {{block(Observation)}} entity.\n\nThe default value type for {{property(Observation::result)}} is `string`.\n\n> Note 1 to entry: in {{term(XML)}} the {{property(Observation::result)}} is the `CDATA` of the Observation {{term(element)}}.\n\n~~~~xml\n<Execution dataItemId=\"...\" ...>READY</Execution>\n~~~~\n\n> Note 2 to entry: in {{term(JSON)}} the {{property(Observation::result)}} is the member `value` of the Observation object.\n\n~~~~json\n\"Execution\" : [ { \"dataItemId\": \"...\" ..., \"value\": \"READY\" } ]\n~~~~""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hasSeverity
    a owl:ObjectProperty ;
    rdfs:label """has severity""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range mtc-cnstr:AlarmSeverityEnum ;
    iof-av:naturalLanguageDefinition """severity of the alarm.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

