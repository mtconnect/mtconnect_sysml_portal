mtc-cnstr:ControllerModeOverride
    a owl:Class ;
    rdfs:label """controller mode override""" ;
    skos:altLabel """ControllerModeOverride""" ;
    iof-av:directSource """MTConnect Event ControllerModeOverride""" ;
