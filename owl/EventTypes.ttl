mtc-cnstr:AssociatedAssetId
    a owl:Class ;
    rdfs:label """associated asset id""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """Asset::Asset::assetId of the Assets associated with a component.\n\nIf defined as a DataSet or Table:\n\n* `key` **MUST** be an Asset type. Examples: CuttingTool, Fixture, File.\n\n* `value` **MUST** be the corresponding Asset::assetId.""" ;
