    iof-av:directSource """MTConnect Event EquipmentMode.Loaded""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentMode ;
    iof-av:naturalLanguageDefinition """indication that the sub-parts of a piece of equipment are under load.\n\nExample: For traditional machine tools, this is an indication that the cutting tool is assumed to be engaged with the part.""" ;
    owl:equivalentClass [ a owl:Class ;
