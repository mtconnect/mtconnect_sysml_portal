    a owl:Class ;
    rdfs:label """composition state""" ;
    skos:altLabel """CompositionState""" ;
    iof-av:directSource """MTConnect Event CompositionState""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """operating state of a mechanism represented by a composition entity.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_COMPOSITIONSTATE ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:CompositionStateAction
    a owl:Class ;
    rdfs:label """composition state action""" ;
    skos:altLabel """CompositionState.Action""" ;
    iof-av:directSource """MTConnect Event CompositionState.Action""" ;
    rdfs:subClassOf mtc-cnstr:CompositionState ;
    iof-av:naturalLanguageDefinition """indication of the operating state of a mechanism.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:CompositionState
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_ACTION ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Event> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:CompositionStateActionEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:CompositionStateLateral
    a owl:Class ;
    rdfs:label """composition state lateral""" ;
    skos:altLabel """CompositionState.Lateral""" ;
    iof-av:directSource """MTConnect Event CompositionState.Lateral""" ;
    rdfs:subClassOf mtc-cnstr:CompositionState ;
    iof-av:naturalLanguageDefinition """indication of the position of a mechanism that may move in a lateral direction.   """ ;
