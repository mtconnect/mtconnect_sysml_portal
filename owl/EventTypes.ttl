            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:ControllerModeOverrideMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:ControllerModeOverrideMaterialState ] ) ] ]
