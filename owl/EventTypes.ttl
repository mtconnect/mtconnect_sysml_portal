@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/EventTypes/>
    a owl:Ontology ;
    rdfs:label "event types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/EventTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ActiveAxes
    a owl:Class ;
    rdfs:label """active axes""" ;
    skos:altLabel """ActiveAxes""" ;
    iof-av:directSource """MTConnect Event ActiveAxes""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """set of axes currently associated with a path or controller.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_ACTIVEAXES ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/Collection> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResultValue ; owl:someValuesFrom xsd:string ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ActuatorState
    a owl:Class ;
    rdfs:label """actuator state""" ;
    skos:altLabel """ActuatorState""" ;
    iof-av:directSource """MTConnect Event ActuatorState""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """operational state of an apparatus for moving or controlling a mechanism or system.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_ACTUATORSTATE ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:ActuatorStateEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:Alarm
    a owl:Class ;
    rdfs:label """alarm""" ;
    skos:altLabel """Alarm""" ;
    iof-av:directSource """MTConnect Event Alarm""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """**DEPRECATED:** Replaced with `CONDITION` category data items in Version 1.1.0.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_ALARM ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasCode ; owl:someValuesFrom mtc-cnstr:AlarmCodeEnum ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSeverity ; owl:someValuesFrom mtc-cnstr:AlarmSeverityEnum ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasNativeCodeValue ; owl:someValuesFrom xsd:string ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasState ; owl:someValuesFrom mtc-cnstr:AlarmStateEnum ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasLangValue ; owl:someValuesFrom xsd:string ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AssetChanged
    a owl:Class ;
    rdfs:label """asset changed""" ;
    skos:altLabel """AssetChanged""" ;
    iof-av:directSource """MTConnect Event AssetChanged""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """Asset::Asset::assetId of the Asset that has been changed.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_ASSETCHANGED ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasAssetTypeValue ; owl:someValuesFrom xsd:string ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasHashValue ; owl:someValuesFrom xsd:string ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AssetRemoved
    a owl:Class ;
    rdfs:label """asset removed""" ;
    skos:altLabel """AssetRemoved""" ;
    iof-av:directSource """MTConnect Event AssetRemoved""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """Asset::Asset::assetId of the Asset that has been removed.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_ASSETREMOVED ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasAssetTypeValue ; owl:someValuesFrom xsd:string ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasHashValue ; owl:someValuesFrom xsd:string ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:Availability
    a owl:Class ;
    rdfs:label """availability""" ;
    skos:altLabel """Availability""" ;
    iof-av:directSource """MTConnect Event Availability""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """agent's ability to communicate with the data source.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_AVAILABILITY ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/AgentialCapability> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:AvailabilityEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisCoupling
    a owl:Class ;
    rdfs:label """axis coupling""" ;
    skos:altLabel """AxisCoupling""" ;
    iof-av:directSource """MTConnect Event AxisCoupling""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """describes the way the axes will be associated to each other. \n  \nThis is used in conjunction with `COUPLED_AXES` to indicate the way they are interacting.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_AXISCOUPLING ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000145> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:AxisCouplingEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideEvent
    a owl:Class ;
    rdfs:label """axis feedrate override""" ;
    skos:altLabel """AxisFeedrateOverride""" ;
    iof-av:directSource """MTConnect Event AxisFeedrateOverride""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """value of a signal or calculation issued to adjust the feedrate of an individual linear type axis.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_AXISFEEDRATEOVERRIDE ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResultValue ; owl:someValuesFrom xsd:float ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideJog
    a owl:Class ;
    rdfs:label """axis feedrate override jog""" ;
    skos:altLabel """AxisFeedrateOverride.Jog""" ;
    iof-av:directSource """MTConnect Event AxisFeedrateOverride.Jog""" ;
    rdfs:subClassOf mtc-cnstr:AxisFeedrateOverrideEvent ;
    iof-av:naturalLanguageDefinition """relating to momentary activation of a function or a movement.\n\n**DEPRECATION WARNING**: May be deprecated in the future.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:AxisFeedrateOverrideEvent
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_JOG ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideProgrammed
    a owl:Class ;
    rdfs:label """axis feedrate override programmed""" ;
    skos:altLabel """AxisFeedrateOverride.Programmed""" ;
    iof-av:directSource """MTConnect Event AxisFeedrateOverride.Programmed""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/SetpointValueExpression> ;
    iof-av:naturalLanguageDefinition """directive value without offsets and adjustments.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:AxisFeedrateOverrideEvent
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_PROGRAMMED ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ProcessParameter> ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideRapid
    a owl:Class ;
    rdfs:label """axis feedrate override rapid""" ;
    skos:altLabel """AxisFeedrateOverride.Rapid""" ;
    iof-av:directSource """MTConnect Event AxisFeedrateOverride.Rapid""" ;
    rdfs:subClassOf mtc-cnstr:AxisFeedrateOverrideEvent ;
    iof-av:naturalLanguageDefinition """performing an operation faster or in less time than nominal rate.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:AxisFeedrateOverrideEvent
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_RAPID ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisInterlock
    a owl:Class ;
    rdfs:label """axis interlock""" ;
    skos:altLabel """AxisInterlock""" ;
    iof-av:directSource """MTConnect Event AxisInterlock""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """state of the axis lockout function when power has been removed and the axis is allowed to move freely.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_AXISINTERLOCK ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:AxisInterlockEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisState
    a owl:Class ;
    rdfs:label """axis state""" ;
    skos:altLabel """AxisState""" ;
    iof-av:directSource """MTConnect Event AxisState""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """state of a linear or rotary component representing an axis.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_AXISSTATE ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:AxisStateEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:Block
    a owl:Class ;
    rdfs:label """block""" ;
    skos:altLabel """Block""" ;
    iof-av:directSource """MTConnect Event Block""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """line of code or command being executed by a controller entity.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_BLOCK ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:BlockCount
    a owl:Class ;
    rdfs:label """block count""" ;
    skos:altLabel """BlockCount""" ;
    iof-av:directSource """MTConnect Event BlockCount""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """total count of the number of blocks of program code that have been executed since execution started.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_BLOCKCOUNT ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/PerformanceIndicator> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResultValue ; owl:someValuesFrom xsd:integer ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ChuckInterlock
    a owl:Class ;
    rdfs:label """chuck interlock""" ;
    skos:altLabel """ChuckInterlock""" ;
    iof-av:directSource """MTConnect Event ChuckInterlock""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """state of an interlock function or control logic state intended to prevent the associated chuck component from being operated.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_CHUCKINTERLOCK ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:ChuckInterlockEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ChuckInterlockManualUnclamp
    a owl:Class ;
    rdfs:label """chuck interlock manual unclamp""" ;
    skos:altLabel """ChuckInterlock.ManualUnclamp""" ;
    iof-av:directSource """MTConnect Event ChuckInterlock.ManualUnclamp""" ;
    rdfs:subClassOf mtc-cnstr:ChuckInterlock ;
    iof-av:naturalLanguageDefinition """indication of the state of an operator controlled interlock that can inhibit the ability to initiate an unclamp action of an electronically controlled chuck.\n\nWhen ChuckInterlockManualUnclamp is `ACTIVE`, it is expected that a chuck cannot be unclamped until ChuckInterlockManualUnclamp is set to `INACTIVE`. """ ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ChuckInterlock
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_MANUALUNCLAMP ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000017> ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ChuckState
    a owl:Class ;
    rdfs:label """chuck state""" ;
    skos:altLabel """ChuckState""" ;
    iof-av:directSource """MTConnect Event ChuckState""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """operating state of a mechanism that holds a part or stock material during a manufacturing process. \n\nIt may also represent a mechanism that holds any other mechanism in place within a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_CHUCKSTATE ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:ChuckStateEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:Code
    a owl:Class ;
    rdfs:label """code""" ;
    skos:altLabel """Code""" ;
    iof-av:directSource """MTConnect Event Code""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    iof-av:naturalLanguageDefinition """programmatic code being executed.\n\n**DEPRECATED** in *Version 1.1*.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:EventObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:EventEnum_CODE ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ComputingProcess> ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

