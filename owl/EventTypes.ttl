            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasSubType ; owl:hasValue mtc-cnstr:DataItemSubTypeEnum_MOTION ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Event> ]
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasResult ; owl:someValuesFrom mtc-cnstr:CompositionStateMotionEnum ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:CompositionStateSwitched
    a owl:Class ;
    rdfs:label """composition state switched""" ;
    skos:altLabel """CompositionState.Switched""" ;
    iof-av:directSource """MTConnect Event CompositionState.Switched""" ;
    rdfs:subClassOf mtc-cnstr:CompositionState ;
    iof-av:naturalLanguageDefinition """indication of the activation state of a mechanism.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
