    skos:altLabel """EquipmentMode.Working""" ;
    iof-av:directSource """MTConnect Event EquipmentMode.Working""" ;
    rdfs:subClassOf mtc-cnstr:EquipmentMode ;
    iof-av:naturalLanguageDefinition """indication that a piece of equipment is performing any activity, the equipment is active and performing a function under load or not.\n\nExample: For traditional machine tools, this includes when the piece of equipment is `LOADED`, making rapid moves, executing a tool change, etc.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
