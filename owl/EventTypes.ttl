mtc-cnstr:ControllerModeOverrideDryRun
    a owl:Class ;
    rdfs:label """controller mode override dry run""" ;
    rdfs:subClassOf mtc-cnstr:ControllerModeOverride ;
    skos:definition """setting or operator selection used to execute a test mode to confirm the execution of machine functions. \n\nWhen `DRY_RUN` is `ON`, the equipment performs all of its normal functions, except no part or product is produced.  If the equipment has a spindle, spindle operation is suspended.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000023> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:ControllerModeOverrideDryRun ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideSingleBlock
    a owl:Class ;
    rdfs:label """controller mode override single block""" ;
    rdfs:subClassOf mtc-cnstr:ControllerModeOverride ;
    skos:definition """setting or operator selection that changes the behavior of the controller on a piece of equipment. \n\nProgram execution is paused after each block of code is executed when `SINGLE_BLOCK` is `ON`.   \n\nWhen `SINGLE_BLOCK` is `ON`, execution **MUST** change to `INTERRUPTED` after completion of each block of code. """ ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:ControllerModeOverrideSingleBlock ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideMachineAxisLock
    a owl:Class ;
    rdfs:label """controller mode override machine axis lock""" ;
    rdfs:subClassOf mtc-cnstr:ControllerModeOverride ;
    skos:definition """setting or operator selection that changes the behavior of the controller on a piece of equipment. \n \nWhen `MACHINE_AXIS_LOCK` is `ON`, program execution continues normally, but no equipment motion occurs.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/ProcessParameterSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:ControllerModeOverrideMachineAxisLock ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideOptionalStop
    a owl:Class ;
    rdfs:label """controller mode override optional stop""" ;
    rdfs:subClassOf mtc-cnstr:ControllerModeOverride ;
    skos:definition """setting or operator selection that changes the behavior of the controller on a piece of equipment. \n\nThe program execution is stopped after a specific program block is executed when `OPTIONAL_STOP` is `ON`.    \n\nIn the case of a G-Code program, a program block containing a M01 code designates the command for an `OPTIONAL_STOP`. \n\nexecution **MUST** change to `OPTIONAL_STOP` after a program block specifying an optional stop is executed and the controller mode override `OPTIONAL_STOP` selection is `ON`.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/ProcessParameterSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:ControllerModeOverrideOptionalStop ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ControllerModeOverrideToolChangeStop
    a owl:Class ;
    rdfs:label """controller mode override tool change stop""" ;
    rdfs:subClassOf mtc-cnstr:ControllerModeOverride ;
    skos:definition """setting or operator selection that changes the behavior of the controller on a piece of equipment.  \n\nProgram execution is paused when a command is executed requesting a cutting tool to be changed. \n\nexecution **MUST** change to `INTERRUPTED` after completion of the command requesting a cutting tool to be changed and `TOOL_CHANGE_STOP` is `ON`.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/ProcessParameterSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:ControllerModeOverrideToolChangeStop ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

