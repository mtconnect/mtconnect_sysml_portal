@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/EventTypes/>
    a owl:Ontology ;
    rdfs:label "event types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/EventTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ActiveAxes
    a owl:Class ;
    rdfs:label """active axes""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """set of axes currently associated with a path or controller.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/Collection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:ActiveAxes ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:ActiveAxes ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ActuatorState
    a owl:Class ;
    rdfs:label """actuator state""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """operational state of an apparatus for moving or controlling a mechanism or system.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom mtc-cnstr:ActuatorStateEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:ActuatorState ;
    rdfs:range mtc-cnstr:ActuatorStateEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:ActuatorState ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:Alarm
    a owl:Class ;
    rdfs:label """alarm""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """**DEPRECATED:** Replaced with `CONDITION` category data items in Version 1.1.0.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:code ;
                      owl:someValuesFrom mtc-cnstr:AlarmCodeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:severity ;
                      owl:someValuesFrom mtc-cnstr:AlarmSeverityEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:nativeCode ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:state ;
                      owl:someValuesFrom mtc-cnstr:AlarmStateEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:lang ;
                      owl:someValuesFrom xsd:xslang ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:code
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:code""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range mtc-cnstr:AlarmCodeEnum ;
    skos:definition """type of alarm.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:severity
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:severity""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range mtc-cnstr:AlarmSeverityEnum ;
    skos:definition """severity of the alarm.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:nativeCode
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:nativeCode""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range xsd:string ;
    skos:definition """native code for the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:state
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:state""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range mtc-cnstr:AlarmStateEnum ;
    skos:definition """state of the alarm.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:lang
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:lang""" ;
    rdfs:domain mtc-cnstr:Alarm ;
    rdfs:range xsd:xslang ;
    skos:definition """specifies the language of the alarm text.\n\nSee {{cite(IETF RFC 4646)}} (http://www.ietf.org/rfc/rfc4646.txt).""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AssetChanged
    a owl:Class ;
    rdfs:label """asset changed""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """Asset::Asset::assetId of the Asset that has been changed.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:assetType ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hash ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:assetType
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:assetType""" ;
    rdfs:domain mtc-cnstr:AssetChanged ;
    rdfs:range xsd:string ;
    skos:definition """type of {{block(Asset)}} changed. See {{package(Asset Information Model)}} for details on the {{block(Asset)}} model.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:AssetChanged ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hash
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:hash""" ;
    rdfs:domain mtc-cnstr:AssetChanged ;
    rdfs:range xsd:string ;
    skos:definition """condensed message digest from a secure one-way hash function. {{cite(FIPS PUB 180-4)}}""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AssetRemoved
    a owl:Class ;
    rdfs:label """asset removed""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """Asset::Asset::assetId of the Asset that has been removed.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:assetType ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hash ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:assetType
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:assetType""" ;
    rdfs:domain mtc-cnstr:AssetRemoved ;
    rdfs:range xsd:string ;
    skos:definition """type of {{block(Asset)}} removed. See {{package(Asset Information Model)}} for details on the {{block(Asset)}} model.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:AssetRemoved ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:hash
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:hash""" ;
    rdfs:domain mtc-cnstr:AssetRemoved ;
    rdfs:range xsd:string ;
    skos:definition """condensed message digest from a secure one-way hash function. {{cite(FIPS PUB 180-4)}}""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:Availability
    a owl:Class ;
    rdfs:label """availability""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """agent's ability to communicate with the data source.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/AgentialCapability> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom mtc-cnstr:AvailabilityEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:Availability ;
    rdfs:range mtc-cnstr:AvailabilityEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:Availability ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisCoupling
    a owl:Class ;
    rdfs:label """axis coupling""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """describes the way the axes will be associated to each other. \n  \nThis is used in conjunction with `COUPLED_AXES` to indicate the way they are interacting.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000145> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom mtc-cnstr:AxisCouplingEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:AxisCoupling ;
    rdfs:range mtc-cnstr:AxisCouplingEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:AxisCoupling ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideEvent
    a owl:Class ;
    rdfs:label """axis feedrate override""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """value of a signal or calculation issued to adjust the feedrate of an individual linear type axis.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:AxisFeedrateOverrideEvent ;
    rdfs:range xsd:float ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:AxisFeedrateOverrideEvent ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideJog
    a owl:Class ;
    rdfs:label """axis feedrate override jog""" ;
    rdfs:subClassOf mtc-cnstr:AxisFeedrateOverrideEvent ;
    skos:definition """relating to momentary activation of a function or a movement.\n\n**DEPRECATION WARNING**: May be deprecated in the future.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:AxisFeedrateOverrideJog ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideProgrammed
    a owl:Class ;
    rdfs:label """axis feedrate override programmed""" ;
    rdfs:subClassOf mtc-cnstr:AxisFeedrateOverrideEvent ;
    skos:definition """directive value without offsets and adjustments.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/SetpointValueExpression> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ProcessParameter> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:AxisFeedrateOverrideProgrammed ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisFeedrateOverrideRapid
    a owl:Class ;
    rdfs:label """axis feedrate override rapid""" ;
    rdfs:subClassOf mtc-cnstr:AxisFeedrateOverrideEvent ;
    skos:definition """performing an operation faster or in less time than nominal rate.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:AxisFeedrateOverrideRapid ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisInterlock
    a owl:Class ;
    rdfs:label """axis interlock""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """state of the axis lockout function when power has been removed and the axis is allowed to move freely.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom mtc-cnstr:AxisInterlockEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:AxisInterlock ;
    rdfs:range mtc-cnstr:AxisInterlockEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:AxisInterlock ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:AxisState
    a owl:Class ;
    rdfs:label """axis state""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """state of a linear or rotary component representing an axis.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom mtc-cnstr:AxisStateEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:AxisState ;
    rdfs:range mtc-cnstr:AxisStateEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:AxisState ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:Block
    a owl:Class ;
    rdfs:label """block""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """line of code or command being executed by a controller entity.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:Block ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:BlockCount
    a owl:Class ;
    rdfs:label """block count""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """total count of the number of blocks of program code that have been executed since execution started.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/PerformanceIndicator> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:DatatypeProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:BlockCount ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:BlockCount ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ChuckInterlock
    a owl:Class ;
    rdfs:label """chuck interlock""" ;
    rdfs:subClassOf mtc-cnstr:EventObservation ;
    skos:definition """state of an interlock function or control logic state intended to prevent the associated chuck component from being operated.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:result ;
                      owl:someValuesFrom mtc-cnstr:ChuckInterlockEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:type ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:result
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:result""" ;
    rdfs:domain mtc-cnstr:ChuckInterlock ;
    rdfs:range mtc-cnstr:ChuckInterlockEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:type
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:type""" ;
    rdfs:domain mtc-cnstr:ChuckInterlock ;
    rdfs:range mtc-cnstr:EventEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:ChuckInterlockManualUnclamp
    a owl:Class ;
    rdfs:label """chuck interlock manual unclamp""" ;
    rdfs:subClassOf mtc-cnstr:ChuckInterlock ;
    skos:definition """indication of the state of an operator controlled interlock that can inhibit the ability to initiate an unclamp action of an electronically controlled chuck.\n\nWhen ChuckInterlockManualUnclamp is `ACTIVE`, it is expected that a chuck cannot be unclamped until ChuckInterlockManualUnclamp is set to `INACTIVE`. """ ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000017> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:subType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

mtc-cnstr:subType
    a owl:ObjectProperty ;
    rdfs:label """mtc-cnstr:subType""" ;
    rdfs:domain mtc-cnstr:ChuckInterlockManualUnclamp ;
    rdfs:range mtc-cnstr:DataItemSubTypeEnum ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/EventTypes/> .

