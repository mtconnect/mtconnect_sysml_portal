@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/>
    a owl:Ontology ;
    rdfs:label "observation information model" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/ObservationInformationModel/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:DeviceStream
    a owl:Class ;
    rdfs:label """device stream""" ;
    skos:altLabel """DeviceStream""" ;
    iof-av:directSource """MTConnect DeviceStream""" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Arrangement> ;
    iof-av:naturalLanguageDefinition """organizes data reported from a device.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUuidValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasComponentStream ;
                      owl:someValuesFrom mtc-cnstr:ComponentStream ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:ComponentStream
    a owl:Class ;
    rdfs:label """component stream""" ;
    skos:altLabel """ComponentStream""" ;
    iof-av:directSource """MTConnect ComponentStream""" ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Collections/Arrangement> ;
    iof-av:naturalLanguageDefinition """organizes the data associated with each component entity defined for a device in the associated MTConnectDevices Response Document.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasComponentValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasComponentIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUuidValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrganizesEvent ;
                      owl:someValuesFrom mtc-cnstr:EventObservation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrganizesSample ;
                      owl:someValuesFrom mtc-cnstr:SampleObservation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrganizesCondition ;
                      owl:someValuesFrom mtc-cnstr:ConditionObservation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isOrganizerFor ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isComponentStreamOf ;
                      owl:someValuesFrom mtc-cnstr:DeviceStream ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isComponentStreamOf ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:Observation
    a owl:Class ;
    rdfs:label """observation""" ;
    skos:altLabel """Observation""" ;
    iof-av:directSource """MTConnect Observation""" ;
    rdfs:subClassOf iof-cnstr:ValueExpression ;
    iof-av:naturalLanguageDefinition """abstract entity that provides telemetry data for a data item at a point in time.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000148> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCompositionIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDataItemIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNameValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSequenceValue ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSubType ;
                      owl:someValuesFrom mtc-cnstr:DataItemSubTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasTimestampValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:madeByComponent ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:DataItemTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUnits ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isUnavailableValue ;
                      owl:someValuesFrom xsd:boolean ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResultValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:madeForDataItem ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasQuality ;
                      owl:someValuesFrom mtc-cnstr:QualityEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDeprecatedValue ;
                      owl:someValuesFrom xsd:boolean ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasExtendedValue ;
                      owl:someValuesFrom xsd:boolean ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isObservationOf ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isObservationOf ;
                      owl:someValuesFrom mtc-cnstr:DataItem ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:SampleObservation
    a owl:Class ;
    rdfs:label """sample""" ;
    skos:altLabel """Sample""" ;
    iof-av:directSource """MTConnect Sample""" ;
    rdfs:subClassOf iof-cnstr:MeasuredValueExpression ;
    iof-av:naturalLanguageDefinition """observation that is continuously changing or analog data value.\n""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/Observation> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDurationValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResetTriggered ;
                      owl:someValuesFrom mtc-cnstr:ResetTriggeredEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSampleRateValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasStatistic ;
                      owl:someValuesFrom mtc-cnstr:StatisticEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrganizedByComponentStream ;
                      owl:someValuesFrom mtc-cnstr:ComponentStream ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResultValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUnits ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:SampleEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:EventObservation
    a owl:Class ;
    rdfs:label """event""" ;
    skos:altLabel """Event""" ;
    iof-av:directSource """MTConnect Event""" ;
    rdfs:subClassOf mtc-cnstr:Observation ;
    iof-av:naturalLanguageDefinition """observation that is a discrete piece of information from a piece of equipment.\n""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/Observation> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Event> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResetTriggered ;
                      owl:someValuesFrom mtc-cnstr:ResetTriggeredEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrganizedByComponentStream ;
                      owl:someValuesFrom mtc-cnstr:ComponentStream ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:EventEnum ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:ConditionObservation
    a owl:Class ;
    rdfs:label """condition""" ;
    skos:altLabel """Condition""" ;
    iof-av:directSource """MTConnect Condition""" ;
    rdfs:subClassOf mtc-cnstr:Observation ;
    iof-av:naturalLanguageDefinition """observation that provides the condition of a piece of equipment or a Component.\n\n""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/Observation> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeCodeValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeSeverityValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasQualifier ;
                      owl:someValuesFrom mtc-cnstr:QualifierEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasStatistic ;
                      owl:someValuesFrom mtc-cnstr:StatisticEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasXslangValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrganizedByComponentStream ;
                      owl:someValuesFrom mtc-cnstr:ComponentStream ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasState ;
                      owl:someValuesFrom mtc-cnstr:ConditionStateEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:ConditionEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasConditionIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasComponentIdValue
    a owl:DatatypeProperty ;
    rdfs:label """has component id value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """identifier of the {{block(Component)}} as defined by the {{property(Component::id)}} in the {{term(MTConnectDevices Response Document)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasComponentValue
    a owl:DatatypeProperty ;
    rdfs:label """has component value""" ;
    rdfs:domain mtc-cnstr:ComponentStream ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """identifies the {{block(Component)}} type associated with the {{block(ComponentStream)}}.\n\nExamples of {{property(ComponentStream::component)}} are {{block(Device)}}, {{block(Controller)}}, {{block(Linear)}} and {{block(Loader)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasConditionIdValue
    a owl:DatatypeProperty ;
    rdfs:label """has condition id value""" ;
    rdfs:domain mtc-cnstr:ConditionObservation ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """identifier of an individual {{term(condition activation)}} provided by a piece of equipment.\n\n{{property(Condition::conditionId)}} **MUST** be unique for all concurrent {{termpl(condition activation)}}.\n\n{{property(Condition::conditionId)}} **MUST** be maintained for all state transitions related to the same {{term(condition activation)}}.\n\nMultiple {{property(Condition::conditionId)}}s **MAY** exist for the same {{property(nativeCode)}}.\n\nIf {{property(Condition::conditionId)}} is not given, the value is the {{property(Condition::nativeCode)}}. If {{property(Condition::nativeCode)}} and {{property(Condition::conditionId)}} are not given, {{property(Condition::conditionId)}} **MUST** be generated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasDataItemIdValue
    a owl:DatatypeProperty ;
    rdfs:label """has data item id value""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """unique identifier of the {{block(DataItem)}} associated with this {{block(Observation)}}.\n\n{{property(Observation::dataItemId)}} **MUST** match the associated {{property(DataItem::id)}} defined in the {{term(MTConnectDevices Response Document)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasDeprecatedValue
    a owl:DatatypeProperty ;
    rdfs:label """has deprecated value""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition """indicates if the {{block(Observation)}} has any property or controlled vocabulary that has been deprecated in the MTConnect Standard.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasDurationValue
    a owl:DatatypeProperty ;
    rdfs:label """has duration value""" ;
    rdfs:domain mtc-cnstr:SampleObservation ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """time-period over which the data was collected.\n\n{{property(Sample::duration)}} **MUST** be provided when the {{property(DataItem::statistic)}} is defined in the {{term(MTConnectDevices Response Document)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasExtendedValue
    a owl:DatatypeProperty ;
    rdfs:label """has extended value""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition """indicates if the {{block(Observation)}} has any property or controlled vocabulary that has been extended and cannot be validated.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasNativeCodeValue
    a owl:DatatypeProperty ;
    rdfs:label """has native code value""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """native code is the proprietary identifier designating a specific alarm, fault or warning code provided by the piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasNativeSeverityValue
    a owl:DatatypeProperty ;
    rdfs:label """has native severity value""" ;
    rdfs:domain mtc-cnstr:ConditionObservation ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """severity information to a client software application if the piece of equipment designates a severity level to a fault.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasOrganizedByComponentStream
    a owl:ObjectProperty ;
    rdfs:label """has organized by component stream""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:ComponentStream ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasOrganizesCondition
    a owl:ObjectProperty ;
    rdfs:label """has organizes condition""" ;
    rdfs:domain mtc-cnstr:ComponentStream ;
    rdfs:range mtc-cnstr:ConditionObservation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasOrganizesEvent
    a owl:ObjectProperty ;
    rdfs:label """has organizes event""" ;
    rdfs:domain mtc-cnstr:ComponentStream ;
    rdfs:range mtc-cnstr:EventObservation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasOrganizesSample
    a owl:ObjectProperty ;
    rdfs:label """has organizes sample""" ;
    rdfs:domain mtc-cnstr:ComponentStream ;
    rdfs:range mtc-cnstr:SampleObservation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasQualifier
    a owl:ObjectProperty ;
    rdfs:label """has qualifier""" ;
    rdfs:domain mtc-cnstr:ConditionObservation ;
    rdfs:range mtc-cnstr:QualifierEnum ;
    iof-av:naturalLanguageDefinition """additional information regarding a {{term(condition state)}} associated with the measured value of a process variable.\n\n{{property(Condition::qualifier)}} defines whether the {{term(condition state)}} represented indicates a measured value that is above or below an expected value of a process variable.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasQuality
    a owl:ObjectProperty ;
    rdfs:label """has quality""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range mtc-cnstr:QualityEnum ;
    iof-av:naturalLanguageDefinition """indicates if the {{block(Observation)}} is verifiable and is in accordance with the normative definitions within the MTConnect Standard.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasResetTriggered
    a owl:ObjectProperty ;
    rdfs:label """has reset triggered""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:ResetTriggeredEnum ;
    iof-av:naturalLanguageDefinition """identifies when a reported value has been reset and what has caused that reset to occur for those {{block(DataItem)}} entities that may be periodically reset to an initial value.\n\n`resetTriggered` **MUST** only be provided for the specific occurrence of a {{block(DataItem)}} reported in the {{term(MTConnectStreams Response Document)}} when the reset occurred.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasSequenceValue
    a owl:DatatypeProperty ;
    rdfs:label """has sequence value""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range xsd:integer ;
    iof-av:naturalLanguageDefinition """number representing the sequential position of an occurrence of an {{term(observation)}} in the data buffer of an {{term(agent)}}.\n\n{{property(Observation::sequence)}} **MUST** have a value represented as an unsigned 64-bit value from 1 to $$ 2^{64}-1 $$.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasState
    a owl:ObjectProperty ;
    rdfs:label """has state""" ;
    rdfs:domain mtc-cnstr:Observation ;
    iof-av:naturalLanguageDefinition """{{term(condition state)}} of the piece of equipment or {{block(Component)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasStatistic
    a owl:ObjectProperty ;
    rdfs:label """has statistic""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range mtc-cnstr:StatisticEnum ;
    iof-av:naturalLanguageDefinition """type of statistical calculation defined by the {{property(DataItem::statistic)}} defined in the {{term(MTConnectDevices Response Document)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasTimestampValue
    a owl:DatatypeProperty ;
    rdfs:label """has timestamp value""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """most accurate time available to a piece of equipment that represents the point in time that the data reported was measured.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:hasXslangValue
    a owl:DatatypeProperty ;
    rdfs:label """has xslang value""" ;
    rdfs:domain mtc-cnstr:ConditionObservation ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """specifies the language of the {{property(Observation::result)}} returned for the {{block(Condition)}}. \n\nSee {{cite(IETF RFC 4646)}} (http://www.ietf.org/rfc/rfc4646.txt).""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:isComponentStreamOf
    a owl:ObjectProperty ;
    rdfs:label """is component stream of""" ;
    rdfs:domain mtc-cnstr:ComponentStream ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:isObservationOf
    a owl:ObjectProperty ;
    rdfs:label """is observation of""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:isOrganizerFor
    a owl:ObjectProperty ;
    rdfs:label """is organizer for""" ;
    rdfs:domain mtc-cnstr:ComponentStream ;
    rdfs:range mtc-cnstr:Component ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:isUnavailableValue
    a owl:DatatypeProperty ;
    rdfs:label """is unavailable value""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition """when `true`, {{property(Observation::result)}} is indeterminate.\n\n> Note 1 to entry: In {{term(XML)}}, when `isUnavailable` is `true`, the {{term(XML)}} `CDATA` of the `Observation` **MUST** be `UNAVAILABLE`.\n ```xml\n<Execution dataItemId=\"...\" ...>UNAVAILABLE</Execution>\n```\n\n> Note 2 to entry: In {{term(JSON)}}, when `isUnavailable` is `true`, the {{term(JSON)}} `value` of the `Observation` **MUST** be `UNAVAILABLE`.\n```json\n  \"Execution\" : [ { \"dataItemId\": \"...\" ..., \"value\": \"UNAVAILABLE\" } ]\n```""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:madeByComponent
    a owl:ObjectProperty ;
    rdfs:label """made by component""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range mtc-cnstr:Component ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

mtc-cnstr:madeForDataItem
    a owl:ObjectProperty ;
    rdfs:label """made for data item""" ;
    rdfs:domain mtc-cnstr:Observation ;
    rdfs:range mtc-cnstr:DataItem ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ObservationInformationModel/> .

