@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Devices/>
    a owl:Ontology ;
    rdfs:label "devices" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Devices/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:AgentSystem
    a owl:Class ;
    rdfs:label """agent system""" ;
    iof-av:directSource """MTConnect Component Agent""" ;
    rdfs:subClassOf <https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ;
    iof-av:naturalLanguageDefinition """device composed of an MTConnect Agent and all its connected data sources.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Devices/> .

