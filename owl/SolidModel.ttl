@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/SolidModel/>
    a owl:Ontology ;
    rdfs:label "solid model" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/SolidModel/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:SolidModel
    a owl:Class ;
    rdfs:label """solid model""" ;
    skos:altLabel """SolidModel""" ;
    iof-av:directSource """MTConnect SolidModel""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """references to a file with the three-dimensional geometry of the component or composition.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/ProductDesignSpecification> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/ProductDesignSpecification> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasTransformation ;
                      owl:someValuesFrom mtc-cnstr:Transformation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasScale ;
                      owl:someValuesFrom mtc-cnstr:AbstractScale ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSolidModelIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasHrefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasItemRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasMediaType ;
                      owl:someValuesFrom mtc-cnstr:MediaTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCoordinateSystemIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasNativeUnits ;
                      owl:someValuesFrom mtc-cnstr:NativeUnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasUnits ;
                      owl:someValuesFrom mtc-cnstr:UnitEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isSolidModelOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:AbstractScale
    a owl:Class ;
    rdfs:label """abstract scale""" ;
    skos:altLabel """AbstractScale""" ;
    iof-av:directSource """MTConnect AbstractScale""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """either a single multiplier applied to all three dimensions or a three space multiplier given in the X, Y, and Z dimensions in the coordinate system used for the solid model.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isScaleOf ;
                      owl:someValuesFrom mtc-cnstr:SolidModel ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:ScaleDataSet
    a owl:Class ;
    rdfs:label """scale data set""" ;
    skos:altLabel """ScaleDataSet""" ;
    iof-av:directSource """MTConnect Representation ScaleDataSet""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    rdfs:subClassOf mtc-cnstr:AbstractScale ;
    iof-av:naturalLanguageDefinition """either a single multiplier applied to all three dimensions or a three space multiplier given in the X, Y, and Z dimensions in the coordinate system used for the solid model represented as a dataset.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000019> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasXValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasYValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasZValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:Scale
    a owl:Class ;
    rdfs:label """scale""" ;
    skos:altLabel """Scale""" ;
    iof-av:directSource """MTConnect AbstractScale Scale""" ;
    rdfs:subClassOf mtc-cnstr:AbstractScale ;
    iof-av:naturalLanguageDefinition """either a single multiplier applied to all three dimensions or a three space multiplier given in the X, Y, and Z dimensions in the coordinate system used for the solid model.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:hasItemRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has item ref value""" ;
    rdfs:domain mtc-cnstr:SolidModel ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """reference to the item within the model within the related geometry. A {{property(SolidModel::solidModelIdRef)}} **MUST** be given. \n\n> Note: `Item` defined in ASME Y14.100 - A nonspecific term used to denote any unit or product, including materials, parts, assemblies, equipment, accessories, and computer software.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:hasMediaType
    a owl:ObjectProperty ;
    rdfs:label """has media type""" ;
    rdfs:domain mtc-cnstr:SolidModel ;
    rdfs:range mtc-cnstr:MediaTypeEnum ;
    iof-av:naturalLanguageDefinition """format of the referenced document.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:hasScale
    a owl:ObjectProperty ;
    rdfs:label """has scale""" ;
    rdfs:domain mtc-cnstr:SolidModel ;
    rdfs:range mtc-cnstr:AbstractScale ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:hasSolidModelIdRefValue
    a owl:DatatypeProperty ;
    rdfs:label """has solid model id ref value""" ;
    rdfs:domain mtc-cnstr:SolidModel ;
    rdfs:range xsd:string ;
    iof-av:naturalLanguageDefinition """associated model file if an item reference is used.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:isScaleOf
    a owl:ObjectProperty ;
    rdfs:label """is scale of""" ;
    rdfs:domain mtc-cnstr:AbstractScale ;
    rdfs:range mtc-cnstr:SolidModel ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

mtc-cnstr:isSolidModelOf
    a owl:ObjectProperty ;
    rdfs:label """is solid model of""" ;
    rdfs:domain mtc-cnstr:SolidModel ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/SolidModel/> .

