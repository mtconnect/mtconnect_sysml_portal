@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Representations/>
    a owl:Ontology ;
    rdfs:label "representations" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Representations/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:Representation
    a owl:Class ;
    rdfs:label """representation""" ;
    skos:altLabel """Representation""" ;
    iof-av:directSource """MTConnect Representation""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000033> ;
    iof-av:naturalLanguageDefinition """specifies the format and structure of observation::result.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000031> ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:Value
    a owl:Class ;
    rdfs:label """value""" ;
    skos:altLabel """Value""" ;
    iof-av:directSource """MTConnect Representation Value""" ;
    rdfs:subClassOf mtc-cnstr:Representation ;
    iof-av:naturalLanguageDefinition """default representation type for all observation types where observation::result type is an MTConnect data type. See data types.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:TimeSeries
    a owl:Class ;
    rdfs:label """time series""" ;
    skos:altLabel """TimeSeries""" ;
    iof-av:directSource """MTConnect Representation TimeSeries""" ;
    rdfs:subClassOf mtc-cnstr:Representation ;
    iof-av:naturalLanguageDefinition """representation for an observation composed of a series of sampled data.\n""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSampleCountValue ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResultValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:Discrete
    a owl:Class ;
    rdfs:label """discrete""" ;
    skos:altLabel """Discrete""" ;
    iof-av:directSource """MTConnect Representation Discrete""" ;
    rdfs:subClassOf mtc-cnstr:Representation ;
    iof-av:naturalLanguageDefinition """**DEPRECATED** representation for an observation where each discrete occurrence of the data may have the same value as the previous occurrence of the data.\n""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000003> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResultValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:DataSet
    a owl:Class ;
    rdfs:label """data set""" ;
    skos:altLabel """DataSet""" ;
    iof-av:directSource """MTConnect Representation DataSet""" ;
    rdfs:subClassOf mtc-cnstr:Representation ;
    iof-av:naturalLanguageDefinition """representation for an observation composed of value(s) represented as a set of key-value pairs.\n""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://www.omg.org/spec/Commons/Collections/StructuredCollection> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCountValue ;
                      owl:someValuesFrom xsd:integer ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResult ;
                      owl:someValuesFrom mtc-cnstr:EntryRepresentations ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:EntryRepresentations
    a owl:Class ;
    rdfs:label """entry""" ;
    skos:altLabel """Entry""" ;
    iof-av:directSource """MTConnect Entry""" ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001933> ;
    iof-av:naturalLanguageDefinition """key-value pair published as part of a data set.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasKeyValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRemovedValue ;
                      owl:someValuesFrom xsd:boolean ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isEntryFor ;
                      owl:someValuesFrom mtc-cnstr:DataSet ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasResultValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isEntryOf ;
                      owl:someValuesFrom mtc-cnstr:DataSet ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasCountValue
    a owl:DatatypeProperty ;
    rdfs:label """has count value""" ;
    rdfs:domain mtc-cnstr:Representation ;
    rdfs:range xsd:integer ;
    iof-av:naturalLanguageDefinition """number of {{block(Entry)}} elements for the {{block(Observation)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasLowerLimitValue
    a owl:DatatypeProperty ;
    rdfs:label """has lower limit value""" ;
    rdfs:domain mtc-cnstr:DataSet ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """lower conformance boundary for a variable.\n\n> Note: immediate concern or action may be required.\n\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasLowerWarningValue
    a owl:DatatypeProperty ;
    rdfs:label """has lower warning value""" ;
    rdfs:domain mtc-cnstr:DataSet ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """lower boundary indicating increased concern and supervision may be required.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasRemovedValue
    a owl:DatatypeProperty ;
    rdfs:label """has removed value""" ;
    rdfs:domain <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:range xsd:boolean ;
    iof-av:naturalLanguageDefinition """removal indicator of a {{term(key-value pair)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasSampleCountValue
    a owl:DatatypeProperty ;
    rdfs:label """has sample count value""" ;
    rdfs:domain mtc-cnstr:TimeSeries ;
    rdfs:range xsd:integer ;
    iof-av:naturalLanguageDefinition """number of values given for the {{block(Observation)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasUpperLimitValue
    a owl:DatatypeProperty ;
    rdfs:label """has upper limit value""" ;
    rdfs:domain mtc-cnstr:DataSet ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """upper conformance boundary for a variable.\n\n> Note: immediate concern or action may be required.\n\n""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasUpperWarningValue
    a owl:DatatypeProperty ;
    rdfs:label """has upper warning value""" ;
    rdfs:domain mtc-cnstr:DataSet ;
    rdfs:range xsd:float ;
    iof-av:naturalLanguageDefinition """upper boundary indicating increased concern and supervision may be required.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasXValue
    a owl:DatatypeProperty ;
    rdfs:label """has x value""" ;
    rdfs:domain mtc-cnstr:DataSet ;
    rdfs:range rdfs:Literal ;
    iof-av:naturalLanguageDefinition """x-coordinate.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasYValue
    a owl:DatatypeProperty ;
    rdfs:label """has y value""" ;
    rdfs:domain mtc-cnstr:DataSet ;
    rdfs:range rdfs:Literal ;
    iof-av:naturalLanguageDefinition """y-coordinate.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:hasZValue
    a owl:DatatypeProperty ;
    rdfs:label """has z value""" ;
    rdfs:domain mtc-cnstr:DataSet ;
    rdfs:range rdfs:Literal ;
    iof-av:naturalLanguageDefinition """x-coordinate.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:isEntryFor
    a owl:ObjectProperty ;
    rdfs:label """is entry for""" ;
    rdfs:domain mtc-cnstr:EntryRepresentations ;
    rdfs:range mtc-cnstr:DataSet ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

mtc-cnstr:isEntryOf
    a owl:ObjectProperty ;
    rdfs:label """is entry of""" ;
    rdfs:domain <http://purl.obolibrary.org/obo/OBI_0001933> ;
    rdfs:range mtc-cnstr:Representation ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Representations/> .

