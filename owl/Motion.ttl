@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Motion/>
    a owl:Ontology ;
    rdfs:label "motion" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Motion/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:Motion
    a owl:Class ;
    rdfs:label """motion""" ;
    skos:altLabel """Motion""" ;
    iof-av:directSource """MTConnect Motion""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """movement of the component relative to a coordinate system. """ ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <https://spec.industrialontologies.org/ontology/construct/Change> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasActuation ;
                      owl:someValuesFrom mtc-cnstr:MotionActuationTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCoordinateSystemIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasIdValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasParentIdRefValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasType ;
                      owl:someValuesFrom mtc-cnstr:MotionTypeEnum ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasAxis ;
                      owl:someValuesFrom mtc-cnstr:AbstractAxis ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasOrigin ;
                      owl:someValuesFrom mtc-cnstr:AbstractOrigin ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasTransformation ;
                      owl:someValuesFrom mtc-cnstr:Transformation ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasDescriptionValue ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isMotionOf ;
                      owl:someValuesFrom mtc-cnstr:Configuration ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:AbstractAxis
    a owl:Class ;
    rdfs:label """abstract axis""" ;
    skos:altLabel """AbstractAxis""" ;
    iof-av:directSource """MTConnect AbstractAxis""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """axis along or around which the component moves relative to a coordinate system.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000308> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000142> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isAxisOf ;
                      owl:someValuesFrom mtc-cnstr:Motion ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:AxisDataSet
    a owl:Class ;
    rdfs:label """axis data set""" ;
    skos:altLabel """AxisDataSet""" ;
    iof-av:directSource """MTConnect Representation AxisDataSet""" ;
    rdfs:subClassOf mtc-cnstr:DataSet ;
    rdfs:subClassOf mtc-cnstr:AbstractAxis ;
    iof-av:naturalLanguageDefinition """axis along or around which the component moves relative to a coordinate system represented as a dataset.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000142> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasXValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasYValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasZValue ;
                      owl:someValuesFrom xsd:float ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:AxisAbstractAxis
    a owl:Class ;
    rdfs:label """axis""" ;
    skos:altLabel """Axis""" ;
    iof-av:directSource """MTConnect AbstractAxis Axis""" ;
    rdfs:subClassOf mtc-cnstr:AbstractAxis ;
    iof-av:naturalLanguageDefinition """axis along or around which the component moves relative to a coordinate system.""" ;
    mtc-cnstr:iofParentCandidate <http://purl.obolibrary.org/obo/IAO_0000308> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasValueLiteral ;
                      owl:someValuesFrom xsd:string ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:hasActuation
    a owl:ObjectProperty ;
    rdfs:label """has actuation""" ;
    rdfs:domain mtc-cnstr:Motion ;
    rdfs:range mtc-cnstr:MotionActuationTypeEnum ;
    iof-av:naturalLanguageDefinition """describes if this component is actuated directly or indirectly as a result of other motion.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:hasAxis
    a owl:ObjectProperty ;
    rdfs:label """has axis""" ;
    rdfs:domain mtc-cnstr:Motion ;
    rdfs:range mtc-cnstr:AbstractAxis ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:hasValueLiteral
    a owl:DatatypeProperty ;
    rdfs:label """has value literal""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range rdfs:Literal ;
    iof-av:naturalLanguageDefinition """current interval value of the activity.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:isAxisOf
    a owl:ObjectProperty ;
    rdfs:label """is axis of""" ;
    rdfs:domain mtc-cnstr:AbstractAxis ;
    rdfs:range mtc-cnstr:Motion ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

mtc-cnstr:isMotionOf
    a owl:ObjectProperty ;
    rdfs:label """is motion of""" ;
    rdfs:domain mtc-cnstr:Motion ;
    rdfs:range mtc-cnstr:Configuration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Motion/> .

