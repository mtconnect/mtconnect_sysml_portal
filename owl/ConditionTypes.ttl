@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/ConditionTypes/>
    a owl:Ontology ;
    rdfs:label "condition types" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/ConditionTypes/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:ActuatorCondition
    a owl:Class ;
    rdfs:label """actuator""" ;
    skos:altLabel """Actuator""" ;
    iof-av:directSource """MTConnect Condition Actuator""" ;
    rdfs:subClassOf mtc-cnstr:ConditionObservation ;
    iof-av:naturalLanguageDefinition """indication of a fault associated with an actuator.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ConditionObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:ConditionEnum_ACTUATOR ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:ActuatorConditionMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:ActuatorConditionMaterialState ] ) ] ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:ActuatorConditionMaterialState
    a owl:Class ;
    rdfs:label """actuator condition material state""" ;
    iof-av:directSource """MTConnect Condition Actuator""" ;
    rdfs:subClassOf iof-cnstr:MaterialState ;
    iof-av:naturalLanguageDefinition """indication of a fault associated with an actuator.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:Communications
    a owl:Class ;
    rdfs:label """communications""" ;
    skos:altLabel """Communications""" ;
    iof-av:directSource """MTConnect Condition Communications""" ;
    rdfs:subClassOf mtc-cnstr:ConditionObservation ;
    iof-av:naturalLanguageDefinition """indication that the piece of equipment has experienced a communications failure.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ConditionObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:ConditionEnum_COMMUNICATIONS ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:CommunicationsMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:CommunicationsMaterialState ] ) ] ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:CommunicationsMaterialState
    a owl:Class ;
    rdfs:label """communications material state""" ;
    iof-av:directSource """MTConnect Condition Communications""" ;
    rdfs:subClassOf iof-cnstr:MaterialState ;
    iof-av:naturalLanguageDefinition """indication that the piece of equipment has experienced a communications failure.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:DataRange
    a owl:Class ;
    rdfs:label """data range""" ;
    skos:altLabel """DataRange""" ;
    iof-av:directSource """MTConnect Condition DataRange""" ;
    rdfs:subClassOf mtc-cnstr:ConditionObservation ;
    iof-av:naturalLanguageDefinition """indication that the value of the data associated with a measured value or a calculation is outside of an expected range.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ConditionObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:ConditionEnum_DATARANGE ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:DataRangeMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:DataRangeMaterialState ] ) ] ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:DataRangeMaterialState
    a owl:Class ;
    rdfs:label """data range material state""" ;
    iof-av:directSource """MTConnect Condition DataRange""" ;
    rdfs:subClassOf iof-cnstr:MaterialState ;
    iof-av:naturalLanguageDefinition """indication that the value of the data associated with a measured value or a calculation is outside of an expected range.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:LogicProgram
    a owl:Class ;
    rdfs:label """logic program""" ;
    skos:altLabel """LogicProgram""" ;
    iof-av:directSource """MTConnect Condition LogicProgram""" ;
    rdfs:subClassOf mtc-cnstr:ConditionObservation ;
    iof-av:naturalLanguageDefinition """indication that an error occurred in the logic program or programmable logic controller (PLC) associated with a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ConditionObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:ConditionEnum_LOGICPROGRAM ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:LogicProgramMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:LogicProgramMaterialState ] ) ] ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:LogicProgramMaterialState
    a owl:Class ;
    rdfs:label """logic program material state""" ;
    iof-av:directSource """MTConnect Condition LogicProgram""" ;
    rdfs:subClassOf iof-cnstr:MaterialState ;
    iof-av:naturalLanguageDefinition """indication that an error occurred in the logic program or programmable logic controller (PLC) associated with a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:MotionProgram
    a owl:Class ;
    rdfs:label """motion program""" ;
    skos:altLabel """MotionProgram""" ;
    iof-av:directSource """MTConnect Condition MotionProgram""" ;
    rdfs:subClassOf mtc-cnstr:ConditionObservation ;
    iof-av:naturalLanguageDefinition """indication that an error occurred in the motion program associated with a piece of equipment.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ConditionObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:ConditionEnum_MOTIONPROGRAM ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:MotionProgramMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:MotionProgramMaterialState ] ) ] ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:MotionProgramMaterialState
    a owl:Class ;
    rdfs:label """motion program material state""" ;
    iof-av:directSource """MTConnect Condition MotionProgram""" ;
    rdfs:subClassOf iof-cnstr:MaterialState ;
    iof-av:naturalLanguageDefinition """indication that an error occurred in the motion program associated with a piece of equipment.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:SystemCondition
    a owl:Class ;
    rdfs:label """system""" ;
    skos:altLabel """System""" ;
    iof-av:directSource """MTConnect Condition System""" ;
    rdfs:subClassOf mtc-cnstr:ConditionObservation ;
    iof-av:naturalLanguageDefinition """general purpose indication associated with an electronic component of a piece of equipment or a controller that represents a fault that is not associated with the operator, program, or hardware.""" ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            mtc-cnstr:ConditionObservation
            [ a owl:Restriction ; owl:onProperty mtc-cnstr:hasType ; owl:hasValue mtc-cnstr:ConditionEnum_SYSTEM ]
            [ a owl:Restriction ; owl:onProperty iof-cnstr:isAbout ; owl:someValuesFrom mtc-cnstr:SystemConditionMaterialState ]
            [ a owl:Restriction ; owl:onProperty bfo:BFO_0000110 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( iof-cnstr:ValueExpression [ a owl:Restriction ; owl:onProperty iof-cnstr:isValueExpressionOfAtSomeTime ; owl:someValuesFrom mtc-cnstr:SystemConditionMaterialState ] ) ] ]
        ) ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:SystemConditionMaterialState
    a owl:Class ;
    rdfs:label """system condition material state""" ;
    iof-av:directSource """MTConnect Condition System""" ;
    rdfs:subClassOf iof-cnstr:MaterialState ;
    iof-av:naturalLanguageDefinition """general purpose indication associated with an electronic component of a piece of equipment or a controller that represents a fault that is not associated with the operator, program, or hardware.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

mtc-cnstr:hasType
    a owl:ObjectProperty ;
    rdfs:label """has type""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """type of the {{block(DataItem)}} associated with this {{block(Observation)}}.\n\n{{property(Observation::type)}} **MUST** match the associated {{property(DataItem::type)}} defined in the {{term(MTConnectDevices Response Document)}}.""" ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/ConditionTypes/> .

