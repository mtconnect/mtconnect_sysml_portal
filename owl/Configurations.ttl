@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof-cnstr: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-ind: <https://spec.industrialontologies.org/ontology/individual/> .
@prefix iof-av: <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix mtc-cnstr:  <https://model.mtconnect.org/ontology/construct/> .
@prefix mtc-indv:  <https://model.mtconnect.org/ontology/individual/> .

<https://model.mtconnect.org/ontology/machinetool/Configurations/>
    a owl:Ontology ;
    rdfs:label "configurations" ;
    owl:imports <https://model.mtconnect.org/ontology/machinetool/MTConnectCore/> ;
    owl:versionIRI <https://model.mtconnect.org/ontology/v2.8/machinetool/Configurations/> ;
    owl:versionInfo "2.8" .

mtc-cnstr:Configuration
    a owl:Class ;
    rdfs:label """configuration""" ;
    skos:altLabel """Configuration""" ;
    iof-av:directSource """MTConnect Configuration""" ;
    rdfs:subClassOf iof-cnstr:DesignSpecification ;
    iof-av:naturalLanguageDefinition """technical information about an entity describing its physical layout, functional characteristics, and relationships with other entities.""" ;
    mtc-cnstr:iofParentCandidate <https://spec.industrialontologies.org/ontology/construct/DescriptiveInformationContentEntity> ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty iof-cnstr:isAbout ;
                      owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000020> ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isConfigurationFor ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSolidModel ;
                      owl:someValuesFrom mtc-cnstr:SolidModel ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSensorConfiguration ;
                      owl:someValuesFrom mtc-cnstr:SensorConfiguration ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasMotion ;
                      owl:someValuesFrom mtc-cnstr:Motion ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasRelationship ;
                      owl:someValuesFrom mtc-cnstr:ConfigurationRelationship ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasCoordinateSystem ;
                      owl:someValuesFrom mtc-cnstr:CoordinateSystem ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasSpecification ;
                      owl:someValuesFrom mtc-cnstr:Specification ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isConfigurationFor ;
                      owl:someValuesFrom mtc-cnstr:Composition ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasImageFile ;
                      owl:someValuesFrom mtc-cnstr:ImageFile ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:hasPowerSource ;
                      owl:someValuesFrom mtc-cnstr:PowerSource ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isConfigurationOf ;
                      owl:someValuesFrom mtc-cnstr:Component ] ;
    rdfs:subClassOf [ a owl:Restriction ;
                      owl:onProperty mtc-cnstr:isConfigurationOf ;
                      owl:someValuesFrom mtc-cnstr:Composition ] ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasCoordinateSystem
    a owl:ObjectProperty ;
    rdfs:label """has coordinate system""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    iof-av:naturalLanguageDefinition """for measured values relative to a coordinate system like {{block(Position)}}, the coordinate system used may be reported.\n\n**DEPRECATED** in *Version 2.0*. Replaced by {{property(Component::coordinateSystemIdRef)}}. """ ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasImageFile
    a owl:ObjectProperty ;
    rdfs:label """has image file""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range mtc-cnstr:ImageFile ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasMotion
    a owl:ObjectProperty ;
    rdfs:label """has motion""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range mtc-cnstr:Motion ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasPowerSource
    a owl:ObjectProperty ;
    rdfs:label """has power source""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range mtc-cnstr:PowerSource ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasRelationship
    a owl:ObjectProperty ;
    rdfs:label """has relationship""" ;
    rdfs:domain <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasSensorConfiguration
    a owl:ObjectProperty ;
    rdfs:label """has sensor configuration""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range mtc-cnstr:SensorConfiguration ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasSolidModel
    a owl:ObjectProperty ;
    rdfs:label """has solid model""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range mtc-cnstr:SolidModel ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:hasSpecification
    a owl:ObjectProperty ;
    rdfs:label """has specification""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range mtc-cnstr:Specification ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:isConfigurationFor
    a owl:ObjectProperty ;
    rdfs:label """is configuration for""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

mtc-cnstr:isConfigurationOf
    a owl:ObjectProperty ;
    rdfs:label """is configuration of""" ;
    rdfs:domain mtc-cnstr:Configuration ;
    rdfs:range <https://spec.industrialontologies.org/ontology/construct/InformationContentEntity> ;
    rdfs:isDefinedBy <https://model.mtconnect.org/ontology/machinetool/Configurations/> .

