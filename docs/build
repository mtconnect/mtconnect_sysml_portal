#!/usr/bin/env ruby

require 'fileutils'
require 'yaml'
require '../lib/utils'

def write_root_page(dir, versions, latest, development)
  puts "\n--------------------------------\nGenerating Root Page: #{dir}\n\n"
  FileUtils.rm_r dir if File.exist?(dir)
  FileUtils.mkdir_p dir

  FileUtils.ln_s('./figures', File.join(dir, 'figures'), relative: true)

  fn = File.join(dir, 'index.md')
  puts "Generating file: #{fn}"
  File.open(fn, 'w') do |f|
    f.puts <<~EOT
      ---
      title: MTConnect
      nav_order: 1
      has_children: true
      layout: default
      ---

      # MTConnect SysML Model Documentation

      ## Latest Versions

      * [Latest Version (#{latest})](/Version#{latest}/)
EOT
    if development
      f.puts "* [Development Version (#{development})](/Version#{development}/)"
    end
    
    f.puts <<~EOT

      ## All Versions

    EOT
    versions.sort.reverse.each do |version|
      f.puts "* [Version #{version}](/Version#{version}/)"
    end

    File.open(File.join(File.dirname(__FILE__), 'home.md'), 'r') do |home|
      f.puts home.read
    end
  end

  fn = File.join(dir, '_config_version.yml')
  puts "Generating file: #{fn}"
  File.open(fn, 'w') do |f|
    f.puts "title: MTConnect SysML Model Documentation"
    f.puts "comment_url: #{ENV['COMMENT_URL'] || 'https://projects.mtconnect.org'}"
  end
end

def build_version(base, src, dest, version = nil)
  puts "\n--------------------------------\nBuilding #{src} -> /#{dest}\n\n"

  source = File.join(File.dirname(__FILE__), 'tmp', "#{src}/")
  destination = File.join(base, 'deploy', "#{dest}/")

  if version
    FileUtils.rm_r source if File.exist?(source)
    FileUtils.mkdir_p source
    FileUtils.rm_r destination if File.exist?(destination)
  
    FileUtils.cp(File.join(base, "Version#{version}", "MTConnectSysMLModel.xml"), File.join(source, "MTConnectSysMLModel_V#{version}.xml"))
    Dir[File.join(base, 'build', "Version#{version}", '*')].each do |d|
      FileUtils.cp_r(d, File.join(source, File.basename(d)))
    end
  end

  %w{_config.yml _includes _layouts _sass 404.html assets}.each do |d|
    FileUtils.cp_r(d, File.join(source, d))
  end

  dest = '.' if dest.empty?
  command = "bundle exec jekyll build -s #{source} --config ./_config.yml,#{source}_config_version.yml --baseurl /#{dest} -d #{destination}"
  puts "Running command: #{command}"
  system(command) || raise(command)
end

base = File.expand_path('..', File.dirname(__FILE__))
versions, latest, development = versions_for_build

write_root_page(File.join(File.dirname(__FILE__), 'tmp', 'Root'), versions, latest, development)
build_version(base, 'Root', '',)

versions.each do |version|
  build_version(base, "Source#{version}", "Version#{version}", version)
end

puts "\n--------------------------------\nBuild complete\n\n"
puts "\n--------------------------------\nReplacing top level search index\n\n"

source = File.join(base, 'deploy', "Version#{latest}", 'assets', 'js', 'search-data.json')
destination = File.join(base, 'deploy', 'assets', 'js', 'search-data.json')

puts "Copying #{source} to #{destination}"
FileUtils.cp(source, destination)
